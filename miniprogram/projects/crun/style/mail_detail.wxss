page { background: #f3f6fb; }
.delivery-page { min-height: 100vh; padding-bottom: calc(154rpx + env(safe-area-inset-bottom)); background: #f3f6fb; color: #25364d; font-size: 28rpx; line-height: 1.5; box-sizing: border-box; }
.delivery-page view, .delivery-page text, .delivery-page button { box-sizing: border-box; }
.delivery-page button { margin: 0; padding: 0; border: 0; font-size: inherit; font-weight: 500; line-height: 1.5; border-radius: 0; }
.delivery-page button::after { border: 0; }
.delivery-page button[disabled] { opacity: .5; }
.delivery-page .od-hero { padding: 34rpx 38rpx 40rpx; background: linear-gradient(125deg, #e5f0ff, #f1f6ff); }
.delivery-page .od-hero-top { display: flex; align-items: center; justify-content: space-between; min-height: 36rpx; }
.delivery-page .od-eyebrow { color: #6e8bac; font-size: 23rpx; letter-spacing: 2rpx; }
.delivery-page .od-urgent { padding: 4rpx 16rpx; border-radius: 10rpx; background: #fff1db; color: #af7026; font-size: 22rpx; }
.delivery-page .od-status-row { display: flex; align-items: center; padding: 26rpx 0 14rpx; }
.delivery-page .od-status-copy { flex: 1; min-width: 0; }
.delivery-page .od-status-title { color: #285b97; font-size: 43rpx; font-weight: 700; letter-spacing: 1rpx; }
.delivery-page .od-status-note { margin-top: 10rpx; color: #7890ad; font-size: 24rpx; line-height: 1.7; }
.delivery-page .od-status-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 108rpx; height: 108rpx; margin-left: 22rpx; border: 2rpx solid rgba(255,255,255,.8); border-radius: 34rpx; background: rgba(255,255,255,.5); color: #397bc8; font-size: 64rpx; transform: rotate(-7deg); }
.delivery-page .od-tone-green { background: linear-gradient(125deg, #e4f4f0, #f2f8f6); }

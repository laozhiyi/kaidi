.delivery-page .od-event-copy { flex: 1; min-width: 0; padding-left: 24rpx; }
.delivery-page .od-event-title { color: #65748b; font-size: 26rpx; }
.delivery-page .od-event:first-child .od-event-title { color: #3d6dA5; font-weight: 500; }
.delivery-page .od-event-note { margin-top: 8rpx; color: #8794a6; font-size: 24rpx; white-space: pre-wrap; word-break: break-word; }
.delivery-page .od-event .od-caption { margin-top: 6rpx; }
.delivery-page .od-end-note { padding: 8rpx 8rpx 4rpx; color: #9aa7b8; font-size: 22rpx; text-align: center; }

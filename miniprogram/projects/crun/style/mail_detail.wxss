.delivery-page .od-upload-add { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 158rpx; height: 158rpx; border: 2rpx dashed #d5e1f0; border-radius: 18rpx; background: #f8faff; color: #859cba; font-size: 23rpx; }

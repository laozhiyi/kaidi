.delivery-page .od-order-number { display: flex; align-items: baseline; gap: 14rpx; }
.delivery-page .od-settlement { display: flex; align-items: center; gap: 10rpx; margin-top: 22rpx; padding: 20rpx 0 0; border-top: 1rpx solid #edf1f6; color: #9b8b70; font-size: 22rpx; }

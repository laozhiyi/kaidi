.delivery-page .od-tone-amber { background: linear-gradient(125deg, #fff0db, #fff8ed); }
.delivery-page .od-tone-amber .od-status-title, .delivery-page .od-tone-amber .od-status-icon { color: #a87029; }
.delivery-page .od-tone-muted { background: linear-gradient(125deg, #e9eef5, #f4f6fa); }
.delivery-page .od-tone-muted .od-status-title, .delivery-page .od-tone-muted .od-status-icon { color: #738398; }
.delivery-page .od-progress { display: flex; margin: 28rpx -8rpx 0; }
.delivery-page .od-step { flex: 1; min-width: 0; text-align: center; color: #95a6bb; }
.delivery-page .od-step-track { position: relative; display: flex; align-items: center; justify-content: center; height: 32rpx; }
.delivery-page .od-step-track::before { position: absolute; top: 15rpx; left: -50%; right: 50%; height: 2rpx; content: ''; background: #d3dfed; }
.delivery-page .od-step:first-child .od-step-track::before { display: none; }
.delivery-page .od-step-dot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; width: 24rpx; height: 24rpx; border: 4rpx solid #d3dfed; border-radius: 50%; background: #edf4fd; color: #fff; font-size: 18rpx; }

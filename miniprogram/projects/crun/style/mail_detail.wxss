.delivery-page .od-event { position: relative; display: flex; padding-bottom: 28rpx; }
.delivery-page .od-event::before { position: absolute; left: 8rpx; top: 17rpx; bottom: -10rpx; width: 2rpx; background: #e7edf5; content: ''; }
.delivery-page .od-event:last-child { padding-bottom: 0; }
.delivery-page .od-event:last-child::before { display: none; }
.delivery-page .od-event-dot { position: relative; flex-shrink: 0; width: 18rpx; height: 18rpx; margin-top: 12rpx; border: 4rpx solid #eaf0f9; border-radius: 50%; background: #b8c9de; }

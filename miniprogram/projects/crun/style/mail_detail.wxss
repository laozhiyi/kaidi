.delivery-page .od-state { margin: 32rpx 24rpx; padding: 70rpx 36rpx 42rpx; border-radius: 30rpx; background: #fff; text-align: center; }
.delivery-page .od-state-icon { display: flex; align-items: center; justify-content: center; width: 110rpx; height: 110rpx; margin: 0 auto 30rpx; border-radius: 36rpx; background: #edf4ff; color: #7da0ce; font-size: 62rpx; }
.delivery-page .od-state-title { font-size: 34rpx; font-weight: 600; }
.delivery-page .od-state-note { margin: 18rpx 0 36rpx; color: #929eae; font-size: 26rpx; line-height: 1.8; word-break: break-word; }
.delivery-page .od-state-link { margin-top: 30rpx; color: #6a8bb3; font-size: 25rpx; }
.delivery-page .od-config-note { margin: 0 42rpx 20rpx; color: #9ba7b7; font-size: 22rpx; text-align: center; }
.delivery-page .od-sheet-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; flex-direction: column; justify-content: flex-end; background: rgba(30,47,73,.42); }
.delivery-page .od-sheet { width: 100%; padding: 20rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #fff; }

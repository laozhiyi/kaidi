.delivery-page .od-end-note text:last-child { margin-left: 8rpx; color: #7293bb; }
.delivery-page .od-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; align-items: center; gap: 20rpx; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eaf0f8; background: rgba(255,255,255,.98); box-shadow: 0 -8rpx 30rpx rgba(55,78,116,.04); }
.delivery-page .od-footer-tool { display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; width: 70rpx; min-height: 82rpx; color: #7c8ca2; background: transparent; font-size: 21rpx; }

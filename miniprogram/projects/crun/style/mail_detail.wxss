.delivery-page .od-alert, .delivery-page .od-media-error { display: flex; align-items: baseline; gap: 12rpx; padding: 20rpx 24rpx; border-radius: 16rpx; background: #fff4e4; color: #ae813f; font-size: 23rpx; line-height: 1.6; }
.delivery-page .od-alert { margin-bottom: 22rpx; }
.delivery-page .od-media-error { margin-top: 20rpx; }
.delivery-page .od-media-error text:nth-child(2) { flex: 1; min-width: 0; }
.delivery-page .od-text-link { flex-shrink: 0; color: #5185c2; font-size: 23rpx; }
.delivery-page .od-badge-green, .delivery-page .od-badge-amber { padding: 5rpx 12rpx; border-radius: 8rpx; font-size: 21rpx; }
.delivery-page .od-badge-green { background: #edf8f3; color: #4b9a83; }
.delivery-page .od-badge-amber { background: #fff4e2; color: #b18b4c; }
.delivery-page .od-body-text { color: #6c7b90; font-size: 26rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-word; }
.delivery-page .od-space-top { margin-top: 18rpx; }
.delivery-page .od-exception-reason { margin-bottom: 12rpx; color: #ac7c39; font-size: 27rpx; }

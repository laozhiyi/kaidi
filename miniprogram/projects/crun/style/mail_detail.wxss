.delivery-page .od-primary { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 88rpx; padding: 18rpx 24rpx; border-radius: 24rpx; background: #397bc8; color: #fff; font-size: 29rpx; font-weight: 600; text-align: center; box-shadow: 0 8rpx 18rpx rgba(57,123,200,.12); }
.delivery-page .od-footer .od-primary { flex: 1; min-width: 0; width: auto; }

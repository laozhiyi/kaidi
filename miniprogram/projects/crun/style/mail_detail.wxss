.delivery-page .od-textarea { display: block; box-sizing: border-box; width: 100%; height: 196rpx; margin-top: 24rpx; padding: 24rpx; border-radius: 18rpx; background: #f6f8fc; color: #4e637f; font-size: 26rpx; line-height: 1.7; }
.delivery-page .od-upload-heading { display: flex; justify-content: space-between; margin: 26rpx 0 18rpx; color: #7c8da5; font-size: 24rpx; }

.delivery-page .od-caption { color: #939fb0; font-size: 22rpx; line-height: 1.6; word-break: break-word; }
.delivery-page .od-contact { display: flex; align-items: center; }
.delivery-page .od-contact-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 82rpx; height: 82rpx; border-radius: 26rpx; background: #eff5fe; color: #769acf; font-size: 43rpx; }
.delivery-page .od-contact-copy { flex: 1; min-width: 0; margin: 0 20rpx; }
.delivery-page .od-contact-name { margin: 3rpx 0; font-size: 28rpx; font-weight: 600; word-break: break-all; }
.delivery-page .od-call { flex-shrink: 0; padding: 12rpx 19rpx; border-radius: 24rpx; background: #edf4ff; color: #397bc8; font-size: 24rpx; }
.delivery-page .od-private-badge { color: #8d9caf; font-size: 20rpx; }
.delivery-page .od-code-box { display: flex; align-items: center; padding: 24rpx; border: 1rpx solid #e6eef9; border-radius: 18rpx; background: #f6f9ff; }
.delivery-page .od-code-copy { flex: 1; min-width: 0; }
.delivery-page .od-code { display: block; margin-top: 8rpx; color: #3a5e8d; font-size: 33rpx; font-weight: 600; line-height: 1.6; white-space: pre-wrap; word-break: break-all; }
.delivery-page .od-copy { flex-shrink: 0; margin-left: 16rpx; padding: 10rpx 18rpx; border-radius: 12rpx; background: #e7effd; color: #4b7fb9; font-size: 23rpx; }
.delivery-page .od-media { display: flex; flex-wrap: wrap; gap: 16rpx; }
.delivery-page .od-photo { display: block; width: calc((100% - 32rpx) / 3); height: 176rpx; margin-top: 20rpx; border-radius: 16rpx; background: #edf2f8; }
.delivery-page .od-note { margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #edf1f6; color: #65758a; font-size: 26rpx; line-height: 1.8; white-space: pre-wrap; word-break: break-word; }
.delivery-page .od-rider-note { margin-top: 8rpx; }

page { background: #f3f5f9; }
.ac-page { width: 100%; min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx 40rpx; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); color: #21304a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif; font-size: 27rpx; line-height: 1.6; background: #f3f5f9; }
.ac-page view, .ac-page text, .ac-page button, .ac-page input, .ac-page textarea { box-sizing: border-box; }
.ac-page .ac-eyebrow { color: #718099; font-size: 21rpx; letter-spacing: 2rpx; font-weight: 600; margin-bottom: 8rpx; }
.ac-page .ac-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 28rpx; }
.ac-page .ac-heading > view:first-child { flex: 1; min-width: 0; }
.ac-page .ac-heading > button { flex-shrink: 0; }
.ac-page .ac-title { font-size: 43rpx; font-weight: 600; letter-spacing: -1rpx; line-height: 1.3; }
.ac-page .ac-subtitle { margin-top: 10rpx; font-size: 24rpx; color: #718099; }
.ac-page .ac-muted { color: #718099; font-size: 24rpx; }
.ac-page .ac-card { width: 100%; padding: 28rpx; margin-bottom: 22rpx; border: 1rpx solid #e6ebf2; border-radius: 22rpx; background: #fff; overflow-wrap: anywhere; }
.ac-page .ac-section-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 22rpx; }
.ac-page .ac-section-title { font-weight: 600; font-size: 29rpx; }
.ac-page .ac-link { color: #2863db; font-size: 24rpx; font-weight: 500; flex-shrink: 0; }
.ac-page .ac-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #edf0f5; }
.ac-page .ac-row:last-child { border-bottom: 0; }
.ac-page .ac-row > view:first-child { flex: 1; min-width: 0; }
.ac-page .ac-row > text:last-child { text-align: right; }
.ac-page .ac-row-title { font-size: 27rpx; font-weight: 500; }
.ac-page .ac-row-desc { font-size: 23rpx; color: #718099; margin-top: 6rpx; }
.ac-page .ac-chevron { color: #a4aec0; font-size: 36rpx; font-weight: 400; flex-shrink: 0; }
.ac-page .ac-badge { flex-shrink: 0; display: inline-block; font-size: 22rpx; line-height: 1.5; padding: 5rpx 14rpx; border-radius: 8rpx; background: #eff4ff; color: #2863db; font-weight: 500; }
.ac-page .ac-badge.amber { background: #fff4df; color: #98601a; }
.ac-page .ac-badge.red { background: #fff0f0; color: #c04d4d; }
.ac-page .ac-badge.green { background: #eaf7f0; color: #277954; }
.ac-page .ac-badge.muted { background: #f0f2f6; color: #718099; }
.ac-page .ac-number { font-size: 44rpx; font-weight: 600; line-height: 1.3; font-variant-numeric: tabular-nums; letter-spacing: -1rpx; }
.ac-page .ac-stat-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-bottom: 24rpx; }
.ac-page .ac-stat { min-width: 0; border: 1rpx solid #e6ebf2; background: #fff; border-radius: 20rpx; padding: 24rpx; overflow-wrap: anywhere; }
.ac-page .ac-stat-label { font-size: 24rpx; color: #718099; margin-bottom: 12rpx; }
.ac-page .ac-stat-note { font-size: 22rpx; color: #718099; margin-top: 10rpx; }
.ac-page .ac-stat.blue { background: #2863db; border-color: #2863db; color: #fff; }
.ac-page .ac-stat.blue .ac-stat-label, .ac-page .ac-stat.blue .ac-stat-note { color: #e4edff; }
.ac-page .ac-text-red { color: #bd4848; }
.ac-page .ac-text-green { color: #277954; }
.ac-page .ac-text-blue { color: #2863db; }
.ac-page .ac-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.ac-page .ac-shortcut { min-width: 0; display: flex; align-items: center; gap: 14rpx; padding: 22rpx 16rpx; border: 1rpx solid #e9edf4; border-radius: 16rpx; background: #fafbfe; }
.ac-page .ac-shortcut > view:last-child { flex: 1; min-width: 0; }
.ac-page .ac-icon { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 16rpx; background: #edf3ff; color: #2863db; font-size: 32rpx; }
.ac-page .ac-shortcut-title { font-size: 25rpx; font-weight: 500; white-space: nowrap; }
.ac-page .ac-shortcut-desc { color: #718099; font-size: 21rpx; margin-top: 4rpx; }
.ac-page button { font-size: 26rpx; font-weight: 500; border-radius: 14rpx; padding: 20rpx 24rpx; line-height: 1.4; margin: 0; white-space: normal; }
.ac-page button::after { border: 0; }
.ac-page .ac-primary { background: #2863db; color: #fff; }
.ac-page .ac-secondary { background: #eef3fc; color: #2863db; }
.ac-page .ac-ghost { background: transparent; color: #66768d; border: 1rpx solid #e2e8f1; }
.ac-page .ac-small { font-size: 23rpx; padding: 14rpx 20rpx; flex-shrink: 0; }
.ac-page button[disabled] { opacity: .5; }
.ac-page .ac-notice { padding: 22rpx 24rpx; margin-bottom: 22rpx; border-radius: 16rpx; background: #eaf1ff; color: #365780; font-size: 24rpx; }
.ac-page .ac-notice.amber { color: #926128; background: #fff4e4; }
.ac-page .ac-notice.red { color: #b74343; background: #fff0f0; }
.ac-page .ac-state { text-align: center; padding: 52rpx 24rpx; }
.ac-page .ac-state-title { font-size: 29rpx; font-weight: 500; margin-bottom: 12rpx; }
.ac-page .ac-state button { display: inline-block; margin-top: 24rpx; }
.ac-page .ac-search { display: flex; align-items: center; gap: 16rpx; padding: 12rpx 14rpx 12rpx 22rpx; background: #fff; border: 1rpx solid #e2e8f1; border-radius: 16rpx; margin-bottom: 18rpx; }
.ac-page .ac-search input { flex: 1; min-width: 0; font-size: 26rpx; height: 66rpx; padding: 0; line-height: normal; color: #21304a; background: transparent; border: 0; }
.ac-page .ac-search-icon { color: #8a99ae; font-size: 31rpx; }
.ac-page .ac-tabs { white-space: nowrap; width: 100%; margin-bottom: 18rpx; }
.ac-page .ac-tab { display: inline-block; padding: 15rpx 23rpx; margin-right: 12rpx; border: 1rpx solid #e4e9f1; border-radius: 12rpx; background: #fff; color: #65758d; font-size: 25rpx; }
.ac-page .ac-tab.active { color: #fff; background: #2863db; border-color: #2863db; font-weight: 500; }
.ac-page .ac-filter-row { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.ac-page .ac-filter { flex: 1; min-width: 0; }
.ac-page .ac-filter-value { border: 1rpx solid #e2e8f1; border-radius: 12rpx; padding: 15rpx 20rpx; background: #fff; display: flex; justify-content: space-between; gap: 10rpx; font-size: 24rpx; }
.ac-page .ac-filter-value > text:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ac-page .ac-filter-summary { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; gap: 16rpx; color: #718099; font-size: 23rpx; }
.ac-page .ac-order-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 20rpx; }
.ac-page .ac-order-id { font-size: 23rpx; color: #718099; word-break: break-all; }
.ac-page .ac-order-title { font-size: 30rpx; font-weight: 600; }
.ac-page .ac-order-meta { color: #718099; font-size: 24rpx; margin-top: 6rpx; }
.ac-page .ac-order-main { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.ac-page .ac-order-main > view:first-child { flex: 1; min-width: 0; }
.ac-page .ac-price { font-size: 36rpx; font-weight: 600; color: #21304a; white-space: nowrap; }
.ac-page .ac-price small { font-size: 23rpx; }
.ac-page .ac-order-foot { border-top: 1rpx solid #edf0f5; padding-top: 18rpx; margin-top: 22rpx; display: flex; align-items: center; justify-content: space-between; font-size: 22rpx; color: #718099; gap: 14rpx; }
.ac-page .ac-order-warning { color: #b96022; background: #fff6e9; font-size: 23rpx; border-radius: 10rpx; padding: 12rpx 16rpx; margin-top: 20rpx; }
.ac-page .ac-list-footer { color: #718099; text-align: center; font-size: 23rpx; padding: 20rpx 0; }
.ac-page .ac-list-footer button { margin-bottom: 18rpx; }
.ac-page .ac-breadcrumb { color: #718099; font-size: 23rpx; margin-bottom: 22rpx; display: flex; gap: 14rpx; align-items: center; }
.ac-page .ac-detail-hero { border-top: 6rpx solid #2863db; }
.ac-page .ac-detail-status { font-size: 35rpx; font-weight: 600; margin: 12rpx 0; }
.ac-page .ac-progress { display: flex; margin-top: 30rpx; padding-top: 28rpx; border-top: 1rpx solid #edf0f5; }
.ac-page .ac-progress-step { flex: 1; min-width: 0; text-align: center; color: #8b97aa; font-size: 21rpx; position: relative; }
.ac-page .ac-progress-step::before { position: absolute; content: ''; height: 3rpx; background: #e6ebf3; top: 14rpx; left: 0; right: 0; }
.ac-page .ac-progress-step:first-child::before { left: 50%; }
.ac-page .ac-progress-step:last-child::before { right: 50%; }
.ac-page .ac-step-dot { position: relative; margin: 0 auto 12rpx; width: 30rpx; height: 30rpx; border: 5rpx solid #fff; border-radius: 50%; background: #dce3ef; }
.ac-page .ac-progress-step.done { color: #2863db; }
.ac-page .ac-progress-step.done .ac-step-dot { background: #2863db; }
.ac-page .ac-address { display: flex; gap: 20rpx; padding: 20rpx 0; }
.ac-page .ac-address-mark { width: 44rpx; height: 44rpx; border-radius: 12rpx; background: #eaf1ff; color: #2863db; text-align: center; line-height: 44rpx; font-size: 23rpx; flex-shrink: 0; }
.ac-page .ac-address-mark.green { background: #eaf7f0; color: #277954; }
.ac-page .ac-field { padding: 22rpx 0; border-bottom: 1rpx solid #edf0f5; }
.ac-page .ac-field:last-child { border-bottom: 0; }
.ac-page .ac-field-label { color: #718099; font-size: 24rpx; margin-bottom: 12rpx; }
.ac-page .ac-field-value { white-space: pre-wrap; word-break: break-word; }
.ac-page .ac-code { padding: 20rpx; background: #f3f6fb; border-radius: 12rpx; font-size: 29rpx; font-weight: 500; letter-spacing: 1rpx; white-space: pre-wrap; }
.ac-page .ac-images { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 16rpx; }
.ac-page .ac-image { width: 160rpx; height: 160rpx; border-radius: 14rpx; background: #f1f4f8; }
.ac-page .ac-timeline { border-left: 2rpx solid #e3eaf6; margin-left: 10rpx; padding-left: 28rpx; }
.ac-page .ac-event { position: relative; padding-bottom: 28rpx; }
.ac-page .ac-event:last-child { padding-bottom: 0; }
.ac-page .ac-event::before { content: ''; position: absolute; left: -36rpx; top: 9rpx; width: 14rpx; height: 14rpx; border-radius: 50%; background: #8aafe9; border: 3rpx solid #fff; }
.ac-page .ac-event-title { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 26rpx; font-weight: 500; }
.ac-page .ac-event-time { color: #8995a8; font-size: 21rpx; margin-top: 5rpx; }
.ac-page .ac-event-note { color: #63748c; font-size: 24rpx; margin-top: 10rpx; white-space: pre-wrap; }
.ac-page textarea { width: 100%; height: 210rpx; background: #f6f8fc; border: 1rpx solid #e4eaf4; border-radius: 14rpx; padding: 22rpx; color: #21304a; font-size: 27rpx; line-height: 1.7; }
.ac-page .ac-counter { color: #8995a8; text-align: right; font-size: 22rpx; margin: 8rpx 0 20rpx; }
.ac-page .ac-form-picker { padding: 22rpx; background: #f5f8fd; border: 1rpx solid #e4eaf4; border-radius: 14rpx; display: flex; justify-content: space-between; margin-bottom: 24rpx; }
.ac-page .ac-number-input { width: 145rpx; height: 76rpx; padding: 0 18rpx; line-height: normal; border: 1rpx solid #e4eaf4; background: #f6f8fc; border-radius: 12rpx; text-align: right; font-size: 28rpx; }
.ac-page .ac-input-unit { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; }
.ac-page .ac-input-unit > text { min-width: 42rpx; color: #718099; font-size: 23rpx; }
.ac-page .ac-form-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 28rpx; }
.ac-page .ac-form-actions button { flex: 1 1 180rpx; min-width: 0; }
.ac-page .ac-summary-text { color: #63748c; font-size: 26rpx; white-space: pre-wrap; }
.ac-page .ac-clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
.ac-page .ac-chart-row { display: flex; align-items: center; gap: 18rpx; margin: 23rpx 0; }
.ac-page .ac-chart-label { width: 104rpx; flex-shrink: 0; font-size: 24rpx; color: #63748c; }
.ac-page .ac-chart-track { flex: 1; height: 16rpx; border-radius: 20rpx; background: #f0f3f8; overflow: hidden; }
.ac-page .ac-chart-bar { height: 100%; background: #7ca3ed; border-radius: 20rpx; }
.ac-page .ac-chart-bar.green { background: #59ac87; }
.ac-page .ac-chart-bar.red { background: #df8383; }
.ac-page .ac-chart-bar.amber { background: #e4b76f; }
.ac-page .ac-chart-bar.muted { background: #b2bdcd; }
.ac-page .ac-chart-value { width: 96rpx; text-align: right; font-size: 23rpx; font-variant-numeric: tabular-nums; }
.ac-page .ac-section-label { color: #718099; font-size: 23rpx; margin: 30rpx 0 16rpx; }
.ac-page .ac-account { display: flex; align-items: center; gap: 20rpx; }
.ac-page .ac-avatar { width: 78rpx; height: 78rpx; border-radius: 20rpx; background: #eaf1ff; color: #2863db; display: flex; align-items: center; justify-content: center; font-size: 40rpx; flex-shrink: 0; }
.ac-page .ac-footnote { color: #8995a8; text-align: center; font-size: 22rpx; margin: 22rpx 0 8rpx; }

/* Native inputs center their own text. Vertical padding displaces that text
   on iOS/Android; keep padding horizontal and let the control own its height. */
.ac-page input { min-width: 0; padding-top: 0; padding-bottom: 0; line-height: normal; font-family: inherit; letter-spacing: normal; }
.ac-page textarea { font-family: inherit; letter-spacing: normal; }
.ac-page .ac-placeholder { color: #98a4b6; }
.ac-page .ac-input { display: block; width: 100%; height: 88rpx; padding: 0 22rpx; border: 1rpx solid #e4eaf4; border-radius: 14rpx; background: #f6f8fc; color: #21304a; font-size: 27rpx; }
.ac-page .ac-form-field { min-width: 0; margin-top: 26rpx; }
.ac-page .ac-form-field:first-child { margin-top: 0; }
.ac-page .ac-label { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10rpx; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 500; }
.ac-page .ac-optional { color: #8995a8; font-size: 22rpx; font-weight: 400; }
.ac-page .ac-required { color: #c04d4d; }
.ac-page .ac-field-hint { margin-top: 10rpx; color: #8995a8; font-size: 23rpx; }
.ac-page .ac-field-error { margin-top: 10rpx; color: #b74343; font-size: 23rpx; }
.ac-page .ac-select { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 88rpx; padding: 18rpx 22rpx; background: #f6f8fc; border: 1rpx solid #e4eaf4; border-radius: 14rpx; }
.ac-page .ac-select > text:first-child { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.ac-page .ac-select > text:last-child { flex-shrink: 0; color: #8995a8; }
.ac-page .ac-card-title { display: flex; align-items: center; gap: 16rpx; margin-bottom: 26rpx; }
.ac-page .ac-card-title > view:last-child { flex: 1; min-width: 0; }
.ac-page .ac-card-title .ac-icon { width: 60rpx; height: 60rpx; font-size: 30rpx; }
.ac-page .ac-card-desc { margin-top: 6rpx; color: #718099; font-size: 23rpx; }
.ac-page .ac-entry-head { display: flex; align-items: flex-start; gap: 18rpx; }
.ac-page .ac-entry-main { flex: 1; min-width: 0; }
.ac-page .ac-entry-title { color: #21304a; font-size: 30rpx; font-weight: 600; overflow-wrap: anywhere; }
.ac-page .ac-entry-meta { margin-top: 8rpx; font-size: 23rpx; color: #718099; overflow-wrap: anywhere; }
.ac-page .ac-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.ac-page .ac-kv { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; margin-top: 20rpx; font-size: 25rpx; }
.ac-page .ac-kv > text:first-child { color: #718099; flex: 0 0 128rpx; }
.ac-page .ac-kv > text:last-child { min-width: 0; text-align: right; overflow-wrap: anywhere; word-break: break-word; }
.ac-page .ac-card-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid #edf0f5; }
.ac-page .ac-card-actions button { flex: 1 1 160rpx; min-width: 0; font-size: 24rpx; padding: 16rpx 14rpx; }
.ac-page .ac-card-actions.two button { flex-basis: 40%; }
.ac-page .ac-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-bottom: 22rpx; }
.ac-page .ac-toolbar picker { flex: 1; min-width: 0; }
.ac-page .ac-toolbar .ac-filter-value { min-height: 74rpx; align-items: center; }
.ac-page .ac-toolbar .ac-link { padding: 12rpx 0; }
.ac-page .ac-list-footer .ac-secondary { width: 100%; }
.ac-page .ac-id { word-break: break-all; font-variant-numeric: tabular-nums; }
.ac-page .ac-editor { display: block; width: 100%; min-width: 0; }
.ac-page .ac-empty-icon { display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; margin: 0 auto 22rpx; color: #8da3c6; background: #f0f4fb; border-radius: 24rpx; font-size: 42rpx; }
@media (max-width: 360px) {
  .ac-page { padding-left: 22rpx; padding-right: 22rpx; }
  .ac-page .ac-title { font-size: 40rpx; }
  .ac-page .ac-card { padding: 24rpx; }
  .ac-page .ac-stat-grid, .ac-page .ac-grid { gap: 14rpx; }
  .ac-page .ac-stat { padding: 22rpx; }
  .ac-page .ac-shortcut { gap: 12rpx; padding: 22rpx 12rpx; }
  .ac-page .ac-shortcut .ac-icon { width: 54rpx; height: 54rpx; font-size: 28rpx; border-radius: 14rpx; }
  .ac-page .ac-shortcut-desc { font-size: 20rpx; }
  .ac-page .ac-number { font-size: 41rpx; }
}

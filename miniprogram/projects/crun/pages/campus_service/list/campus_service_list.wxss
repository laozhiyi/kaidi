@import "../../../style/skin.wxss";

.page {
	min-height: 100vh;
	background-color: #f1f6ff;
	padding-bottom: 60rpx;
}

/* 顶部说明 */
.header {
	background: linear-gradient(135deg, #4a8fe0 0%, #397bc8 50%, #2f69b3 100%);
	padding: 50rpx 40rpx 60rpx;
}

.header-title {
	font-size: 40rpx;
	font-weight: bold;
	color: #fff;
	margin-bottom: 12rpx;
}

.header-desc {
	font-size: 26rpx;
	color: rgba(255, 255, 255, .85);
	line-height: 40rpx;
}

/* 列表 */
.list {
	padding: 0 25rpx;
	margin-top: -30rpx;
}

/* 客服卡片 */
.service-card {
	background-color: #fff;
	border-radius: 24rpx;
	padding: 30rpx 30rpx 30rpx;
	margin-bottom: 25rpx;
	box-shadow: 0 4rpx 16rpx rgba(216, 220, 223, .4);
}

.card-head {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 24rpx;
	padding-bottom: 20rpx;
	border-bottom: 2rpx dashed #f1f4fa;
}

.campus {
	font-size: 36rpx;
	font-weight: bold;
	color: #1f2a44;
}

.status {
	font-size: 22rpx;
	color: #fff;
	background-color: #2dc87a;
	padding: 4rpx 16rpx;
	border-radius: 20rpx;
}

.status-offline {
	background-color: #94a3b8;
}

.info-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	font-size: 28rpx;
	margin-bottom: 14rpx;
}

.info-row:last-of-type {
	margin-bottom: 0;
}

.info-label {
	color: #94a3b8;
	flex-shrink: 0;
	width: 140rpx;
}

.info-value {
	color: #1f2a44;
	flex: 1;
	text-align: right;
	word-break: break-all;
}

/* 电话(蓝色可点击) */
.info-value.phone {
	color: #397bc8;
	font-weight: 600;
}

/* 微信号/QQ(可点击复制,带复制标签) */
.wechat-value {
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}

.wechat-text {
	color: #1f2a44;
}

.wechat-copy-icon {
	color: #fff;
	background-color: #397bc8;
	font-size: 22rpx;
	padding: 4rpx 14rpx;
	border-radius: 20rpx;
	margin-left: 12rpx;
	font-weight: 500;
	flex-shrink: 0;
}

/* 操作按钮行 */
.btn-row {
	display: flex;
	flex-direction: row;
	gap: 16rpx;
	margin-top: 24rpx;
	padding-top: 20rpx;
	border-top: 2rpx dashed #f1f4fa;
}

.btn {
	flex: 1;
	height: 76rpx;
	border-radius: 38rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.btn-text {
	font-size: 26rpx;
	margin-left: 6rpx;
}

/* 电话按钮 */
.btn-primary {
	background: linear-gradient(135deg, #4a8fe0, #397bc8);
	color: #fff;
}

/* 微信按钮 */
.btn-wechat {
	background-color: #f1f6ff;
	color: #07c160;
	border: 2rpx solid #07c160;
}

/* QQ按钮 */
.btn-qq {
	background-color: #f1f6ff;
	color: #12b7f5;
	border: 2rpx solid #12b7f5;
}

/* 空状态 */
.empty {
	padding: 150rpx 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.empty-icon {
	font-size: 120rpx;
	opacity: .5;
	margin-bottom: 20rpx;
}

.empty-text {
	color: #94a3b8;
	font-size: 28rpx;
}

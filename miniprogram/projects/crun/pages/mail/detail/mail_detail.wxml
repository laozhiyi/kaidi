<import src="../tpl/mail_detail_tpl.wxml"/>
<view class="delivery-page">
 <view wx:if="{{isLoad !== true}}" class="od-state"><view class="od-state-icon"><text class="icon-{{isLoad === null ? 'time' : 'info'}}"></text></view><view class="od-state-title">{{isLoad === null ? '正在获取订单' : isLoad === 'notexist' ? '订单暂不可用' : '暂时无法加载'}}</view><view class="od-state-note">{{isLoad === null ? '为你整理本次代取的最新进展' : isLoad === 'notexist' ? '订单不存在或已删除，请返回列表选择其他订单' : errorMessage}}</view><button wx:if="{{isLoad === false}}" class="od-primary" bindtap="_loadDetail">重新加载</button><view wx:if="{{isLoad !== null}}" class="od-state-link" bindtap="bindBackOrders">返回订单列表</view></view>
 <block wx:if="{{isLoad === true && mail}}">
  <template is="mailDetailContent" data="{{mail: mail, ui: detailUI}}"/>
  <view wx:if="{{errorMessage}}" class="od-config-note" bindtap="bindReload">订单暂未更新，点击重试。</view>
  <view wx:if="{{favoriteSyncError}}" class="od-config-note">收藏数量暂未更新，下拉刷新可重试。</view>
  <view class="od-footer"><button class="od-footer-tool" bindtap="bindServiceHelpTap"><text class="icon-service"></text><text>客服</text></button><button class="od-footer-tool od-favorite {{mail.MAIL_IS_FAV ? 'saved' : ''}}" bindtap="bindFavoriteTap" loading="{{favoriteBusy}}" disabled="{{favoriteBusy || (!mail.MAIL_IS_FAV && !mail.MAIL_CAN_FAV)}}" aria-label="{{mail.MAIL_IS_FAV ? '取消收藏订单' : '收藏订单'}}"><text class="icon-{{mail.MAIL_IS_FAV ? 'favorfill' : 'favor'}}"></text><text>{{mail.MAIL_IS_FAV ? '已收藏' : '收藏'}} {{mail.MAIL_FAV_CNT}}</text></button><view wx:if="{{!detailUI.participant}}" class="od-footer-fee"><text class="od-label">代取费用</text><view><text>¥</text>{{detailUI.fee}}</view></view><button wx:if="{{detailUI.participant}}" class="od-primary" bindtap="bindManageTap">管理订单</button><button wx:else class="od-primary" bindtap="bindAcceptTap" disabled="{{!mail.canAccept || accepting}}" loading="{{accepting}}">{{accepting ? '正在接单' : mail.canAccept ? '立即接单' : '当前不可接单'}}</button></view>
 </block>
</view>

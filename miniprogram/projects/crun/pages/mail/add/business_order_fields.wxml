<template name="buy-fields">
   <view class="pub-card pub-view">
    <view class="pub-heading pub-view"><view class="pub-view"><text class="pub-section-no pub-text">01</text><text class="pub-text">买些什么</text></view></view>
    <view class="pub-field-row pub-view"><view class="pub-field-label pub-view">商品及规格 <text class="pub-required pub-text">*</text></view><view class="pub-input-box pub-view"><textarea class="pub-address-input pub-textarea" value="{{mailValues.goods}}" maxlength="500" auto-height placeholder="例如：某品牌纯牛奶250ml，缺货时请先联系我" bindinput="bindMailInput" data-mark="goods" disabled="{{submitting}}" /></view></view>
    <view class="pub-field-row pub-view"><view class="pub-field-label pub-view">购买数量 <text class="pub-required pub-text">*</text></view><view class="pub-input-box pub-view"><input class="pub-input" type="number" maxlength="2" value="{{mailValues.buyQuantity}}" placeholder="1至99件" bindinput="bindMailInput" data-mark="buyQuantity" disabled="{{submitting}}" /></view></view>
    <view class="pub-field-row pub-view"><view class="pub-field-label pub-view">商品总预算（元） <text class="pub-required pub-text">*</text></view><view class="pub-input-box pub-view"><input class="pub-input" type="digit" value="{{mailValues.goodsBudget}}" placeholder="全部商品的预算，不含跑腿费" bindinput="bindMailInput" data-mark="goodsBudget" disabled="{{submitting}}" /></view></view>
    <view class="pub-field-row pub-view"><view class="pub-field-label pub-view">购买地点 <text class="pub-required pub-text">*</text></view><view class="pub-input-box pub-view"><textarea class="pub-address-input pub-textarea" value="{{packageItems[0].pickupPoint}}" maxlength="100" auto-height placeholder="填写店铺与位置，或填写就近购买" bindinput="bindPackageItemInput" data-index="0" data-mark="pickupPoint" disabled="{{submitting}}" /></view></view>
    <view class="pub-field-row pub-view"><view class="pub-field-label pub-view">跑腿费（元） <text class="pub-required pub-text">*</text></view><view class="pub-input-box pub-view"><input class="pub-input" type="digit" value="{{packageItems[0].price}}" placeholder="请填写本单跑腿费" bindinput="bindPackageItemInput" data-index="0" data-mark="price" disabled="{{submitting}}" /></view></view>
    <view class="pub-footnote pub-view">商品款按实际小票与骑手线下结算；超出预算须先确认。跑腿费另计。</view>
   </view>
</template>
<template name="parcel-fields">
   <view class="pub-card pub-view">
    <view class="pub-heading pub-view"><view class="pub-view"><text class="pub-section-no pub-text">01</text><text class="pub-text">选择包裹</text></view><text class="pub-caption pub-text">按件计费</text></view>
    <view class="pub-price-editor pub-view"><view class="pub-view"><view class="pub-price-title pub-view">参考价格与本单合计</view><view class="pub-price-tip pub-view">参考价会随件型显示；每件费用可在下方单独调整</view></view><view class="pub-price-total pub-view">¥{{totalFee}}</view></view>
    <view class="pub-packages pub-view">
     <view class="pub-package {{item.count > 0 ? 'pub-package-selected' : ''}} pub-view" wx:for="{{packageTypes}}" wx:key="mark">
      <view class="pub-parcel pub-parcel-{{item.mark}} pub-view"><view class="pub-view"></view></view>
      <view class="pub-package-name pub-view">{{item.label}}</view><view class="pub-package-price pub-view">¥<text class="pub-text">{{item.price}}</text><text class="pub-per-item pub-text"> /件</text></view>
      <view class="pub-counter pub-view"><button class="pub-counter-button pub-button-base {{(item.count===0 || totalCount<=1) ? 'pub-disabled' : ''}}" disabled="{{item.count===0 || totalCount<=1}}" bindtap="bindPackageTap" data-index="{{index}}" data-step="-1">−</button><text class="pub-text">{{item.count}}</text><button class="pub-counter-button pub-counter-add pub-button-base {{(totalCount>=config.maxPackages) ? 'pub-disabled' : ''}}" disabled="{{totalCount>=config.maxPackages}}" bindtap="bindPackageTap" data-index="{{index}}" data-step="1">＋</button></view>
     </view>
    </view>
    <view wx:if="{{packageItems.length}}" class="pub-package-details pub-view">
     <view class="pub-detail-title pub-view">每件包裹信息 <text class="pub-text">{{serviceType === 'send' ? '价格独立设置，请填写取件位置和物品说明' : '价格独立设置，取件码和截图二选一'}}</text></view>
     <view wx:for="{{packageItems}}" wx:key="id" class="pub-package-detail pub-view">
      <view class="pub-package-detail-head pub-view"><text class="pub-text">{{index + 1}}. {{item.label}}</text><text class="pub-package-reference pub-text">参考 ¥{{item.referencePrice || item.price}}</text></view>
      <view class="pub-package-options-row pub-view">
       <view class="pub-package-custom-price pub-view"><text class="pub-package-input-label pub-text">自定义价格</text><view class="pub-package-price-value pub-view"><input class="pub-input" type="digit" value="{{item.price}}" data-index="{{index}}" data-mark="price" bindinput="bindPackageItemInput" placeholder="本件费用" disabled="{{submitting}}"/><text class="pub-text">元</text></view></view>
       <button class="pub-package-pickup pub-button-base {{(submitting) ? 'pub-disabled' : ''}}" bindtap="bindOpenPackagePickup" data-id="{{item.id}}" disabled="{{submitting}}" aria-label="填写第{{index + 1}}件包裹的取件点"><text class="pub-package-input-label pub-text">取件点</text><view class="pub-package-pickup-value pub-view"><text class="pub-package-pickup-name {{!item.pickupPoint ? 'pub-package-pickup-empty' : ''}} pub-text">{{item.pickupPoint || (serviceType === 'send' ? '填写取件位置' : '选择快递点')}}</text><text class="icon-right pub-text"></text></view></button>
      </view>
      <view wx:if="{{serviceType === 'take'}}" class="pub-package-proof-row pub-view">
       <input class="pub-package-proof-input pub-input" value="{{item.code}}" data-index="{{index}}" data-mark="code" bindinput="bindPackageItemInput" placeholder="取件码"/>
       <view class="pub-package-upload pub-view" bindtap="bindPackageImageTap" data-index="{{index}}">
        <block wx:if="{{item.images && item.images.length}}"><image class="pub-package-thumb pub-image" src="{{item.images[0]}}" mode="aspectFill" catchtap="bindPackagePreviewImage" data-index="{{index}}"/></block>
        <block wx:else><text class="icon-camera pub-text"></text><text class="pub-text">上传截图</text></block>
       </view>
      </view>
      <input class="pub-package-note-input pub-input" value="{{item.note}}" maxlength="300" data-index="{{index}}" data-mark="note" bindinput="bindPackageItemInput" placeholder="{{serviceType === 'send' ? '物品名称、交接方式等（选填）' : '备注（选填）'}}"/>
     </view>
    </view>
    <view class="pub-footnote pub-view">共 {{totalCount}} 件包裹 · 请按实际大小选择规格</view>
   </view>

</template>

@import "../../../style/skin.wxss";

page {
	background: #f1f6ff;
	color: #252b35;
}

.mail-loading {
	color: #8a98a8;
}

.mail-add-page {
	min-height: 100vh;
	box-sizing: border-box;
	padding-bottom: 150rpx;
}

.mail-add-content {
	padding: 24rpx 24rpx 34rpx;
}

.mail-card {
	box-sizing: border-box;
	width: 100%;
	margin-bottom: 20rpx;
	padding: 28rpx;
	background: #fff;
	border-radius: 24rpx;
	box-shadow: 0 8rpx 24rpx rgba(75, 115, 172, .1);
}

.package-card {
	padding: 28rpx 20rpx 22rpx;
}

.package-list {
	display: flex;
	gap: 18rpx;
}

.package-item {
	flex: 1;
	min-width: 0;
	box-sizing: border-box;
	padding: 24rpx 10rpx 20rpx;
	border: 2rpx solid #e4e7eb;
	border-radius: 22rpx;
	text-align: center;
	color: #40464f;
}

.package-item.active {
	border-color: #397bc8;
	background: #f1f6ff;
	color: #397bc8;
}

.package-name {
	font-size: 30rpx;
	line-height: 44rpx;
	white-space: nowrap;
}

.package-name text {
	font-size: 25rpx;
}

.package-counter {
	display: flex;
	align-items: center;
	justify-content: center;
	margin-top: 22rpx;
}

.counter-btn {
	width: 52rpx;
	height: 52rpx;
	box-sizing: border-box;
	border: 2rpx solid #e1e4e8;
	border-radius: 50%;
	font-size: 38rpx;
	font-weight: 300;
	line-height: 46rpx;
	color: #397bc8;
	background: #fff;
}

.counter-btn:active,
.paste-btn:active,
.proof-upload:active,
.publish-btn:active {
	opacity: .8;
}

.counter-value {
	width: 54rpx;
	font-size: 36rpx;
	line-height: 52rpx;
	color: #20252c;
}

.section-heading {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	margin-bottom: 20rpx;
	font-size: 36rpx;
	font-weight: 600;
	line-height: 50rpx;
}

.required-mark {
	margin-right: 8rpx;
	color: #ed5b65;
}

.section-hint {
	font-size: 24rpx;
	font-weight: 400;
	color: #a1a7b0;
}

.code-editor {
	position: relative;
	box-sizing: border-box;
	min-height: 190rpx;
	padding: 22rpx 22rpx 70rpx;
	border: 2rpx solid #e3e5e8;
	border-radius: 20rpx;
	background: #fff;
}

.code-editor textarea {
	width: 100%;
	min-height: 110rpx;
	font-size: 30rpx;
	line-height: 44rpx;
}

.mail-placeholder {
	color: #aeb3ba;
}

.paste-btn {
	position: absolute;
	right: 20rpx;
	bottom: 16rpx;
	padding: 10rpx 20rpx;
	border: 2rpx solid #397bc8;
	border-radius: 14rpx;
	font-size: 26rpx;
	font-weight: 600;
	line-height: 36rpx;
	color: #397bc8;
}

.or-line {
	display: flex;
	align-items: center;
	gap: 18rpx;
	margin: 24rpx 0;
	color: #aeb3ba;
	font-size: 26rpx;
}

.or-line view {
	flex: 1;
	height: 2rpx;
	background: #e5e7ea;
}

.proof-upload {
	display: inline-flex;
	align-items: center;
	padding: 13rpx 24rpx;
	border-radius: 20rpx;
	background: #397bc8;
	font-size: 28rpx;
	font-weight: 600;
	line-height: 40rpx;
	color: #fff;
}

.upload-icon {
	margin-right: 8rpx;
	font-size: 34rpx;
	font-weight: 300;
}

.proof-list {
	display: flex;
	flex-wrap: wrap;
	gap: 16rpx;
	margin-top: 20rpx;
}

.proof-item {
	position: relative;
	width: 140rpx;
	height: 140rpx;
	overflow: hidden;
	border-radius: 12rpx;
}

.proof-item image {
	display: block;
	width: 100%;
	height: 100%;
}

.proof-remove {
	position: absolute;
	top: 0;
	right: 0;
	width: 38rpx;
	height: 38rpx;
	border-bottom-left-radius: 12rpx;
	background: rgba(0, 0, 0, .55);
	font-size: 30rpx;
	line-height: 36rpx;
	text-align: center;
	color: #fff;
}

.address-card {
	padding: 0;
}

.address-row,
.contact-row,
.deadline-card {
	display: flex;
	align-items: center;
	min-height: 94rpx;
	box-sizing: border-box;
	padding: 18rpx 28rpx;
	border-bottom: 2rpx solid #f0f1f3;
}

.address-row:last-child {
	border-bottom: 0;
}

.address-label {
	flex-shrink: 0;
	width: 190rpx;
	font-size: 32rpx;
	line-height: 46rpx;
}

.rider-label {
	padding-left: 16rpx;
}

.address-input {
	flex: 1;
	min-width: 0;
	font-size: 28rpx;
	line-height: 42rpx;
	text-align: right;
	color: #30353d;
}

.row-arrow {
	flex-shrink: 0;
	margin-left: 14rpx;
	font-size: 40rpx;
	font-weight: 300;
	line-height: 40rpx;
	color: #a4a9b0;
}

.more-card {
	padding: 0 28rpx;
}

.more-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	min-height: 100rpx;
}

.more-title {
	font-size: 34rpx;
	font-weight: 600;
}

.more-body {
	padding: 0 0 24rpx;
}

.more-body textarea {
	box-sizing: border-box;
	width: 100%;
	min-height: 110rpx;
	padding: 18rpx;
	border: 2rpx solid #e3e5e8;
	border-radius: 16rpx;
	font-size: 28rpx;
	line-height: 42rpx;
}

.tip-card {
	padding: 24rpx 28rpx;
	font-size: 27rpx;
	line-height: 42rpx;
	color: #397bc8;
}

.contact-card {
	padding: 0 28rpx;
}

.card-title {
	padding: 26rpx 0 8rpx;
	font-size: 32rpx;
	font-weight: 600;
}

.contact-row {
	padding: 18rpx 0;
}

.contact-row:last-child {
	border-bottom: 0;
}

.contact-label {
	width: 150rpx;
	font-size: 29rpx;
	color: #4b525d;
}

.contact-row input {
	flex: 1;
	min-width: 0;
	font-size: 29rpx;
	line-height: 42rpx;
}

.deadline-card {
	justify-content: space-between;
	padding: 18rpx 28rpx;
	border-bottom: 0;
}

.deadline-label {
	font-size: 30rpx;
	line-height: 44rpx;
}

.deadline-value {
	display: flex;
	align-items: center;
	font-size: 28rpx;
	line-height: 44rpx;
	color: #a1a7b0;
}

.deadline-value.selected {
	color: #30353d;
}

.mail-error {
	padding: 0 30rpx 20rpx;
	font-size: 24rpx;
	color: #ed5b65;
}

.mail-submit-bar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 20;
	display: flex;
	align-items: center;
	box-sizing: border-box;
	min-height: 132rpx;
	padding: 18rpx 28rpx;
	background: rgba(255, 255, 255, .98);
	box-shadow: 0 -6rpx 20rpx rgba(55, 83, 119, .1);
}

.fee-summary {
	display: flex;
	align-items: baseline;
	white-space: nowrap;
	font-size: 25rpx;
	color: #515863;
}

.fee-value {
	margin-left: 8rpx;
	font-size: 40rpx;
	font-weight: 700;
	color: #397bc8;
}

.fee-caret {
	margin-left: 4rpx;
	font-size: 26rpx;
	color: #397bc8;
}

.count-summary {
	flex: 1;
	margin-left: 24rpx;
	font-size: 26rpx;
	white-space: nowrap;
	color: #515863;
}

.publish-btn {
	width: 250rpx;
	height: 84rpx;
	margin: 0;
	padding: 0;
	border: 0;
	border-radius: 22rpx;
	background: #397bc8;
	font-size: 32rpx;
	font-weight: 600;
	line-height: 84rpx;
	color: #fff;
}

.publish-btn::after {
	border: 0;
}

.mail-form-engine {
	position: absolute;
	left: -9999px;
	top: 0;
	width: 1px;
	height: 1px;
	overflow: hidden;
	opacity: 0;
	pointer-events: none;
}

@media (max-width: 360px) {
	.package-list {
		gap: 10rpx;
	}

	.package-item {
		padding-left: 2rpx;
		padding-right: 2rpx;
	}

	.package-name {
		font-size: 27rpx;
	}

	.address-label {
		width: 170rpx;
	}

	.publish-btn {
		width: 220rpx;
	}
}

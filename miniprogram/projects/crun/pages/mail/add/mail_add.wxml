<import src="./business_order_fields.wxml" />
<view class="publish-page {{embedded ? 'publish-embedded' : ''}} pub-view">
 <view wx:if="{{hasPendingSubmission}}" class="pub-card pub-recovery pub-view">
  <view class="pub-recovery-title pub-view">上次提交结果待确认</view>
  <view class="pub-caption pub-view">核对后保留已保存的订单，停止未保存的提交，再继续填写。</view>
  <button class="pub-button pub-button-base {{(submitting) ? 'pub-disabled' : ''}}" bindtap="bindRecoverSubmission" loading="{{submitting}}" disabled="{{submitting}}">核对上次提交</button>
 </view>
 <view wx:if="{{!isLoad}}" class="pub-state pub-view">
  <view class="pub-state-icon pub-view"><text class="icon-{{configError ? 'info' : 'time'}} pub-text"></text></view>
  <view class="pub-state-title pub-view">{{configError ? '暂时无法加载' : '正在准备发单信息'}}</view>
  <view class="pub-state-note pub-view">{{configError ? loadError : '获取校区和包裹价格，请稍候'}}</view>
  <button wx:if="{{configError}}" class="pub-button pub-button-base {{(pageLoading) ? 'pub-disabled' : ''}}" bindtap="bindRetryLoad" loading="{{pageLoading}}" disabled="{{pageLoading}}">重新加载</button>
 </view>
 <block wx:if="{{isLoad}}">
  <view class="pub-hero pub-view">
   <view class="pub-hero-copy pub-view"><view class="pub-eyebrow pub-view">校园生活 · 少跑一趟</view><view class="pub-hero-title pub-view">{{editId ? '修改' + serviceName + '订单' : serviceType === 'buy' ? '想买的，帮你带回来' : serviceType === 'send' ? '物品，帮你送过去' : '快递，帮你带回来'}}</view><view class="pub-hero-note pub-view">{{serviceType === 'buy' ? '写清商品与预算，购买后送到你手中' : serviceType === 'send' ? '填好取件点和送达地址，剩下交给骑手' : '选好包裹，填好地址，剩下交给骑手'}}</view></view>
   <view class="pub-hero-symbol pub-view"><text class="icon-deliver pub-text"></text></view>
  </view>
  <view class="pub-content pub-view">
   <view class="pub-card pub-service pub-view">
    <view class="pub-campus-row pub-view"><view class="pub-campus-copy pub-view"><view class="pub-caption pub-view">当前服务校区</view><view class="pub-campus-name pub-view">{{config.schoolName}} · {{campus}}</view></view></view>
    <view class="pub-service-row pub-service-{{serviceState.kind}} pub-view"><view class="pub-status-label pub-view"><view class="pub-status-dot pub-view"></view><text class="pub-text">{{serviceState.title}}</text></view><text wx:if="{{serviceState.hours}}" class="pub-hours pub-text">{{serviceState.hours}}</text></view>
    <view wx:if="{{!serviceState.canPublish}}" class="pub-service-detail pub-view"><view class="pub-view">{{serviceState.description}}</view><view class="pub-service-actions pub-view"><text class="pub-text" bindtap="bindServiceHelpTap">联系校区客服 <text class="icon-right pub-text"></text></text><text class="pub-text" bindtap="bindRetryLoad">刷新状态</text></view></view>
   </view>
   <view wx:if="{{configError}}" class="pub-inline-error pub-view"><text class="pub-text">{{loadError}}，已保留所填内容。</text><text class="pub-text" bindtap="bindRetryLoad">重试</text></view>

   <view class="pub-card pub-options pub-deadline-card pub-view">
    <view class="pub-deadline pub-view"><view class="pub-option-label pub-view"><text class="icon-time pub-text"></text><text class="pub-text">客户期望接单截止时间</text></view><deadline-picker value="{{formEnd}}" disabled="{{submitting}}" bind:select="bindEndSelect" /></view>
    <view wx:if="{{formEndFocus}}" class="pub-validation pub-view">{{formEndFocus}}</view>
   </view>

   <template is="{{serviceForm}}" data="{{packageItems,packageTypes,serviceType,totalFee,totalCount,config,submitting,mailValues}}" />

   <view class="pub-card pub-route-card pub-view">
    <view class="pub-heading pub-view"><view class="pub-view"><text class="pub-section-no pub-text">02</text><text class="pub-text">送到哪里</text></view></view>
    <view class="pub-route-row pub-view">
     <view class="pub-route-head pub-view">
      <view class="pub-route-label pub-view"><view class="pub-route-marker pub-marker-send pub-view">送</view><text class="pub-field-label pub-text">送达地址 <text class="pub-required pub-text">*</text></text></view>
      <button class="pub-quick-select pub-button-base" hover-class="pub-quick-select-hover" bindtap="bindChooseProfileAddress" aria-label="选择常用地址">常用地址<text class="icon-right pub-text"></text></button>
     </view>
     <view class="pub-input-box pub-view"><textarea class="pub-address-input pub-textarea" value="{{mailValues.address2}}" maxlength="200" auto-height placeholder="例如：二期3号宿舍楼201室" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="address2" /></view>
    </view>
   </view>
    <view class="pub-card pub-contact-card pub-view">
     <view class="pub-heading pub-view">
      <view class="pub-view"><text class="pub-section-no pub-text">03</text><text class="pub-text">联系人信息</text></view>
      <button class="pub-quick-select pub-button-base" hover-class="pub-quick-select-hover" bindtap="bindChooseProfileContact" aria-label="选择常用联系人">常用联系人<text class="icon-right pub-text"></text></button>
     </view>
     <view class="pub-field-row pub-view">
      <view class="pub-field-label pub-view">联系人 <text class="pub-required pub-text">*</text></view>
      <view class="pub-input-box pub-view"><textarea class="pub-contact-input pub-textarea" value="{{mailValues.poster}}" maxlength="30" auto-height placeholder="方便骑手称呼你" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="poster" /></view>
     </view>
     <view class="pub-field-row pub-view">
      <view class="pub-field-label pub-view">手机号 <text class="pub-required pub-text">*</text></view>
      <view class="pub-input-box pub-view"><input class="pub-input" type="number" maxlength="11" value="{{mailValues.tel}}" placeholder="请输入可联系的手机号" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="tel" /></view>
     </view>
     <view class="pub-field-row pub-view">
      <view class="pub-field-label pub-view">第二联系方式 <text class="pub-field-optional pub-text">选填</text></view>
      <view class="pub-input-box pub-view"><input class="pub-input" value="{{mailValues.tel2}}" maxlength="50" placeholder="微信号或备用电话" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="tel2" /></view>
     </view>
    </view>
<view wx:if="{{config.urgentEnabled}}" class="pub-card pub-options pub-view">
    <view class="pub-option-row pub-view"><view class="pub-view"><view class="pub-option-label pub-view">加急 <text class="pub-urgent-tag pub-text">可选</text></view><view class="pub-caption pub-view">优先处理，预计 {{config.urgentMinutes}} 分钟内完成</view></view><switch class="pub-switch" checked="{{urgent}}" color="#397bc8" bindchange="bindUrgentChange"/></view>
   </view>
   <view class="pub-settlement pub-view" bindtap="bindSettlementTap"><text class="icon-info pub-text"></text><view class="pub-view"><text class="pub-text">费用线下结算，请勿提前转账</text><view class="pub-view">平台不代收、不担保 · 查看结算说明</view></view><text class="icon-right pub-text"></text></view>
  </view>

  <view class="pub-submit-bar pub-view"><view class="pub-total pub-view"><view class="pub-total-label pub-view">{{serviceType === 'buy' ? '跑腿费 · 不含商品款' : '共 ' + totalCount + ' 件 · 线下费用'}}</view><view class="pub-total-price pub-view"><text class="pub-text">¥</text>{{totalFee}}</view></view><button class="pub-submit pub-button-base {{(submitting || pageLoading || configError || (!serviceState.canPublish && !editId)) ? 'pub-disabled' : ''}}" hover-class="pub-submit-hover" bindtap="bindFormSubmit" loading="{{submitting}}" disabled="{{submitting || pageLoading || configError || (!serviceState.canPublish && !editId)}}">{{editId ? '保存修改' : serviceState.kind==='paused' ? '暂时停止接单' : serviceState.kind==='closed' ? '营业后可发布' : serviceType === 'buy' ? '发布代买订单' : serviceType === 'send' ? '发布代送订单' : '发布代取订单'}}<text wx:if="{{!submitting && serviceState.canPublish}}" class="icon-right pub-text"></text></button></view>
  <view class="pub-form-engine pub-view"><cmpt-form-show id="cmpt-form" mark="mail-add-engine" isCacheMatch="{{false}}" fields="{{fields}}" forms="{{formForms}}" isDefMatch="{{true}}"/></view>
 </block>
 <include src="./mail_profile_picker.wxml" />
 <include src="./mail_package_pickup.wxml" />
</view>

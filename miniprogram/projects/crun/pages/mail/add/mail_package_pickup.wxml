<view wx:if="{{packagePickupVisible}}" class="pub-sheet-mask pub-view" catchtouchmove="bindStopProp" bindtap="bindClosePackagePickup">
 <view class="pub-sheet pub-view" catchtap="bindStopProp">
  <view class="pub-sheet-handle pub-view"></view>
  <view class="pub-sheet-head pub-view"><view class="pub-view"><view class="pub-sheet-title pub-view">{{serviceType === 'send' ? '填写取件位置' : '选择常用快递点'}}</view><view class="pub-caption pub-view">第 {{packagePickupNumber}} 件包裹 · {{serviceType === 'send' ? '写清楼栋、门牌与交接位置' : '选择或填写对应的取件点'}}</view></view><text class="pub-sheet-close icon-close pub-text" catchtap="bindClosePackagePickup"></text></view>
  <scroll-view scroll-y class="pub-sheet-body">
   <view wx:if="{{serviceType !== 'send'}}" class="pub-station-group pub-view" wx:for="{{pickupStations}}" wx:for-item="phase" wx:key="name">
    <view class="pub-station-title pub-view">{{phase.name}}</view>
    <view class="pub-station-chips pub-view"><view class="pub-station-chip {{packagePickupDraft === (phase.name + ' · ' + item) ? 'pub-station-active' : ''}} pub-view" wx:for="{{phase.list}}" wx:key="*this" bindtap="bindSelectPackagePickup" data-phase="{{phase.name}}" data-name="{{item}}">{{item}}</view></view>
   </view>
   <view class="pub-field-label pub-view">{{serviceType === 'send' ? '取件地址' : '其他取件点'}}</view><view class="pub-input-box pub-view"><input class="pub-input" value="{{packagePickupDraft}}" maxlength="100" placeholder="{{serviceType === 'send' ? '例如：一期2栋101室门口' : '也可手动填写名称与位置'}}" placeholder-class="pub-placeholder" bindinput="bindPackagePickupInput" /></view>
   <view wx:if="{{packagePickupError}}" class="pub-validation pub-view">{{packagePickupError}}</view>
  </scroll-view>
  <button class="pub-button pub-button-base {{(!packagePickupDraft || submitting) ? 'pub-disabled' : ''}}" bindtap="bindConfirmPackagePickup" disabled="{{!packagePickupDraft || submitting}}">确认取件点</button>
 </view>
</view>

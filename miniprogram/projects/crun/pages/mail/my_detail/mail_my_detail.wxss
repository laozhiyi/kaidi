@import "../../../style/skin.wxss";

page {
	background: #f1f6ff;
	color: #252b35;
}

.mail-loading {
	color: #8a98a8;
}

.mail-detail-page {
	padding: 24rpx 24rpx 0;
	box-sizing: border-box;
}

/* ===== 顶部状态条 ===== */
.status-bar {
	display: flex;
	align-items: center;
	justify-content: space-between;
	box-sizing: border-box;
	padding: 26rpx 28rpx;
	margin-bottom: 22rpx;
	border-radius: 22rpx;
	background: linear-gradient(135deg, #5C9BEA 0%, #397BC8 100%);
	box-shadow: 0 8rpx 22rpx rgba(57, 123, 200, .25);
	color: #fff;
}

.status-bar.status-1 {
	background: linear-gradient(135deg, #ffb360 0%, #ff7a00 100%);
	box-shadow: 0 8rpx 22rpx rgba(255, 122, 0, .25);
}

.status-bar.status-9 {
	background: linear-gradient(135deg, #6ac780 0%, #43a847 100%);
	box-shadow: 0 8rpx 22rpx rgba(67, 168, 71, .25);
}

.status-bar.status-99 {
	background: linear-gradient(135deg, #b9bcc2 0%, #8a93a1 100%);
	box-shadow: 0 8rpx 22rpx rgba(138, 147, 161, .25);
}

.status-bar-main {
	flex: 1;
	min-width: 0;
}

.status-bar-title {
	display: block;
	font-size: 36rpx;
	font-weight: 700;
	line-height: 50rpx;
}

.status-bar-sub {
	display: block;
	margin-top: 6rpx;
	font-size: 24rpx;
	opacity: .9;
	line-height: 34rpx;
}

.urgent-pill {
	flex-shrink: 0;
	margin-left: 16rpx;
	padding: 6rpx 18rpx;
	border-radius: 24rpx;
	background: rgba(255, 255, 255, .22);
	font-size: 22rpx;
	line-height: 30rpx;
	font-weight: 600;
}

/* ===== 通用卡片 ===== */
.card {
	box-sizing: border-box;
	width: 100%;
	margin-bottom: 22rpx;
	padding: 26rpx 28rpx;
	background: #fff;
	border-radius: 22rpx;
	box-shadow: 0 8rpx 24rpx rgba(75, 115, 172, .1);
}

.card-heading {
	font-size: 30rpx;
	font-weight: 600;
	line-height: 44rpx;
	color: #1f2a44;
	margin-bottom: 18rpx;
}

/* ===== 进度条 ===== */
.progress-card {
	padding: 32rpx 28rpx 24rpx;
}

.progress-line {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0 6rpx;
}

.progress-dot {
	position: relative;
	flex-shrink: 0;
	box-sizing: border-box;
	width: 52rpx;
	height: 52rpx;
	border-radius: 50%;
	background: #eef0f4;
	font-size: 26rpx;
	line-height: 52rpx;
	color: #94a3b8;
	text-align: center;
	font-weight: 600;
	transition: background .2s ease;
}

.progress-dot.on {
	background: #397bc8;
	color: #fff;
	box-shadow: 0 4rpx 12rpx rgba(57, 123, 200, .35);
}

.progress-bar {
	flex: 1;
	height: 6rpx;
	background: #eef0f4;
	margin: 0 6rpx;
	border-radius: 4rpx;
	transition: background .2s ease;
}

.progress-bar.on {
	background: linear-gradient(90deg, #5C9BEA 0%, #397BC8 100%);
}

.dot-num {
	line-height: 52rpx;
}

.progress-label {
	display: flex;
	justify-content: space-between;
	margin-top: 14rpx;
	padding: 0 4rpx;
	font-size: 24rpx;
	color: #94a3b8;
	line-height: 34rpx;
}

.progress-label .on {
	color: #397bc8;
	font-weight: 600;
}

/* ===== 金额卡片 ===== */
.money-card {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.money-left {
	display: flex;
	align-items: baseline;
	color: #ff4d4f;
}

.money-left .symbol {
	font-size: 28rpx;
	font-weight: 600;
}

.money-left .num {
	font-size: 56rpx;
	font-weight: 700;
	margin-left: 4rpx;
	line-height: 1;
}

.money-left .tip {
	margin-left: 12rpx;
	font-size: 22rpx;
	color: #94a3b8;
}

.money-right {
	text-align: right;
}

.money-right .kv {
	display: flex;
	justify-content: flex-end;
	align-items: baseline;
	gap: 10rpx;
	margin-top: 4rpx;
	font-size: 24rpx;
	line-height: 34rpx;
}

.money-right .kv:first-child {
	margin-top: 0;
}

.money-right .k {
	color: #94a3b8;
}

.money-right .v {
	color: #30353d;
	font-weight: 500;
}

/* ===== 信息卡片 ===== */
.info-row {
	display: flex;
	align-items: flex-start;
	font-size: 26rpx;
	line-height: 38rpx;
	margin-bottom: 12rpx;
}

.info-row:last-child {
	margin-bottom: 0;
}

.info-row .lbl {
	flex-shrink: 0;
	width: 120rpx;
	color: #94a3b8;
	font-size: 26rpx;
}

.info-row .val {
	flex: 1;
	min-width: 0;
	color: #30353d;
	word-break: break-all;
}

.info-row .val.multi {
	white-space: pre-wrap;
	line-height: 1.5;
}

.info-row.code-row {
	background: #f4f8ff;
	border-radius: 16rpx;
	padding: 18rpx 20rpx;
	margin: 0 0 14rpx;
}

.code-row .lbl {
	color: #397bc8;
	width: auto;
	margin-right: 20rpx;
}

.val-wrap {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 16rpx;
}

.code-text {
	font-family: 'din';
	font-weight: 700;
	font-size: 36rpx;
	color: #397bc8;
	letter-spacing: 2rpx;
	flex: 1;
	min-width: 0;
	word-break: break-all;
}

.copy-btn {
	flex-shrink: 0;
	padding: 8rpx 22rpx;
	border-radius: 20rpx;
	background: #397bc8;
	font-size: 24rpx;
	line-height: 32rpx;
	color: #fff;
	font-weight: 500;
}

.copy-btn:active {
	opacity: .85;
}

.info-row.image-row {
	align-items: center;
}

.proof-img {
	width: 180rpx;
	height: 180rpx;
	border-radius: 16rpx;
	background: #eef0f4;
}

.proof-list {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-wrap: wrap;
	gap: 12rpx;
}

.tag-list {
	display: flex;
	flex-wrap: wrap;
	gap: 10rpx;
	padding-top: 2rpx;
}

.tag {
	display: inline-block;
	padding: 4rpx 16rpx;
	border-radius: 8rpx;
	font-size: 22rpx;
	line-height: 30rpx;
}

.tag.tag-blue {
	background: #eaf1fb;
	color: #397bc8;
}

.tag.tag-orange {
	background: #fff5e6;
	color: #ff7a00;
}

.tag.tag-red {
	background: #ffece6;
	color: #f56c6c;
}

/* ===== 用户卡片 ===== */
.user-row {
	display: flex;
	align-items: center;
}

.user-card .avatar {
	width: 80rpx;
	height: 80rpx;
	border-radius: 50%;
	background: #eef0f4;
	flex-shrink: 0;
	margin-right: 18rpx;
}

.user-card .user-meta {
	flex: 1;
	min-width: 0;
	overflow: hidden;
}

.user-card .nick {
	font-size: 30rpx;
	font-weight: 600;
	color: #1f2a44;
	line-height: 42rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.user-card .sub {
	margin-top: 4rpx;
	font-size: 24rpx;
	color: #94a3b8;
	line-height: 34rpx;
}

/* ===== 提示卡片 ===== */
.tip-card {
	background: linear-gradient(180deg, #f1f6ff 0%, #ffffff 100%);
}

.tip-title {
	font-size: 28rpx;
	font-weight: 600;
	color: #397bc8;
	line-height: 40rpx;
	margin-bottom: 12rpx;
}

.tip-line {
	font-size: 24rpx;
	line-height: 40rpx;
	color: #51607a;
}

/* ===== 底部操作栏 ===== */
.footer-bar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 30;
	display: flex;
	align-items: center;
	box-sizing: border-box;
	padding: 18rpx 24rpx;
	background: rgba(255, 255, 255, .98);
	box-shadow: 0 -6rpx 20rpx rgba(55, 83, 119, .1);
}

.footer-bar button {
	flex: 1 1 0;
	min-width: 0;
	margin: 0;
	padding: 0;
	border-radius: 36rpx;
	font-size: 30rpx;
	font-weight: 600;
	line-height: 1;
	box-sizing: border-box;
}

.footer-bar button::after {
	border: 0;
}

.footer-bar .btn-ghost {
	height: 80rpx;
	line-height: 80rpx;
	background: #f1f4f8;
	color: #51607a;
	border: 0;
	font-weight: 500;
	padding: 0 28rpx;
	margin-right: 14rpx;
}

.footer-bar .btn-ghost[disabled] {
	color: #aeb3ba;
	background: #f4f6f9;
}

.footer-bar .btn-primary {
	flex: 1;
	height: 80rpx;
	line-height: 80rpx;
	background: linear-gradient(90deg, #5C9BEA 0%, #397BC8 100%);
	color: #fff;
	border: 0;
	box-shadow: 0 6rpx 16rpx rgba(57, 123, 200, .35);
}

.footer-secondary {
	justify-content: center;
}

.footer-tip {
	flex: 1;
	text-align: center;
	font-size: 26rpx;
	color: #94a3b8;
	line-height: 80rpx;
}

/* 小屏适配 */
@media (max-width: 360px) {
	.status-bar-title {
		font-size: 32rpx;
	}

	.money-left .num {
		font-size: 48rpx;
	}

	.code-text {
		font-size: 32rpx;
	}

	.info-row .lbl {
		width: 100rpx;
	}

	.footer-bar .btn-ghost {
		padding: 0 14rpx;
		font-size: 25rpx;
	}

	.footer-bar .btn-primary {
		font-size: 26rpx;
	}
}

<import src="../tpl/mail_detail_tpl.wxml"/>
<view class="delivery-page {{detailUI.receipt.visible ? 'with-receipt-footer' : ''}}">
 <view wx:if="{{loading && !mail}}" class="od-state"><view class="od-state-icon"><text class="icon-time"></text></view><view class="od-state-title">正在获取订单</view><view class="od-state-note">为你整理本次代取的最新进展</view></view>
 <view wx:if="{{error}}" class="od-state"><view class="od-state-icon"><text class="icon-info"></text></view><view class="od-state-title">{{notFound ? '订单暂不可用' : '暂时无法加载'}}</view><view class="od-state-note">{{errorMessage}}</view><button wx:if="{{id}}" class="od-primary" bindtap="load" disabled="{{loading}}" loading="{{loading}}">重新加载</button><view class="od-state-link" bindtap="bindBackOrders">返回订单列表</view></view>
 <block wx:if="{{mail}}">
  <template is="mailDetailContent" data="{{mail: mail, ui: detailUI, actionDisabled: busy || loading || error}}"/>
  <view wx:if="{{configError}}" class="od-config-note">提醒配置暂不可用，不影响查看订单；下拉可重试。</view>
  <view class="od-footer od-footer-stack">
   <view wx:if="{{detailUI.receipt.visible}}" class="od-receipt-hint">{{detailUI.receipt.hint}}</view>
   <view class="od-footer-actions">
    <button class="od-footer-tool" bindtap="bindServiceHelpTap"><text class="icon-service"></text><text>客服</text></button>
    <button wx:if="{{detailUI.participant}}" class="od-footer-tool" bindtap="bindMoreTap" disabled="{{busy || loading || error}}"><text class="icon-more"></text><text>更多</text></button>
    <button wx:if="{{!detailUI.receipt.visible || detailUI.primary !== 'confirm'}}" class="od-primary {{detailUI.receipt.visible ? 'od-secondary' : ''}}" bindtap="bindPrimaryAction" disabled="{{busy || loading || error}}" loading="{{busy}}">{{detailUI.primaryLabel}}</button>
    <button wx:if="{{detailUI.receipt.visible}}" class="od-primary" bindtap="bindReceiptTap" disabled="{{busy || loading || error}}" loading="{{busy}}">确认收货</button>
   </view>
  </view>
 </block>
 <view wx:if="{{confirmGate}}" class="od-sheet-mask confirm-gate-mask" catchtouchmove="bindStopProp"><view class="confirm-gate" catchtap="bindStopProp"><view class="confirm-gate-icon">?</view><view class="confirm-gate-title">请仔细核对后确认收货</view><view class="confirm-gate-copy">确认后订单会自动从双方的日常订单列表中移除，请确认包裹、数量和外观均无误。</view><view class="confirm-gate-count" wx:if="{{confirmCountdown > 0}}">请阅读 {{confirmCountdown}} 秒</view><view class="confirm-gate-count ready" wx:else>已阅读完毕，可以确认</view><view class="confirm-gate-actions"><button class="od-footer-tool" bindtap="bindGateCancel">再看一看</button><button class="od-primary" bindtap="bindGateConfirm" disabled="{{confirmCountdown > 0 || busy}}">确认收货</button></view></view></view>
 <view wx:if="{{panel}}" class="od-sheet-mask" catchtouchmove="bindStopProp" bindtap="bindClosePanel">
  <view class="od-sheet" catchtap="bindStopProp">
   <view class="od-sheet-handle"></view>
   <view class="od-heading"><text class="od-sheet-title">{{panel === 'update_proof' ? '更新送达凭证' : panel === 'deliver' ? '提交送达凭证' : '反馈配送异常'}}</text><button class="od-close" bindtap="bindClosePanel" disabled="{{busy}}"><text class="icon-close"></text></button></view>
   <scroll-view scroll-y class="od-sheet-body">
    <view class="od-sheet-note">{{panel === 'update_proof' ? '可修改送达说明，删除传错的照片后重新添加。至少保留1张照片，更新后请等待发布者确认收货。' : panel === 'deliver' ? '拍摄物品与放置位置，方便发布者核对。提交后等待对方确认收货。' : '请说明遇到的问题，提交后由后台跟进。申请取消不代表订单立即取消。'}}</view>
    <picker wx:if="{{panel === 'exception'}}" range="{{reasons}}" value="{{reasonIndex}}" bindchange="bindReason" disabled="{{busy}}"><view class="od-reason"><text>问题类型</text><text>{{reasons[reasonIndex]}} <text class="icon-unfold"></text></text></view></picker>
    <textarea class="od-textarea" placeholder="{{panel === 'exception' ? '请描述具体问题及希望如何处理（必填）' : '请填写送达位置与物品情况（必填）'}}" value="{{note}}" bindinput="bindNote" maxlength="{{panel === 'exception' ? 500 : 300}}" disabled="{{busy}}"/>
    <view class="od-upload-heading"><text>{{panel === 'exception' ? '补充照片（选填）' : '送达照片（至少1张）'}}</text><text>{{images.length}} / 6</text></view>
    <view class="od-upload-grid">
     <view wx:for="{{images}}" wx:key="*this" class="od-upload-item"><image wx:if="{{imagePreviews[item] !== ''}}" src="{{imagePreviews[item] || item}}" class="od-upload-photo" mode="aspectFill"/><view wx:else class="od-upload-unavailable">照片暂不可用</view><button class="od-upload-remove" data-index="{{index}}" catchtap="bindRemoveImage" disabled="{{busy}}"><text class="icon-close"></text></button></view>
     <button wx:if="{{images.length < 6}}" class="od-upload-add" bindtap="bindImages" disabled="{{busy}}"><text class="icon-camera"></text><text>添加照片</text></button>
    </view>
   </scroll-view>
   <button class="od-primary od-sheet-submit" bindtap="bindSubmitPanel" loading="{{busy}}" disabled="{{busy || loading || error}}">{{panel === 'update_proof' ? '保存更新' : panel === 'deliver' ? '提交，通知发布者' : '提交异常说明'}}</button>
  </view>
 </view>
</view>

<!-- 加载中 -->
<view wx:if="{{isLoad===null}}" class="mail-loading load loading text-l text-grey"></view>

<!-- 不存在 -->
<view wx:if="{{isLoad==='notexist'}}" class="margin-top load notexist text-l text-grey">订单不存在或已删除</view>

<!-- 加载失败 -->
<view wx:if="{{isLoad===false}}" class="margin-top load loading text-l text-grey">加载失败，下拉重试</view>

<!-- 主体 -->
<block wx:if="{{isLoad && mail}}">
	<view class="mail-detail-page">

		<!-- 顶部状态条 -->
		<view class="status-bar status-{{mail.MAIL_STATUS}}">
			<view class="status-bar-main">
				<text class="status-bar-title">{{mail.statusDesc || '待接单'}}</text>
				<text class="status-bar-sub" wx:if="{{role==='poster'}}">您是发布者</text>
				<text class="status-bar-sub" wx:elif="{{role==='acceptor'}}">您是接单人</text>
				<text class="status-bar-sub" wx:else>订单详情</text>
			</view>
			<text wx:if="{{mail.urgent}}" class="urgent-pill">加急</text>
		</view>

		<!-- 进度条 -->
		<view class="card progress-card">
			<view class="progress-line">
				<view class="progress-dot {{mail.MAIL_STATUS>=0?'on':''}}"><text class="dot-num">1</text></view>
				<view class="progress-bar {{mail.MAIL_STATUS>=1?'on':''}}"></view>
				<view class="progress-dot {{mail.MAIL_STATUS>=1?'on':''}}"><text class="dot-num">2</text></view>
				<view class="progress-bar {{mail.MAIL_STATUS>=9?'on':''}}"></view>
				<view class="progress-dot {{mail.MAIL_STATUS>=9?'on':''}}"><text class="dot-num">3</text></view>
			</view>
			<view class="progress-label">
				<text class="{{mail.MAIL_STATUS>=0?'on':''}}">已发布</text>
				<text class="{{mail.MAIL_STATUS>=1?'on':''}}">已接单</text>
				<text class="{{mail.MAIL_STATUS>=9?'on':''}}">已完成</text>
			</view>
		</view>

		<!-- 卡片1：金额 -->
		<view class="card money-card">
			<view class="money-left">
				<text class="symbol">¥</text>
				<text class="num">{{mail.price}}</text>
				<text class="tip">含打赏</text>
			</view>
			<view class="money-right">
				<view class="kv"><text class="k">分类</text><text class="v">{{mail.MAIL_CATE_NAME || '快递代取'}}</text></view>
				<view class="kv"><text class="k">订单号</text><text class="v">{{mail.MAIL_ID || '—'}}</text></view>
			</view>
		</view>

		<!-- 卡片2：快递信息 -->
		<view class="card info-card">
			<view class="card-heading">快递信息</view>

			<view wx:if="{{mail.code && (role==='acceptor' || mail.MAIL_STATUS>=9)}}" class="info-row code-row">
				<text class="lbl">取件码</text>
				<view class="val-wrap">
					<text class="code-text">{{mail.code}}</text>
					<view class="copy-btn" bindtap="bindCopyCodeTap">复制</view>
				</view>
			</view>

			<view wx:if="{{mail.imgUrls && mail.imgUrls.length}}" class="info-row image-row">
				<text class="lbl">取件截图</text>
				<view class="proof-list">
					<image wx:for="{{mail.imgUrls}}" wx:key="*this" class="proof-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="bindPreviewImageTap"></image>
				</view>
			</view>

			<view class="info-row">
				<text class="lbl">快递点</text>
				<text class="val">{{mail.address1 || '—'}}</text>
			</view>
			<view class="info-row">
				<text class="lbl">送达地址</text>
				<text class="val">{{mail.address2 || '—'}}</text>
			</view>
			<view wx:if="{{mail.rider}}" class="info-row">
				<text class="lbl">指定骑手</text>
				<text class="val">{{mail.rider}}</text>
			</view>
			<view class="info-row">
				<text class="lbl">类型</text>
				<view class="val tag-list">
					<text wx:if="{{mail.small}}" class="tag tag-blue">小件×{{mail.small}}</text>
					<text wx:if="{{mail.medium}}" class="tag tag-orange">中件×{{mail.medium}}</text>
					<text wx:if="{{mail.large}}" class="tag tag-red">大件×{{mail.large}}</text>
				</view>
			</view>
			<view wx:if="{{mail.desc}}" class="info-row">
				<text class="lbl">备注</text>
				<text class="val multi">{{mail.desc}}</text>
			</view>
			<view class="info-row">
				<text class="lbl">截止时间</text>
				<text class="val">{{mail.MAIL_END_TIME || '—'}}</text>
			</view>
			<view class="info-row">
				<text class="lbl">发布时间</text>
				<text class="val">{{mail.MAIL_ADD_TIME || '—'}}</text>
			</view>
			<view wx:if="{{mail.MAIL_ACCEPT_TIME && mail.MAIL_ACCEPT_TIME !== '1970-01-01 08:00'}}" class="info-row">
				<text class="lbl">接单时间</text>
				<text class="val">{{mail.MAIL_ACCEPT_TIME}}</text>
			</view>
			<view wx:if="{{mail.MAIL_OVER_TIME && mail.MAIL_OVER_TIME !== '1970-01-01 08:00' && mail.MAIL_STATUS===9}}" class="info-row">
				<text class="lbl">完成时间</text>
				<text class="val">{{mail.MAIL_OVER_TIME}}</text>
			</view>
		</view>

		<!-- 卡片3：发单人 / 接单人 -->
		<view class="card user-card">
			<view class="card-heading">发单人</view>
			<view class="user-row">
				<image class="avatar" src="{{mail.posterPic || '/projects/crun/images/menu/mail.png'}}" mode="aspectFill"></image>
				<view class="user-meta">
					<view class="nick">{{mail.poster}}</view>
					<view class="sub">{{mail.tel || ''}}</view>
				</view>
			</view>
		</view>

		<view wx:if="{{mail.MAIL_STATUS > 0 && mail.acceptUser}}" class="card user-card">
			<view class="card-heading">接单人</view>
			<view class="user-row">
				<image class="avatar" src="/projects/crun/images/menu/mail.png" mode="aspectFill"></image>
				<view class="user-meta">
					<view class="nick">{{mail.acceptUser.USER_NAME || '匿名骑手'}}</view>
					<view class="sub">{{mail.acceptUser.USER_MOBILE || ''}}</view>
				</view>
			</view>
		</view>

		<!-- 卡片5：温馨提示 -->
		<view class="card tip-card">
			<view class="tip-title">温馨提示</view>
			<view wx:if="{{role==='poster'}}" class="tip-line">· 接单后请保持电话畅通，方便骑手联系</view>
			<view wx:if="{{role==='poster'}}" class="tip-line">· 收到快递后请及时在订单中确认完成</view>
			<view wx:if="{{role==='acceptor'}}" class="tip-line">· 请尽快取件并送达，保持电话畅通</view>
			<view wx:if="{{role==='acceptor'}}" class="tip-line">· 送达后请在订单中点击「标记完成」</view>
			<view class="tip-line">· 任何问题可在「我的-客服」中反馈</view>
		</view>

		<view style="height: 160rpx;"></view>

		<!-- ===== 底部操作栏 ===== -->
		<!-- 发布者：待接单 = 编辑+取消；接单中 = 取消；已完成 = 无操作 -->
		<block wx:if="{{role==='poster'}}">
			<block wx:if="{{mail.MAIL_STATUS===0}}">
				<view class="footer-bar safe-bottom">
					<button class="btn-ghost" bindtap="bindCancelTap">取消订单</button>
					<button class="btn-ghost" bindtap="bindEditTap">编辑订单</button>
					<button wx:if="{{mail.canPay}}" class="btn-primary" bindtap="bindPayTap">去支付</button>
				</view>
			</block>
			<block wx:elif="{{mail.MAIL_STATUS===1}}">
				<view class="footer-bar safe-bottom">
					<button class="btn-ghost" bindtap="bindCallTap" wx:if="{{mail.acceptUser && mail.acceptUser.USER_MOBILE}}">联系骑手</button>
					<button class="btn-primary" bindtap="bindFinishTap">确认完成</button>
				</view>
			</block>
			<block wx:else>
				<view class="footer-bar safe-bottom footer-secondary">
					<view class="footer-tip">该订单已结束</view>
				</view>
			</block>
		</block>

		<!-- 接单人：接单中 = 联系发单+取消+标记完成 -->
		<block wx:elif="{{role==='acceptor'}}">
			<block wx:if="{{mail.MAIL_STATUS===1}}">
				<view class="footer-bar safe-bottom">
					<button class="btn-ghost" bindtap="bindCallTap" wx:if="{{mail.tel}}">联系发单</button>
					<button class="btn-ghost" bindtap="bindCancelTap">取消接单</button>
					<button class="btn-primary" bindtap="bindFinishTap">标记完成</button>
				</view>
			</block>
			<block wx:else>
				<view class="footer-bar safe-bottom footer-secondary">
					<view class="footer-tip">该订单已结束</view>
				</view>
			</block>
		</block>

		<!-- 路人查看 -->
		<block wx:else>
			<view class="footer-bar safe-bottom footer-secondary">
				<view class="footer-tip">您不是该订单的发布者或接单人</view>
			</view>
		</block>

	</view>
</block>

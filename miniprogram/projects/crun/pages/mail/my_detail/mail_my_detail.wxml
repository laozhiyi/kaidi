<import src="../tpl/mail_detail_tpl.wxml"/>
<view class="delivery-page">
 <view wx:if="{{loading && !mail}}" class="od-state"><view class="od-state-icon"><text class="icon-time"></text></view><view class="od-state-title">正在获取订单</view><view class="od-state-note">为你整理本次代取的最新进展</view></view>
 <view wx:if="{{error}}" class="od-state"><view class="od-state-icon"><text class="icon-info"></text></view><view class="od-state-title">{{notFound ? '订单暂不可用' : '暂时无法加载'}}</view><view class="od-state-note">{{errorMessage}}</view><button wx:if="{{id}}" class="od-primary" bindtap="load" disabled="{{loading}}" loading="{{loading}}">重新加载</button><view class="od-state-link" bindtap="bindBackOrders">返回订单列表</view></view>
 <block wx:if="{{mail}}">
  <template is="mailDetailContent" data="{{mail: mail, ui: detailUI}}"/>
  <view wx:if="{{configError}}" class="od-config-note">提醒配置暂不可用，不影响查看订单；下拉可重试。</view>
  <view class="od-footer"><button class="od-footer-tool" bindtap="bindServiceHelpTap"><text class="icon-service"></text><text>客服</text></button><button wx:if="{{detailUI.participant}}" class="od-footer-tool" bindtap="bindMoreTap" disabled="{{busy || loading || error}}"><text class="icon-more"></text><text>更多</text></button><button class="od-primary" bindtap="bindPrimaryAction" disabled="{{busy || loading || error}}" loading="{{busy}}">{{detailUI.primaryLabel}}</button></view>
 </block>
 <view wx:if="{{panel}}" class="od-sheet-mask" catchtouchmove="bindStopProp" bindtap="bindClosePanel"><view class="od-sheet" catchtap="bindStopProp"><view class="od-sheet-handle"></view><view class="od-heading"><text class="od-sheet-title">{{panel === 'deliver' ? '提交送达凭证' : '反馈配送异常'}}</text><button class="od-close" bindtap="bindClosePanel" disabled="{{busy}}"><text class="icon-close"></text></button></view><scroll-view scroll-y class="od-sheet-body"><view class="od-sheet-note">{{panel === 'deliver' ? '拍摄物品与放置位置，方便发布者核对。提交后等待对方确认收货。' : '请说明遇到的问题，提交后由后台跟进。申请取消不代表订单立即取消。'}}</view><picker wx:if="{{panel === 'exception'}}" range="{{reasons}}" value="{{reasonIndex}}" bindchange="bindReason" disabled="{{busy}}"><view class="od-reason"><text>问题类型</text><text>{{reasons[reasonIndex]}} <text class="icon-unfold"></text></text></view></picker><textarea class="od-textarea" placeholder="{{panel === 'deliver' ? '请填写送达位置与物品情况（必填）' : '请描述具体问题及希望如何处理（必填）'}}" value="{{note}}" bindinput="bindNote" maxlength="{{panel === 'deliver' ? 300 : 500}}" disabled="{{busy}}"/><view class="od-upload-heading"><text>{{panel === 'deliver' ? '送达照片（至少1张）' : '补充照片（选填）'}}</text><text>{{images.length}} / 6</text></view><view class="od-upload-grid"><view wx:for="{{images}}" wx:key="*this" class="od-upload-item"><image src="{{item}}" class="od-upload-photo" mode="aspectFill"/><button class="od-upload-remove" data-index="{{index}}" catchtap="bindRemoveImage" disabled="{{busy}}"><text class="icon-close"></text></button></view><button wx:if="{{images.length < 6}}" class="od-upload-add" bindtap="bindImages" disabled="{{busy}}"><text class="icon-camera"></text><text>添加照片</text></button></view></scroll-view><button class="od-primary od-sheet-submit" bindtap="bindSubmitPanel" loading="{{busy}}" disabled="{{busy || loading || error}}">{{panel === 'deliver' ? '提交，通知发布者' : '提交异常说明'}}</button></view></view>
</view>

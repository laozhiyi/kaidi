<template name="mailDetailContent">
 <view class="od-hero od-tone-{{ui.tone}}">
  <view class="od-hero-top"><text class="od-eyebrow">校园代取 · {{ui.role}}</text><text wx:if="{{mail.MAIL_OBJ.urgent}}" class="od-urgent">加急</text></view>
  <view class="od-status-row"><view class="od-status-copy"><view class="od-status-title">{{ui.title}}</view><view class="od-status-note">{{ui.note}}</view></view><view class="od-status-icon"><text class="icon-{{ui.icon}}"></text></view></view>
  <view wx:if="{{ui.step >= 0}}" class="od-progress"><view wx:for="{{ui.steps}}" wx:key="index" class="od-step {{item.done ? 'od-step-done' : ''}} {{item.current ? 'od-step-current' : ''}}"><view class="od-step-track"><view class="od-step-dot"><text wx:if="{{item.done}}" class="icon-check"></text></view></view><text class="od-step-label">{{item.label}}</text></view></view>
 </view>
 <view class="od-content">
  <view wx:if="{{mail.overdue}}" class="od-alert"><text class="icon-info"></text><text>已超过预计送达时间，请联系对方或通过“更多”提交异常。</text></view>
  <view class="od-card">
   <view class="od-summary"><view class="od-summary-copy"><view class="od-section-title">{{mail.MAIL_OBJ.title || '快递代取'}}</view><view class="od-campus"><text class="icon-location"></text>{{mail.MAIL_OBJ.campus || '校区待确认'}}</view><view class="od-tags"><text wx:for="{{ui.packages}}" wx:key="key" class="od-tag">{{item.label}} × {{item.count}}</text><text wx:if="{{!ui.packages.length}}" class="od-tag">共 {{ui.count}} 件</text></view></view><view class="od-fee"><view class="od-fee-label">{{ui.legacyPayment ? '订单金额' : '代取费用'}}</view><view class="od-price"><text>¥</text>{{ui.fee}}</view><text class="od-fee-badge">{{ui.legacyPayment ? '结算待核对' : '双方线下结算'}}</text></view></view>
   <view class="od-divider"></view>
   <view class="od-route"><view class="od-route-stop"><view class="od-route-marker od-pickup">取</view><view class="od-route-copy"><view class="od-label">取件地点</view><view class="od-address">{{mail.MAIL_OBJ.address1 || '取件地点待补充'}}</view></view></view><view class="od-route-stop"><view class="od-route-marker od-dropoff">送</view><view class="od-route-copy"><view class="od-label">送达地点</view><view class="od-address {{!ui.participant ? 'od-private-address' : ''}}">{{ui.participant ? (mail.MAIL_OBJ.address2 || '请联系发布者确认') : '接单后可查看详细地址'}}</view><view wx:if="{{!ui.participant}}" class="od-caption"><text class="icon-lock"></text> 为保护隐私，联系人与取件信息暂不公开</view></view></view></view>
  </view>

  <view wx:if="{{ui.participant}}" class="od-card od-contact"><view class="od-contact-avatar"><text class="icon-{{mail.mypost ? 'deliver' : 'people'}}"></text></view><view class="od-contact-copy"><view class="od-label">{{ui.contactRole}}</view><view class="od-contact-name">{{ui.contactName}}</view><view class="od-caption">{{ui.phone || (ui.status === 0 ? '接单后可电话联系' : '暂无联系电话')}}</view></view><button wx:if="{{ui.phone}}" class="od-call" bindtap="bindCallTap"><text class="icon-phone"></text> 联系</button></view>

  <view wx:if="{{ui.participant}}" class="od-card">
   <view class="od-heading"><text class="od-section-title">取件凭证</text><text class="od-private-badge"><text class="icon-lock"></text> 仅订单双方可见</text></view>
   <view wx:if="{{mail.MAIL_OBJ.code}}" class="od-code-box"><view class="od-code-copy"><view class="od-label">取件码 / 取件信息</view><text selectable class="od-code">{{mail.MAIL_OBJ.code}}</text></view><button class="od-copy" bindtap="bindCopyCodeTap">复制</button></view>
   <view wx:if="{{mail.MAIL_MEDIA.pickup.length}}" class="od-media"><image wx:for="{{mail.MAIL_MEDIA.pickup}}" wx:key="*this" class="od-photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" data-group="pickup" bindtap="bindPreviewImageTap"/></view>
   <view wx:if="{{!mail.MAIL_OBJ.code && !mail.MAIL_MEDIA.pickup.length}}" class="od-empty-note">{{mail.MAIL_MEDIA_ERROR ? '取件图片暂不可用，请刷新或联系发布者' : '暂无取件凭证，请联系发布者确认'}}</view>
   <view wx:if="{{mail.MAIL_MEDIA_ERROR}}" class="od-media-error" bindtap="bindReload"><text class="icon-info"></text><text>{{mail.MAIL_MEDIA_ERROR}}</text><text class="od-text-link">刷新</text></view>
   <view wx:if="{{mail.MAIL_OBJ.desc || mail.MAIL_OBJ.rider}}" class="od-note"><view class="od-label">配送备注</view><view wx:if="{{mail.MAIL_OBJ.desc}}">{{mail.MAIL_OBJ.desc}}</view><view wx:if="{{mail.MAIL_OBJ.rider}}" class="od-rider-note">骑手备注：{{mail.MAIL_OBJ.rider}}<text class="od-caption">（非指定派单）</text></view></view>
  </view>

  <view wx:if="{{ui.participant && mail.MAIL_DELIVERY_PROOF}}" class="od-card"><view class="od-heading"><text class="od-section-title">送达凭证</text><text class="od-badge-green">骑手已提交</text></view><view class="od-body-text">{{mail.MAIL_DELIVERY_PROOF.note || '请核对物品是否已送达'}}</view><view class="od-media"><image wx:for="{{mail.MAIL_MEDIA.proof}}" wx:key="*this" class="od-photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" data-group="proof" bindtap="bindPreviewImageTap"/></view><view wx:if="{{ui.deliveredAt}}" class="od-caption od-space-top">提交时间 {{ui.deliveredAt}}</view></view>
  <view wx:if="{{ui.participant && mail.MAIL_EXCEPTION}}" class="od-card"><view class="od-heading"><text class="od-section-title">异常说明</text><text class="od-badge-amber">{{ui.status === 3 ? '处理中' : '已记录'}}</text></view><view class="od-exception-reason">{{mail.MAIL_EXCEPTION.reason}}</view><view class="od-body-text">{{mail.MAIL_EXCEPTION.note}}</view><view class="od-media"><image wx:for="{{mail.MAIL_MEDIA.exception}}" wx:key="*this" class="od-photo" src="{{item}}" mode="aspectFill" data-url="{{item}}" data-group="exception" bindtap="bindPreviewImageTap"/></view></view>

  <view class="od-card"><view class="od-section-title">订单信息</view><view class="od-meta"><view class="od-meta-row"><text class="od-meta-label">订单编号</text><view class="od-meta-value od-order-number"><text selectable>{{mail.MAIL_ID || mail._id}}</text><text class="od-text-link" bindtap="bindCopyOrderTap">复制</text></view></view><view class="od-meta-row"><text class="od-meta-label">发布时间</text><text class="od-meta-value">{{ui.createdAt || '时间待确认'}}</text></view><view wx:if="{{ui.endAt}}" class="od-meta-row"><text class="od-meta-label">接单截止</text><text class="od-meta-value">{{ui.endAt}}</text></view><view wx:if="{{ui.dueAt}}" class="od-meta-row"><text class="od-meta-label">预计送达</text><text class="od-meta-value">{{ui.dueAt}}</text></view></view><view class="od-settlement" bindtap="bindNoticeTap"><text class="icon-info"></text><text>{{ui.legacyPayment ? '结算方式待确认，请联系客服核对款项' : '线下协商结算 · 请勿提前向陌生人转账'}}</text><text class="icon-right"></text></view></view>

  <view wx:if="{{ui.history.length}}" class="od-card"><view class="od-section-title">订单动态</view><view class="od-timeline"><view wx:for="{{ui.history}}" wx:key="id" class="od-event"><view class="od-event-dot"></view><view class="od-event-copy"><view class="od-event-title">{{item.title}}</view><view wx:if="{{item.note}}" class="od-event-note">{{item.note}}</view><view class="od-caption">{{item.time}} · {{item.actor}}</view></view></view></view></view>
  <view class="od-end-note"><text class="icon-service"></text> 取送有问题？<text bindtap="bindServiceHelpTap">联系校区客服</text></view>
 </view>
</template>

<view class="page">

	<!-- 顶部 banner -->
	<view class="banner">
		<view class="banner-title">邀请好友</view>
		<view class="banner-sub">把便捷的校园生活分享给好友，一起得积分</view>

		<!-- 统计卡片 -->
		<view class="stat-grid">
			<view class="stat-cell">
				<view class="stat-num">{{stat.total}}</view>
				<view class="stat-label">已邀请</view>
			</view>
			<view class="stat-divider"></view>
			<view class="stat-cell">
				<view class="stat-num">{{stat.used}}</view>
				<view class="stat-label">已使用</view>
			</view>
			<view class="stat-divider"></view>
			<view class="stat-cell">
				<view class="stat-num">{{stat.pending}}</view>
				<view class="stat-label">待审核</view>
			</view>
		</view>
	</view>

	<!-- 邀请码卡片 -->
	<view class="card code-card">
		<view class="code-title">我的专属邀请码</view>
		<view class="code-value">{{code || (loading ? '加载中…' : '暂未获取')}}</view>
		<view class="code-tip">好友从分享链接进入，或注册时填写邀请码，即可记录邀请关系</view>

		<view class="code-btn-row">
			<button class="btn btn-default" bindtap="bindCopyCode" disabled="{{!code}}">复制邀请码</button>
			<button class="btn btn-primary" open-type="share" disabled="{{!code}}">立即邀请</button>
		</view>
	</view>

	<!-- 专属小程序码 -->
	<view class="card qr-card">
		<view class="code-title">专属小程序码</view>
		<view class="qr-body">
			<image wx:if="{{qr}}" class="qr-image" src="{{qr}}" mode="aspectFit" show-menu-by-longpress="{{true}}" />
			<view wx:elif="{{qrLoading}}" class="qr-placeholder">正在生成…</view>
			<view wx:else class="qr-placeholder">{{qrError || '暂不可用'}}</view>
		</view>
		<view class="code-tip">保存后发到群聊、朋友圈或打印张贴，好友扫码自动带上你的邀请码</view>
		<view class="code-btn-row">
			<button class="btn btn-default" bindtap="bindSaveQr" disabled="{{!qr || qrLoading}}">保存到相册</button>
		</view>
	</view>

	<!-- 积分规则 -->
	<view class="card points-card">
		<view class="points-title">积分规则</view>
		<view class="points-rule"><text class="points-dot"></text><text>好友完成首单，你和好友各得 300 积分</text></view>
		<view class="points-rule"><text class="points-dot"></text><text>每次发单完成收货，自己得 100 积分</text></view>
		<view class="points-rule"><text class="points-dot"></text><text>好友注册后下单即算「已使用」，完成首单后到账</text></view>
		<view class="points-rule"><text class="points-dot"></text><text>积分可在「积分商城」兑换免费打印券等商品</text></view>
	</view>

	<!-- 邀请记录 -->
	<view wx:if="{{error}}" class="card invite-state"><view>{{error}}</view><button class="btn btn-default invite-retry" bindtap="_loadAll">重新加载</button></view>
	<view wx:if="{{loading}}" class="invite-state">正在加载邀请信息…</view>
	<view class="card list-card">
		<view class="list-title">
			<text>邀请记录</text>
			<text class="list-count">共 {{stat.total}} 条</text>
		</view>

		<view wx:if="{{isLoad && !loading && !error && list.length==0}}" class="empty">
			<view class="empty-text">还没有邀请记录，快去分享给好友吧</view>
		</view>

		<view wx:for="{{list}}" wx:key="_id" class="list-item">
			<view class="list-avatar">友</view>
			<view class="list-info">
				<view class="list-name">{{item.INV_ACCEPT_USER_NAME || '待注册用户'}}</view>
				<view class="list-time">{{item.INV_ADD_TIME}}</view>
			</view>
			<view class="status status-{{item.state}}">{{item.stateText}}</view>
		</view>
	</view>

	<button wx:if="{{hasMore}}" class="btn btn-default invite-more" bindtap="bindMore" disabled="{{loading}}" loading="{{loading}}">加载更多邀请记录</button>
	<view class="rules">
		<view class="rules-title">活动规则</view>
		<view class="rules-item">1. 分享邀请码或小程序给好友</view>
		<view class="rules-item">2. 好友通过你分享的链接进入并完成注册</view>
		<view class="rules-item">3. 好友完成首单后，你和好友各获得 300 积分</view>
		<view class="rules-item">4. 每次发单完成收货，可获得 100 积分</view>
		<view class="rules-item">5. 每位好友仅记录一次邀请关系，同一单只发一次积分</view>
	</view>

</view>

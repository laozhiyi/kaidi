@import "../../../style/skin.wxss";

.page {
	min-height: 100vh;
	background-color: #f1f6ff;
	padding: 0 25rpx 60rpx;
	box-sizing: border-box;
}

/* banner */
.banner {
	background: linear-gradient(135deg, #4a8fe0 0%, #397bc8 50%, #2f69b3 100%);
	padding: 50rpx 40rpx 90rpx;
	color: #fff;
	border-bottom-left-radius: 30rpx;
	border-bottom-right-radius: 30rpx;
	margin: 0 -25rpx 25rpx;
	position: relative;
}

.banner-title {
	font-size: 44rpx;
	font-weight: bold;
	margin-bottom: 8rpx;
	word-break: break-word;
}

.banner-sub {
	font-size: 26rpx;
	opacity: 0.85;
	margin-bottom: 30rpx;
	letter-spacing: 4rpx;
	word-break: break-word;
}

.stat-grid {
	background-color: rgba(255, 255, 255, 0.15);
	border-radius: 20rpx;
	padding: 30rpx 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	backdrop-filter: blur(10rpx);
}

.stat-cell {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
}

.stat-num {
	font-size: 48rpx;
	font-weight: bold;
	color: #fff;
	line-height: 1.15;
	word-break: break-all;
}

.stat-label {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.85);
	margin-top: 8rpx;
	white-space: nowrap;
}

.stat-divider {
	width: 2rpx;
	height: 60rpx;
	background-color: rgba(255, 255, 255, 0.3);
}

/* 卡片 */
.card {
	background-color: #fff;
	border-radius: 24rpx;
	padding: 30rpx;
	margin-bottom: 25rpx;
	box-shadow: 6rpx 6rpx 20rpx rgba(216, 220, 223, 0.5);
}

/* 邀请码 */
.code-card {
	margin-top: -50rpx;
	position: relative;
	z-index: 10;
}

.code-title {
	font-size: 26rpx;
	color: #94a3b8;
	margin-bottom: 12rpx;
}

.code-value {
	font-size: 64rpx;
	font-weight: bold;
	color: #397bc8;
	letter-spacing: 12rpx;
	text-align: center;
	padding: 30rpx 12rpx;
	font-family: 'din', monospace;
	background: linear-gradient(180deg, rgba(57, 123, 200, 0.05), rgba(57, 123, 200, 0.1));
	border-radius: 16rpx;
	margin-bottom: 16rpx;
	line-height: 1.25;
	word-break: break-all;
}

.code-tip {
	font-size: 24rpx;
	color: #94a3b8;
	text-align: center;
	line-height: 36rpx;
	word-break: break-word;
}

.code-btn-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16rpx;
	margin-top: 24rpx;
}

/* 专属小程序码 */
.qr-card {
	display: flex;
	flex-direction: column;
	align-items: center;
}

.qr-body {
	width: 360rpx;
	height: 360rpx;
	margin: 8rpx 0 16rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: #f5f7fa;
	border-radius: 16rpx;
	overflow: hidden;
}

.qr-image {
	width: 340rpx;
	height: 340rpx;
}

.qr-placeholder {
	padding: 0 24rpx;
	font-size: 24rpx;
	color: #94a3b8;
	line-height: 36rpx;
	text-align: center;
}

.qr-card .code-btn-row {
	width: 100%;
}

.btn {
	flex: 1;
	height: 80rpx;
	line-height: 80rpx;
	border-radius: 40rpx;
	text-align: center;
	font-size: 28rpx;
	border: none;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.btn-default {
	background-color: #f1f6ff;
	color: #397bc8;
	border: 2rpx solid #397bc8;
}

.btn-primary {
	background: linear-gradient(135deg, #4a8fe0, #397bc8);
	color: #fff;
}

/* 积分规则 */
.points-title { font-size: 28rpx; font-weight: 600; color: #1f2a44; margin-bottom: 16rpx; }
.points-rule { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 12rpx; color: #7b8ca3; font-size: 23rpx; line-height: 1.7; }
.points-dot { flex-shrink: 0; width: 10rpx; height: 10rpx; margin-top: 13rpx; border-radius: 50%; background: #b6c8de; }

/* 列表 */
.list-card {
	padding-bottom: 10rpx;
}

.list-title {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
	align-items: baseline;
	column-gap: 12rpx;
	font-size: 30rpx;
	font-weight: 600;
	color: #1f2a44;
	margin-bottom: 20rpx;
	padding-bottom: 16rpx;
	border-bottom: 2rpx solid #f1f4fa;
}

.list-count {
	font-size: 24rpx;
	color: #94a3b8;
	font-weight: normal;
	white-space: nowrap;
}

.list-item {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 24rpx 0;
	border-bottom: 2rpx solid #f1f4fa;
}

.list-item:last-child {
	border-bottom: none;
}

.list-avatar {
	width: 72rpx;
	height: 72rpx;
	border-radius: 50%;
	background-color: #f1f6ff;
	color: #397bc8;
	font-size: 32rpx;
	font-weight: bold;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 20rpx;
}

.list-info {
	flex: 1;
	min-width: 0;
}

.list-name {
	font-size: 28rpx;
	color: #1f2a44;
	margin-bottom: 6rpx;
	word-break: break-word;
}

.list-time {
	font-size: 22rpx;
	color: #94a3b8;
	word-break: break-word;
}

.status {
	flex-shrink: 0;
	font-size: 22rpx;
	padding: 6rpx 18rpx;
	border-radius: 20rpx;
	white-space: nowrap;
}

.status-accept,
.status-used {
	color: #2dc87a;
	background-color: rgba(45, 200, 122, 0.1);
}

.status-rewarded {
	color: #397bc8;
	background-color: rgba(57, 123, 200, 0.12);
}

.status-unused {
	color: #7c8ba0;
	background-color: #f1f4fa;
}

.status-pending,
.status-rejected {
	color: #f59e0b;
	background-color: rgba(245, 158, 11, 0.1);
}

.empty {
	padding: 50rpx 0;
	text-align: center;
}

.empty-text {
	color: #94a3b8;
	font-size: 26rpx;
}

/* 规则 */
.rules {
	background-color: #fff;
	border-radius: 24rpx;
	padding: 30rpx;
	box-shadow: 6rpx 6rpx 20rpx rgba(216, 220, 223, 0.5);
}

.rules-title {
	font-size: 28rpx;
	font-weight: 600;
	color: #1f2a44;
	margin-bottom: 16rpx;
}

.rules-item {
	font-size: 24rpx;
	color: #94a3b8;
	line-height: 40rpx;
}
.invite-state { padding:28rpx; color:#8294ab; font-size:26rpx; text-align:center; }
.invite-retry { margin-top:20rpx; }
.invite-more { display:flex; width:100%; margin:0 0 24rpx; }
.code-btn-row button { min-width:0; margin:0; padding:0 18rpx; }
.code-btn-row button[disabled] { opacity:.5; }

/* 窄屏（如 iPhone SE 320 宽）：收字号、缩间距，奖励按钮换行，避免文字挤在一起 */
@media (max-width: 360px) {
	.banner { padding: 40rpx 32rpx 76rpx; }
	.banner-title { font-size: 40rpx; }
	.banner-sub { font-size: 24rpx; letter-spacing: 2rpx; }
	.stat-num { font-size: 42rpx; }
	.stat-label { font-size: 22rpx; }
	.code-value { font-size: 54rpx; letter-spacing: 6rpx; padding: 26rpx 8rpx; }
	.code-tip { font-size: 22rpx; line-height: 34rpx; }
	.points-rule { font-size: 22rpx; }
	.rules-item { font-size: 22rpx; line-height: 38rpx; }
}

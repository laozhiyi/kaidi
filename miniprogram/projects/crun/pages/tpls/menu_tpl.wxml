<template name="menuTpl">
	<view class="tab-bar" >
		<view wx:if="{{returnHome}}" class="tab-bar-home" bindtap="url" data-type="relaunch"
			data-url="/projects/crun/pages/default/index/default_index">
			<text class="tab-bar-home-text icon-homefill text-grey"></text>
		</view>

		<view class="tab-bar-border"></view>
		<view class="tab-bar-item" bindtap="url" data-type="relaunch" data-url="/projects/crun/pages/default/index/default_index">
			<image class="tab-icon" src="/projects/crun/images/tabbar/home{{curMenu=='home_index'?'_cur':''}}.png"></image>
			<view class="tab-text {{curMenu=='home_index'?'menu-project':''}}">首页</view>
		</view>

		<view class="tab-bar-item" bindtap="url" data-type="switch" data-url="/projects/crun/pages/order/index/order_index">
			<image class="tab-icon" src="/projects/crun/images/tabbar/order{{curMenu=='order_index'?'_cur':''}}.png"></image>
			<view class="tab-text {{curMenu=='order_index'?'menu-project':''}}">订单</view>
		</view>

		<view class="tab-bar-item" bindtap="url" data-type="switch" data-url="/projects/crun/pages/my/index/my_index">
			<image class="tab-icon" src="/projects/crun/images/tabbar/my{{curMenu=='my_index'?'_cur':''}}.png"></image>
			<view class="tab-text {{curMenu=='my_index'?'menu-project':''}}">我的</view>
		</view>


	</view>
</template>
@import "../../../style/skin.wxss";

.page {
	width: 100%;
	min-height: 100vh;
	background: #f5f5f5;
	padding: 20rpx 24rpx 220rpx;
	box-sizing: border-box;
}

/* 顶部 */
.header {
	width: 100%;
	background: #fff;
	border-radius: 20rpx;
	padding: 30rpx 30rpx 36rpx;
	box-sizing: border-box;
	position: relative;
	overflow: hidden;
}

.header .status-tag {
	position: absolute;
	top: 0;
	right: 0;
	background: #f2f2f2;
	color: #555;
	font-size: 26rpx;
	padding: 12rpx 24rpx;
	border-bottom-left-radius: 20rpx;
	display: flex;
	align-items: center;
	gap: 6rpx;
}

.header .status-tag.status-wait {
	background: #fff3e0;
	color: #ff8a3d;
}
.header .status-tag.status-going {
	background: #e8f3ff;
	color: #2483ff;
}
.header .status-tag.status-done {
	background: #e7f8ee;
	color: #20b96a;
}
.header .status-tag.status-expire {
	background: #f0f0f0;
	color: #888;
}

.header .title {
	font-size: 36rpx;
	font-weight: bold;
	color: #222;
	line-height: 1.5;
	margin-top: 70rpx;
	word-break: break-all;
}

.header .meta {
	font-size: 24rpx;
	color: #999;
	margin-top: 12rpx;
	display: flex;
	align-items: center;
	gap: 16rpx;
}

.header .meta .cate-name {
	background: #fff7e0;
	color: #c98900;
	padding: 4rpx 14rpx;
	border-radius: 8rpx;
}

.header .meta .time { color: #aaa; }

/* 卡片 */
.card {
	width: 100%;
	background: #fff;
	border-radius: 20rpx;
	margin-top: 20rpx;
	padding: 24rpx 30rpx 30rpx;
	box-sizing: border-box;
}

.card-title {
	display: flex;
	align-items: center;
	font-size: 30rpx;
	font-weight: bold;
	color: #333;
	padding-bottom: 18rpx;
	border-bottom: 2rpx solid #f3f3f3;
	margin-bottom: 18rpx;
}

.card-title .dot {
	width: 8rpx;
	height: 28rpx;
	background: var(--projectColor, #FED202);
	border-radius: 4rpx;
	margin-right: 12rpx;
}

.card-title .card-title-tag {
	margin-left: auto;
	font-size: 22rpx;
	color: #aaa;
	font-weight: normal;
}

/* 单元格 - 两列 */
.row-2col {
	width: 100%;
	display: flex;
	gap: 20rpx;
	padding: 14rpx 0;
	border-bottom: 2rpx dashed #f1f1f1;
}

.row-2col:last-of-type { border-bottom: 0; }

.row-2col .cell {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	justify-content: center;
	gap: 8rpx;
}

.row-2col .cell-label {
	font-size: 24rpx;
	color: #999;
}

.row-2col .cell-value {
	font-size: 28rpx;
	color: #333;
	word-break: break-all;
	line-height: 1.4;
}

.row-2col .cell-value.text-red { color: #ff4d4f; }
.row-2col .cell-value.text-green { color: #20b96a; }
.row-2col .cell-value.text-grey { color: #ccc; }
.row-2col .cell-value.text-link { color: #2483ff; text-decoration: underline; }
.row-2col .cell-value.single-line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 整行 */
.row-full {
	width: 100%;
	padding: 14rpx 0;
	border-bottom: 2rpx dashed #f1f1f1;
}
.row-full:last-child { border-bottom: 0; }

.row-full .cell-label {
	font-size: 24rpx;
	color: #999;
	margin-bottom: 10rpx;
}

.row-full .cell-value {
	font-size: 28rpx;
	color: #333;
	word-break: break-all;
}

/* 收款码 */
.pay-pic-box {
	width: 100%;
	margin-top: 12rpx;
	padding: 20rpx;
	background: #fff8f0;
	border-radius: 12rpx;
	border: 2rpx dashed #ffb87a;
	text-align: center;
	display: inline-block;
}

.pay-pic {
	width: 300rpx;
	height: 450rpx;
	border-radius: 12rpx;
}

.pay-hint {
	font-size: 22rpx;
	color: #ff6600;
	margin-top: 12rpx;
}

/* 完成凭证 */
.card-proof .card-title {
	margin-bottom: 8rpx;
}

.proof-block {
	padding: 16rpx 0;
	border-bottom: 2rpx dashed #f1f1f1;
}
.proof-block:last-child { border-bottom: 0; }

.proof-label {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
	margin-bottom: 16rpx;
}

.proof-label .text-mini {
	font-weight: normal;
	margin-left: 8rpx;
}

.proof-text {
	width: 100%;
	padding: 16rpx 20rpx;
	background: #fafafa;
	border-radius: 12rpx;
	font-size: 28rpx;
	color: #333;
	line-height: 1.5;
	word-break: break-all;
	white-space: pre-wrap;
	box-sizing: border-box;
}

.proof-imgs {
	width: 100%;
	display: flex;
	flex-wrap: wrap;
	gap: 12rpx;
}

.proof-img {
	width: 180rpx;
	height: 180rpx;
	border-radius: 10rpx;
	background: #f0f0f0;
}

.empty-tip {
	padding: 12rpx 0 4rpx;
}

/* textarea */
.text-input {
	width: 100%;
	min-height: 160rpx;
	padding: 20rpx;
	box-sizing: border-box;
	border: 2rpx solid #eee;
	border-radius: 12rpx;
	font-size: 28rpx;
	color: #333;
	background: #fafafa;
}

.char-count {
	width: 100%;
	text-align: right;
	font-size: 22rpx;
	color: #ccc;
	padding-top: 8rpx;
}

/* 底部按钮 */
.btn-fixed {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
	background: #fff;
	box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
	display: flex;
	gap: 20rpx;
	box-sizing: border-box;
	z-index: 99;
}

.btn-fixed.single { justify-content: center; }

.btn-fixed .btn-primary {
	flex: 1;
	height: 88rpx;
	line-height: 88rpx;
	background: var(--projectColor, #FED202);
	color: var(--projectCompareColor, #333);
	border-radius: 44rpx;
	text-align: center;
	font-size: 30rpx;
	font-weight: bold;
}

.btn-fixed .btn-primary.btn-disabled {
	background: #ccc !important;
	color: #fff !important;
}

.btn-fixed .btn-cancel {
	width: 200rpx;
	height: 88rpx;
	line-height: 88rpx;
	background: #f5f5f5;
	color: #666;
	border-radius: 44rpx;
	text-align: center;
	font-size: 28rpx;
}

.btn-fixed .btn-done {
	flex: 1;
	height: 88rpx;
	line-height: 88rpx;
	background: #f0f0f0;
	color: #999;
	border-radius: 44rpx;
	text-align: center;
	font-size: 30rpx;
}

@import "../../../style/skin.wxss";

.page {
	padding: 30rpx 25rpx 60rpx;
	box-sizing: border-box;
	background-color: #f1f6ff;
	min-height: 100vh;
}

/* ===== 顶部 logo 卡片 ===== */
.logo-card {
	background: linear-gradient(135deg, #4a8fe0 0%, #397bc8 50%, #2f69b3 100%);
	border-radius: 30rpx;
	padding: 60rpx 30rpx 40rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	box-shadow: 6rpx 6rpx 20rpx rgba(216, 220, 223, 0.5);
	margin-bottom: 30rpx;
}

.logo-circle {
	width: 150rpx;
	height: 150rpx;
	border-radius: 50%;
	background-color: rgba(255, 255, 255, 0.95);
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.18);
	margin-bottom: 24rpx;
	border: 4rpx solid rgba(255, 255, 255, 0.6);
}

.logo-icon {
	font-size: 70rpx;
	font-weight: bold;
	color: #397bc8;
	line-height: 1;
}

.app-name {
	font-size: 42rpx;
	font-weight: bold;
	color: #ffffff;
	text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
	margin-bottom: 10rpx;
}

.app-slogan {
	font-size: 26rpx;
	color: rgba(255, 255, 255, 0.92);
	letter-spacing: 4rpx;
	margin-bottom: 18rpx;
}

.app-version {
	font-size: 22rpx;
	color: rgba(255, 255, 255, 0.75);
	background-color: rgba(0, 0, 0, 0.12);
	padding: 4rpx 18rpx;
	border-radius: 20rpx;
}

/* ===== 通用卡片 ===== */
.card {
	background-color: #ffffff;
	border-radius: 30rpx;
	padding: 30rpx 30rpx 30rpx;
	margin-bottom: 25rpx;
	box-shadow: 6rpx 6rpx 20rpx rgba(216, 220, 223, 0.5);
}

.card-title {
	font-size: 32rpx;
	font-weight: bold;
	color: #1f2a44;
	position: relative;
	padding-left: 20rpx;
	margin-bottom: 20rpx;
}

.card-title::before {
	content: '';
	position: absolute;
	left: 0;
	top: 8rpx;
	bottom: 8rpx;
	width: 8rpx;
	background-color: #397bc8;
	border-radius: 4rpx;
}

.card-text {
	font-size: 28rpx;
	color: #4a5b7c;
	line-height: 46rpx;
}

/* ===== 功能特性列表 ===== */
.feature-list {
	display: flex;
	flex-direction: column;
	gap: 20rpx;
}

.feature-item {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 20rpx;
}

.feature-tag {
	flex-shrink: 0;
	font-size: 24rpx;
	color: #ffffff;
	background-color: #397bc8;
	padding: 6rpx 18rpx;
	border-radius: 20rpx;
	line-height: 32rpx;
	margin-top: 4rpx;
}

.feature-text {
	flex: 1;
	font-size: 28rpx;
	color: #4a5b7c;
	line-height: 44rpx;
}

/* ===== 联系方式行 ===== */
.contact-row {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 18rpx 0;
	border-bottom: 1rpx solid #f1f4fa;
}

.contact-row:last-child {
	border-bottom: none;
}

.contact-label {
	font-size: 28rpx;
	color: #1f2a44;
}

.contact-value {
	font-size: 28rpx;
	color: #397bc8;
}

/* ===== 版权 ===== */
.copyright {
	text-align: center;
	font-size: 24rpx;
	color: #94a3b8;
	margin-top: 30rpx;
}

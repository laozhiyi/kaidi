@import '../../../style/operations.wxss';
.about-header { text-align: center; padding: 40rpx 28rpx; }
.about-mark { margin: 0 auto 16rpx; width: 100rpx; height: 100rpx; line-height: 100rpx; background: #397bc8; color: #fff; border-radius: 28rpx; font-size: 52rpx; font-weight: 600; }
.about-name { font-size: 38rpx; font-weight: 600; margin-bottom: 12rpx; }
.about-content { margin: 20rpx 0; white-space: pre-wrap; line-height: 1.9; }
.about-image { display: block; width: 100%; margin: 20rpx 0; border-radius: 12rpx; }
<block wx:if="{{isAdmin&&isLoad}}">
	<cmpt-comm-list id="campus-list" isCache="{{false}}" source='admin' type="admin-campus-service-list" search="{{search||''}}" _menus="{{sortMenus}}" route="admin/campus_service_list" sortMenusDefaultIndex="0" topBottom="50" placeholder="搜索校区名称/负责人" bind:list="bindCommListCmpt">

		<view slot="searchEnd">
			<button bindtap="url" data-url="../add/admin_campus_service_add" class="btn radius bg-admin text-white margin-right-s">
				<text class="icon-roundadd margin-right-xxs"></text>添加校区客服
			</button>
		</view>

		<view class="campus-toolbar"><picker range="{{campusOptions}}" value="{{campusIndex}}" bindchange="bindCampusChange"><view>{{campusOptions[campusIndex]}}<text class="icon-unfold margin-left-s"></text></view></picker><view bindtap="url" data-url="../chat_list/admin_campus_chat_list">客服对话与回复</view></view>
		<!-- List Begin -->
		<view class="admin-comm-list">
			<view wx:if="{{dataList && dataList.total }}" class="load text-grey">共有{{dataList.total}}条符合条件记录</view>

			<view class="item" wx:for="{{dataList.list}}" wx:key="_id">
				<view class="no">{{index+1}}</view>
				<view class="header">
					<view class="left text-cut">
						{{item.CS_CAMPUS}}
					</view>
					<view class="right">
						<text wx:if="{{item.CS_STATUS==1}}" class="text-green">「正常」</text>
						<text wx:elif="{{item.CS_STATUS==0}}" class="text-orange">「停用」</text>
					</view>
				</view>

				<view class="info">
					<view class="info-item">
						<view class="title">负责人</view>
						<view class="mao">：</view>
						<view class="content">{{item.CS_NAME}}</view>
					</view>
					<view class="info-item">
						<view class="title">手机号</view>
						<view class="mao">：</view>
						<view class="content">{{item.CS_MOBILE}}</view>
					</view>
					<view class="info-item" wx:if="{{item.CS_WECHAT}}">
						<view class="title">微信号</view>
						<view class="mao">：</view>
						<view class="content">{{item.CS_WECHAT}}</view>
					</view>
					<view class="info-item" wx:if="{{item.CS_QQ}}">
						<view class="title">QQ</view>
						<view class="mao">：</view>
						<view class="content">{{item.CS_QQ}}</view>
					</view>
					<view class="info-item" wx:if="{{item.CS_WORK_TIME}}">
						<view class="title">工作时间</view>
						<view class="mao">：</view>
						<view class="content">{{item.CS_WORK_TIME}}</view>
					</view>
					<view class="info-item">
						<view class="title">排序号</view>
						<view class="mao">：</view>
						<view class="content">{{item.CS_ORDER}} <text class="margin-left-xxs text-grey">(小的先显示)</text></view>
					</view>
					<view class="info-item">
						<view class="title">创建</view>
						<view class="mao">：</view>
						<view class="content">{{item.CS_ADD_TIME}}</view>
					</view>

					<view class="oprt">
						<view bindtap="url" data-url="../edit/admin_campus_service_edit?id={{item._id}}" class="btn round margin-right-s">
							<text class="icon-edit margin-right-xxs"></text>编辑
						</view>
						<view bindtap="bindStatusMoreTap" data-id="{{item._id}}" class="btn margin-right-s">状态管理</view>
					</view>
				</view>
			</view>
		</view>
		<!-- List END -->

		<!-- load begin -->
		<import src="../../../../../../tpls/public/list_load_tpl.wxml" />
		<template is="listLoadTpl" data="{{dataList,skin:'text-grey'}}" />
		<!-- load end -->

	</cmpt-comm-list>
</block>

<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理中心</text><text>/</text><text>校区客服配置</text></view>
  <view class="ac-heading"><view><view class="ac-title">校区客服配置</view><view class="ac-subtitle">管理负责人、联系方式与服务时间</view></view><button class="ac-primary ac-small" bindtap="url" data-url="../add/admin_campus_service_add">添加客服</button></view>
  <view class="ac-toolbar"><picker range="{{campusOptions}}" value="{{campusIndex}}" bindchange="bindCampusChange"><view class="ac-filter-value"><text>{{campusOptions[campusIndex]}}</text><text>⌄</text></view></picker><text class="ac-link" bindtap="bindNavigate" data-key="chats">客服会话 ›</text></view>
  <include src="../../catalog_filters.wxml" />
  <view wx:for="{{list}}" wx:key="_id" class="ac-card">
    <view class="ac-entry-head"><view class="ac-avatar"><text class="icon-service"></text></view><view class="ac-entry-main"><view class="ac-entry-title">{{item.CS_CAMPUS}}</view><view class="ac-entry-meta">负责人 · {{item.CS_NAME}}</view></view><text class="ac-badge {{item.CS_STATUS===1?'green':'muted'}}">{{item.CS_STATUS===1?'已启用':'已停用'}}</text></view>
    <view class="ac-kv"><text>联系手机</text><text>{{item.CS_MOBILE || '未填写'}}</text></view>
    <view class="ac-kv"><text>服务时间</text><text>{{item.CS_WORK_TIME || '以客服回复为准'}}</text></view>
    <view wx:if="{{item.CS_WECHAT}}" class="ac-kv"><text>微信号</text><text>{{item.CS_WECHAT}}</text></view>
    <view wx:if="{{item.CS_QQ}}" class="ac-kv"><text>QQ 号</text><text>{{item.CS_QQ}}</text></view>
    <view class="ac-order-foot"><text>排序 {{item.CS_ORDER}} · 数字越小越靠前</text></view>
    <view class="ac-card-actions two"><button class="ac-secondary" bindtap="url" data-url="../edit/admin_campus_service_edit?id={{item._id}}">编辑配置</button><button class="ac-ghost" bindtap="bindStatusMoreTap" data-id="{{item._id}}" disabled="{{busy}}">状态管理</button></view>
  </view>
  <include src="../../catalog_footer.wxml" />
</view>

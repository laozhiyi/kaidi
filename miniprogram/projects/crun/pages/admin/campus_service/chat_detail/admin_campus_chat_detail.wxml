<view wx:if="{{isAdmin}}" class="ac-chat-page">
  <view class="ac-chat-header">
    <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 客服会话</text><text>/</text><text>会话详情</text></view>
    <view wx:if="{{service}}" class="ac-chat-heading"><view class="ac-icon"><text class="icon-service"></text></view><view class="ac-entry-main"><view class="ac-entry-title">{{service.CS_CAMPUS}}客服</view><view class="ac-entry-meta">负责人 · {{service.CS_NAME}}</view></view><text class="ac-badge {{service.CS_STATUS==1?'green':'muted'}}">{{service.CS_STATUS==1?'服务中':'已停用'}}</text></view>
    <view wx:if="{{service && userId}}" class="ac-chat-user"><text class="ac-id">咨询用户 · {{userId}}</text><text class="ac-link" bindtap="bindUserDetail">查看资料 ›</text></view>
  </view>
  <view wx:if="{{!isLoad}}" class="ac-chat-state">正在加载对话…</view>
  <block wx:if="{{isLoad && service}}">
    <view wx:if="{{errorText}}" class="refresh-error" bindtap="bindRefreshTap">{{errorText}}</view>
    <scroll-view class="message-list" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-top="{{scrollTop}}" lower-threshold="80" bindscroll="bindMessageScroll" bindscrolltolower="bindScrollLower">
      <view class="message-content">
        <view class="history-action" wx:if="{{hasMore}}" bindtap="bindEarlierTap">{{loadingEarlier?'正在加载…':(historyError || '加载更早消息')}}</view>
        <view class="history-end" wx:elif="{{messages.length}}">以上是全部历史消息</view>
        <view wx:if="{{!messages.length}}" class="ac-chat-state"><view class="ac-state-title">暂无对话消息</view><view class="ac-muted">用户的咨询与客服回复会显示在这里</view></view>
        <view wx:for="{{messages}}" wx:key="CSM_ID" id="msg-{{item.CSM_ID}}" class="message {{item.CSM_SENDER==ownSender?'message-me':'message-service'}}">
          <view class="message-avatar"><text class="{{item.CSM_SENDER=='admin'?'icon-service':'icon-profile'}}"></text></view>
          <view class="message-body"><view class="message-name">{{item.CSM_SENDER=='admin'?service.CS_NAME:'咨询用户'}}</view><view class="bubble"><text user-select>{{item.CSM_CONTENT}}</text></view><view class="message-time">{{item.CSM_ADD_TIME}}</view></view>
        </view>
        <view id="messages-bottom" class="messages-bottom"></view>
      </view>
    </scroll-view>
    <view wx:if="{{hasNewMessages}}" class="new-messages" bindtap="bindLatestTap">有新消息 · 查看最新</view>
    <view wx:if="{{service.CS_STATUS!=1}}" class="refresh-error">此客服已停用，当前会话仅可查看历史消息。</view>
    <view class="composer"><view class="composer-field"><textarea class="composer-input" maxlength="500" auto-height placeholder="输入回复内容…" value="{{content}}" bindinput="bindContentInput" disabled="{{service.CS_STATUS!=1}}" cursor-spacing="20" /><view class="counter">{{content.length}} / 500</view></view><button class="send-btn" disabled="{{isSending || !content.length || service.CS_STATUS!=1}}" loading="{{isSending}}" bindtap="bindSendTap">{{isSending?'发送中':'回复'}}</button></view>
  </block>
  <view wx:if="{{isLoad && !service}}" class="ac-chat-state"><view class="ac-state-title">{{errorText || '会话暂不可用'}}</view><button class="ac-secondary" bindtap="bindRefreshTap" loading="{{loading}}">重新加载</button></view>
</view>

<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理中心</text><text>/</text><text>客服会话</text></view>
  <view class="ac-heading"><view><view class="ac-title">客服会话</view><view class="ac-subtitle">查看校区咨询，及时回复用户消息</view></view></view>
  <view class="ac-toolbar"><picker range="{{campusOptions}}" value="{{campusIndex}}" bindchange="bindCampusChange"><view class="ac-filter-value"><text>{{campusOptions[campusIndex]}}</text><text>⌄</text></view></picker><text class="ac-link" bindtap="bindNavigate" data-key="services">校区客服配置 ›</text></view>
  <include src="../../catalog_filters.wxml" />
  <view wx:for="{{list}}" wx:key="_id" class="ac-card ac-conversation" bindtap="url" data-url="../chat_detail/admin_campus_chat_detail?sessionId={{item.CSM_SESSION_ID}}">
    <view class="ac-entry-head"><view class="ac-avatar"><text class="icon-message"></text></view><view class="ac-entry-main"><view class="ac-entry-title">{{item.CS_CAMPUS}}客服</view><view class="ac-entry-meta">{{item.CS_NAME || '校区客服'}}</view></view><text class="ac-badge {{item.unread?'red':'muted'}}">{{item.unread?item.unread+' 条未读':'已读'}}</text></view>
    <view class="ac-message-preview ac-clamp">{{item.lastContent || '暂无消息内容'}}</view>
    <view class="ac-conversation-user"><text class="icon-profile"></text><text class="ac-id">{{item.CSM_USER_ID}}</text></view>
    <view class="ac-order-foot"><text>{{item.lastTime}}</text><text class="ac-link">查看对话 ›</text></view>
  </view>
  <include src="../../catalog_footer.wxml" />
</view>

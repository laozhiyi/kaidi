<view class="ac-card">
  <view class="ac-card-title"><view class="ac-icon"><text class="icon-notice"></text></view><view><view class="ac-section-title">公告信息</view><view class="ac-card-desc">清楚的标题更方便用户了解内容</view></view></view>
  <view class="ac-form-field"><view class="ac-label">公告标题<text class="ac-required">*</text></view><input class="ac-input" placeholder="输入简短、明确的标题" placeholder-class="ac-placeholder" model:value="{{formTitle}}" focus="{{formTitleFocus}}" maxlength="50" disabled="{{isSubmit}}" /><view wx:if="{{formTitleFocus}}" class="ac-field-error">{{formTitleFocus}}</view></view>
  <view wx:if="{{cateIdOptions.length>1}}" class="ac-form-field" id="formCateId"><view class="ac-label">公告分类<text class="ac-required">*</text></view><view class="ac-select"><cmpt-picker id="cate-picker" sourceData="{{cateIdOptions}}" bind:select="url" data-type="picker" data-item="formCateId" item="{{formCateId}}" /></view><view wx:if="{{formCateIdFocus}}" class="ac-field-error">{{formCateIdFocus}}</view></view>
  <view class="ac-form-field"><view class="ac-label">显示排序</view><input class="ac-input" type="number" placeholder="输入排序号" placeholder-class="ac-placeholder" model:value="{{formOrder}}" focus="{{formOrderFocus}}" maxlength="4" disabled="{{isSubmit}}" /><view wx:if="{{formOrderFocus}}" class="ac-field-error">{{formOrderFocus}}</view><view class="ac-field-hint">数字越小越靠前，设为 0 可置顶。</view></view>
</view>
<view class="ac-card">
  <view class="ac-section-head"><text class="ac-section-title">简介</text><text class="ac-muted">选填</text></view>
  <textarea placeholder="简要介绍公告内容；留空时自动提取正文前 100 字" placeholder-class="ac-placeholder" model:value="{{formDesc}}" maxlength="100" focus="{{formDescFocus}}" disabled="{{isSubmit}}" />
  <view class="ac-counter">{{formDesc.length}} / 100</view><view wx:if="{{formDescFocus}}" class="ac-field-error">{{formDescFocus}}</view>
  <view class="ac-news-content-link" bindtap="url" data-url="../../content/admin_content"><view><view class="ac-row-title">公告正文<text class="ac-required"> *</text></view><view class="ac-row-desc">{{contentDesc || '未填写'}} · 点击编辑图文内容</view></view><text class="ac-chevron">›</text></view>
  <view wx:if="{{formContentFocus}}" class="ac-field-error">{{formContentFocus}}</view>
</view>
<view class="ac-card ac-upload-card"><view class="ac-section-title">公告封面<text class="ac-required"> *</text></view><view class="ac-card-desc">上传一张清晰的图片，用于公告列表展示</view><cmpt-img-upload imgMax="{{1}}" title="封面图片" isCheck="{{false}}" imgUploadSize="{{10}}" imgList="{{imgList}}" bind:upload="bindImgUploadCmpt" /></view>
<view wx:if="{{fields.length}}" class="ac-card"><cmpt-form-show id="cmpt-form" mark="cmpt-form" source="admin" isCacheMatch="{{false}}" fields="{{fields}}" forms="{{formForms}}" isDefMatch="{{id?false:true}}" /></view>
<button class="ac-primary" bindtap="bindFormSubmit" disabled="{{isSubmit}}" loading="{{isSubmit}}">{{isSubmit?'正在提交…':id?'保存修改':'发布公告'}}</button>

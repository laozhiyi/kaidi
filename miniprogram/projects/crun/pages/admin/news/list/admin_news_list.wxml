<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理中心</text><text>/</text><text>公告管理</text></view>
  <view class="ac-heading"><view><view class="ac-title">公告管理</view><view class="ac-subtitle">发布校园通知，维护服务资讯</view></view><button class="ac-primary ac-small" bindtap="url" data-url="../add/admin_news_add">发布公告</button></view>
  <include src="../../catalog_filters.wxml" />
  <view wx:for="{{list}}" wx:key="_id" class="ac-card">
    <view class="ac-news-header"><text class="ac-badge {{item.NEWS_STATUS===1?'green':'muted'}}">{{item.NEWS_STATUS===1?'已发布':'已停用'}}</text><text class="ac-news-category">{{item.NEWS_CATE_NAME || '公告资讯'}}</text></view>
    <view class="ac-news-main" bindtap="url" data-url="../edit/admin_news_edit?id={{item._id}}"><view class="ac-entry-main"><view class="ac-entry-title">{{item.NEWS_TITLE}}</view><view wx:if="{{item.NEWS_DESC}}" class="ac-entry-meta ac-clamp">{{item.NEWS_DESC}}</view></view><image wx:if="{{item.NEWS_PIC && item.NEWS_PIC.length}}" class="ac-news-cover" src="{{item.NEWS_PIC[0]}}" mode="aspectFill" /></view>
    <view wx:if="{{item.NEWS_ORDER===0 || item.NEWS_VOUCH===1}}" class="ac-tags"><text wx:if="{{item.NEWS_ORDER===0}}" class="ac-badge">置顶</text><text wx:if="{{item.NEWS_VOUCH===1}}" class="ac-badge amber">首页推荐</text></view>
    <view class="ac-news-meta"><text>{{item.NEWS_ADD_TIME}}</text><text>排序 {{item.NEWS_ORDER}}</text></view>
    <view class="ac-card-actions ac-news-actions"><button class="ac-secondary" bindtap="url" data-url="../edit/admin_news_edit?id={{item._id}}">编辑</button><button class="ac-ghost" bindtap="url" data-url="../../../news/detail/news_detail?id={{item._id}}">预览</button><button class="ac-ghost" bindtap="bindStatusMoreTap" data-id="{{item._id}}" disabled="{{busy}}">状态管理</button><button class="ac-ghost" bindtap="bindMoreTap" data-id="{{item._id}}" disabled="{{busy}}">更多</button></view>
  </view>
  <include src="../../catalog_footer.wxml" />
</view>

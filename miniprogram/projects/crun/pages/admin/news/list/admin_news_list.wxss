@import '../../../../style/admin_console.wxss';
.ac-news-header { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; margin-bottom: 22rpx; }
.ac-news-category { color: #8995a8; font-size: 23rpx; }
.ac-news-main { display: flex; align-items: flex-start; gap: 22rpx; }
.ac-news-cover { width: 132rpx; height: 112rpx; flex-shrink: 0; border-radius: 12rpx; background: #f0f4fb; }
.ac-news-meta { display: flex; justify-content: space-between; gap: 16rpx; flex-wrap: wrap; margin-top: 22rpx; color: #8995a8; font-size: 22rpx; }
.ac-page .ac-news-actions { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.ac-page .ac-news-actions button { font-size: 22rpx; padding: 16rpx 6rpx; }

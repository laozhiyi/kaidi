@import '../../../../style/admin_console.wxss';
.ac-service-status { flex-shrink: 0; display: flex; align-items: center; gap: 10rpx; padding: 12rpx 15rpx; background: #fff; border: 1rpx solid #e3e9f2; border-radius: 30rpx; color: #60718b; font-size: 21rpx; }
.ac-service-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #3c9c78; }
.ac-service-dot.paused { background: #d39848; }
.ac-service-dot.unknown { background: #98a4b6; }
.ac-page .ac-row > .ac-icon:first-child { flex: 0 0 64rpx; }
.ac-page .ac-row > view:nth-child(2) { flex: 1; min-width: 0; }
.ac-page .ac-icon-red { color: #bc4f4f; background: #fff0f0; }
.ac-page .ac-icon-amber { color: #a76e26; background: #fff5e7; }
.ac-page .ac-health { display: flex; align-items: center; justify-content: space-between; }
.ac-page .ac-heading { align-items: flex-start; flex-wrap: wrap; }
.ac-page .ac-heading > view:first-child { flex-basis: 430rpx; }
.ac-service-status { margin-top: 6rpx; }

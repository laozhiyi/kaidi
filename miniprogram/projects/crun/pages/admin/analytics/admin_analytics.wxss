@import '../../../style/admin_console.wxss';
.ac-page .ac-analytics-hero { color: #fff; border: 0; background: linear-gradient(120deg, #2863db, #4279e5); padding: 32rpx; }
.ac-analytics-top { display: flex; align-items: center; justify-content: space-between; color: #e4edff; font-size: 26rpx; }
.ac-analytics-tag { padding: 5rpx 14rpx; font-size: 21rpx; border: 1rpx solid rgba(255,255,255,.25); border-radius: 8rpx; }
.ac-analytics-total { display: flex; align-items: baseline; flex-wrap: wrap; gap: 14rpx; margin: 18rpx 0 28rpx; font-size: 66rpx; font-weight: 600; line-height: 1.25; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.ac-analytics-unit { font-size: 24rpx; color: #e4edff; font-weight: 400; }
.ac-analytics-overview { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; border-top: 1rpx solid rgba(255,255,255,.2); padding-top: 22rpx; }
.ac-analytics-caption { color: #e4edff; font-size: 22rpx; }
.ac-analytics-value { margin-top: 8rpx; font-size: 31rpx; font-weight: 500; font-variant-numeric: tabular-nums; }
.ac-analytics-value text { font-size: 21rpx; font-weight: 400; }
.ac-distribution { padding: 18rpx 0; }
.ac-distribution-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 12rpx; }
.ac-distribution-label { display: flex; align-items: center; gap: 12rpx; font-size: 25rpx; }
.ac-distribution-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #7ca3ed; flex-shrink: 0; }
.ac-distribution-dot.green { background: #59ac87; }
.ac-distribution-dot.red { background: #df8383; }
.ac-distribution-dot.amber { background: #e4b76f; }
.ac-distribution-dot.muted { background: #b2bdcd; }
.ac-distribution-data { display: flex; align-items: center; gap: 16rpx; font-size: 25rpx; font-variant-numeric: tabular-nums; }
.ac-distribution-count { font-weight: 500; }
.ac-distribution-percent { width: 82rpx; text-align: right; font-size: 22rpx; color: #8995a8; }
.ac-page .ac-distribution .ac-chart-track { height: 10rpx; }
.ac-page .ac-distribution .ac-chevron { font-size: 28rpx; line-height: 1; }
.ac-analytics-todos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.ac-analytics-todo { background: #f6f8fc; padding: 22rpx; border-radius: 14rpx; min-width: 0; }
.ac-todo-label { font-size: 24rpx; color: #63748c; }
.ac-analytics-todo > view { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 8rpx 0; }
.ac-todo-number { font-size: 40rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.ac-page .ac-analytics-todo .ac-field-hint { font-size: 21rpx; }

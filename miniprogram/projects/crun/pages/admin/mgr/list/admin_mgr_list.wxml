<view wx:if="{{isAdmin && isSuperAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理中心</text><text>/</text><text>管理员账号</text></view>
  <view class="ac-heading"><view><view class="ac-title">管理员账号</view><view class="ac-subtitle">维护管理权限与账号信息</view></view><button class="ac-primary ac-small" bindtap="url" data-url="../add/admin_mgr_add">添加账号</button></view>
  <include src="../../catalog_filters.wxml" />
  <view wx:for="{{list}}" wx:key="_id" class="ac-card">
    <view class="ac-entry-head"><view class="ac-avatar"><text class="icon-profile"></text></view><view class="ac-entry-main"><view class="ac-entry-title">{{item.ADMIN_DESC || item.ADMIN_NAME}}</view><view class="ac-entry-meta">登录账号 · {{item.ADMIN_NAME}}</view></view><text class="ac-badge {{item.ADMIN_STATUS===1?'green':'muted'}}">{{item.ADMIN_STATUS===1?'正常':'已停用'}}</text></view>
    <view class="ac-tags"><text class="ac-badge {{item.ADMIN_TYPE===1?'':'muted'}}">{{item.ADMIN_TYPE===1?'超级管理员':'普通管理员'}}</text></view>
    <view class="ac-kv"><text>联系手机</text><text>{{item.ADMIN_PHONE || '未填写'}}</text></view>
    <view class="ac-kv"><text>最近登录</text><text>{{item.ADMIN_LOGIN_CNT?item.ADMIN_LOGIN_TIME:'尚未登录'}}</text></view>
    <view class="ac-card-actions"><button class="ac-secondary" bindtap="url" data-url="../edit/admin_mgr_edit?id={{item._id}}">编辑资料</button><block wx:if="{{item.ADMIN_TYPE!==1}}"><button class="ac-ghost" bindtap="bindStatusTap" data-id="{{item._id}}" data-status="{{item.ADMIN_STATUS===1?0:1}}" disabled="{{busy}}">{{item.ADMIN_STATUS===1?'停用':'启用'}}</button><button class="ac-ghost ac-text-red" bindtap="bindDelTap" data-id="{{item._id}}" disabled="{{busy}}">删除</button></block></view>
  </view>
  <include src="../../catalog_footer.wxml" />
</view>

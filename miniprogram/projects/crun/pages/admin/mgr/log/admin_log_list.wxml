<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理中心</text><text>/</text><text>操作日志</text></view>
  <view class="ac-heading"><view><view class="ac-title">操作日志</view><view class="ac-subtitle">查看操作内容，追溯管理记录</view></view></view>
  <include src="../../catalog_filters.wxml" />
  <view wx:for="{{list}}" wx:key="_id" class="ac-card ac-log-card">
    <view class="ac-section-head"><text class="ac-badge">{{item.LOG_TYPE_DESC || '其他'}}操作</text><text class="ac-log-time">{{item.LOG_ADD_TIME}}</text></view>
    <view class="ac-log-content">{{item.LOG_CONTENT}}</view>
    <view class="ac-log-actor"><view class="ac-log-avatar"><text class="icon-profile"></text></view><view class="ac-entry-main"><view>{{item.LOG_ADMIN_DESC || item.LOG_ADMIN_NAME}}</view><view class="ac-entry-meta">{{item.LOG_ADMIN_NAME}}</view></view></view>
    <view wx:if="{{item.LOG_ADD_IP}}" class="ac-log-address">IP · {{item.LOG_ADD_IP}}</view>
  </view>
  <include src="../../catalog_footer.wxml" />
  <view wx:if="{{isSuperAdmin}}" class="ac-log-clean"><text class="ac-muted">日志用于查看历史管理操作</text><button class="ac-ghost ac-small ac-text-red" bindtap="bindClearTap" disabled="{{busy || loading}}" loading="{{busy}}">清空日志</button></view>
</view>

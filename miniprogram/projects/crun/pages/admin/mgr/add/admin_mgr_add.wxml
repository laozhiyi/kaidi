<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理员账号</text><text>/</text><text>添加管理员</text></view>
  <view class="ac-heading"><view><view class="ac-title">添加管理员</view><view class="ac-subtitle">维护管理员身份与登录信息</view></view></view>
  <block wx:if="{{isLoad}}">
    <view class="ac-card"><view class="ac-card-title"><view class="ac-icon"><text class="icon-profile"></text></view><view><view class="ac-section-title">基本资料</view><view class="ac-card-desc">新增账号默认为普通管理员</view></view></view>
    <view class="ac-form-field"><view class="ac-label">登录账号<text class="ac-required">*</text></view><input class="ac-input" model:value="{{formName}}" placeholder="输入 5～30 位登录账号" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formNameFocus}}" maxlength="30" /><view wx:if="{{formNameFocus}}" class="ac-field-error">{{formNameFocus}}</view></view>
    <view class="ac-form-field"><view class="ac-label">管理员姓名<text class="ac-required">*</text></view><input class="ac-input" model:value="{{formDesc}}" placeholder="输入管理员姓名" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formDescFocus}}" maxlength="30" /><view wx:if="{{formDescFocus}}" class="ac-field-error">{{formDescFocus}}</view></view>
    <view class="ac-form-field"><view class="ac-label">联系手机<text class="ac-optional">选填</text></view><input class="ac-input" model:value="{{formPhone}}" placeholder="输入手机号码" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formPhoneFocus}}" type="number" maxlength="11" /><view wx:if="{{formPhoneFocus}}" class="ac-field-error">{{formPhoneFocus}}</view></view>
    </view><view class="ac-card"><view class="ac-section-title">登录密码</view>
    <view class="ac-form-field"><view class="ac-label">初始密码<text class="ac-required">*</text></view><input class="ac-input" model:value="{{formPassword}}" placeholder="设置管理员登录密码" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formPasswordFocus}}" type="text" password="{{true}}" maxlength="128" /><view wx:if="{{formPasswordFocus}}" class="ac-field-error">{{formPasswordFocus}}</view></view>
    <view class="ac-field-hint">请将账号与初始密码交给对应管理员。</view></view>
    <button class="ac-primary" bindtap="bindFormSubmit" disabled="{{busy}}" loading="{{busy}}">{{busy?'正在保存…':'创建管理员账号'}}</button>
  </block>
</view>

<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理员账号</text><text>/</text><text>编辑管理员</text></view>
  <view class="ac-heading"><view><view class="ac-title">编辑管理员</view><view class="ac-subtitle">维护管理员身份与登录信息</view></view></view>
  <view wx:if="{{loading}}" class="ac-card ac-state ac-muted">正在读取管理员资料…</view>
  <view wx:if="{{error}}" class="ac-card ac-state"><view>{{error}}</view><button class="ac-secondary ac-small" bindtap="load">重新读取</button></view>
  <view wx:if="{{notFound}}" class="ac-card ac-state"><view class="ac-state-title">管理员账号不存在</view><button class="ac-secondary ac-small" bindtap="bindBack">返回账号列表</button></view>
  <block wx:if="{{isLoad}}">
    <view class="ac-card"><view class="ac-card-title"><view class="ac-icon"><text class="icon-profile"></text></view><view><view class="ac-section-title">基本资料</view><view class="ac-card-desc">更新账号名称与联系方式</view></view></view>
    <view class="ac-form-field"><view class="ac-label">登录账号<text class="ac-required">*</text></view><input class="ac-input" model:value="{{formName}}" placeholder="输入 5～30 位登录账号" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formNameFocus}}" maxlength="30" /><view wx:if="{{formNameFocus}}" class="ac-field-error">{{formNameFocus}}</view></view>
    <view class="ac-form-field"><view class="ac-label">管理员姓名<text class="ac-required">*</text></view><input class="ac-input" model:value="{{formDesc}}" placeholder="输入管理员姓名" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formDescFocus}}" maxlength="30" /><view wx:if="{{formDescFocus}}" class="ac-field-error">{{formDescFocus}}</view></view>
    <view class="ac-form-field"><view class="ac-label">联系手机<text class="ac-optional">选填</text></view><input class="ac-input" model:value="{{formPhone}}" placeholder="输入手机号码" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formPhoneFocus}}" type="number" maxlength="11" /><view wx:if="{{formPhoneFocus}}" class="ac-field-error">{{formPhoneFocus}}</view></view>
    </view><view class="ac-card"><view class="ac-section-title">重置密码</view>
    <view class="ac-form-field"><view class="ac-label">新密码<text class="ac-optional">选填</text></view><input class="ac-input" model:value="{{formPassword}}" placeholder="留空则保持原密码" placeholder-class="ac-placeholder" disabled="{{busy}}" focus="{{formPasswordFocus}}" type="text" password="{{true}}" maxlength="128" /><view wx:if="{{formPasswordFocus}}" class="ac-field-error">{{formPasswordFocus}}</view></view>
    <view class="ac-field-hint">不修改密码时，请将此项留空。</view></view>
    <button class="ac-primary" bindtap="bindFormSubmit" disabled="{{busy}}" loading="{{busy}}">{{busy?'正在保存…':'保存修改'}}</button>
  </block>
</view>

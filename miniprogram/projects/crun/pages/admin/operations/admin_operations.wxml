<view wx:if="{{isAdmin}}" class="op-page">
  <view class="op-tabs op-tabs-equal">
    <view wx:for="{{tabs}}" wx:key="id" class="op-tab {{tab===item.id?'active':''}}" data-tab="{{item.id}}" bindtap="bindTab">{{item.text}}</view>
  </view>
  <view wx:if="{{error}}" class="op-card op-state"><view>加载失败，已有内容已保留</view><button bindtap="load" class="op-button-secondary">重新加载</button></view>
  <view wx:if="{{loading || detailLoading}}" class="op-state op-muted">{{detailLoading?'正在读取详情…':'正在加载…'}}</view>

  <block wx:if="{{tab==='overview' && overview}}">
    <view class="op-section-title">运营概况</view>
    <view class="op-stats">
      <view class="op-stat"><text class="op-stat-value">{{overview.waiting}}</text><text>待接单</text></view>
      <view class="op-stat"><text class="op-stat-value">{{overview.delivering}}</text><text>配送中</text></view>
      <view class="op-stat"><text class="op-stat-value">{{overview.confirming}}</text><text>待确认</text></view>
      <view class="op-stat"><text class="op-stat-value op-text-warning">{{overview.exceptions}}</text><text>异常订单</text></view>
      <view class="op-stat"><text class="op-stat-value">{{overview.completed}}</text><text>已完成</text></view>
      <view class="op-stat"><text class="op-stat-value op-text-warning">{{overview.complaints}}</text><text>待处理投诉</text></view>
    </view>
    <view class="op-card">
      <view class="op-title">通知与维护</view>
      <view class="op-row"><text>微信通知失败</text><text class="op-badge">{{overview.failedNotifications}} 条</text></view>
      <view class="op-muted">定时任务每 5 分钟关闭过期待接单、发送超时提醒并重试通知，不会自动确认收货。</view>
      <button wx:if="{{isSuperAdmin}}" class="op-button-secondary" bindtap="bindMaintain" loading="{{busy}}" disabled="{{busy}}">手动执行维护</button>
    </view>
  </block>

  <block wx:if="{{!detail && (tab==='orders' || tab==='riders' || tab==='feedback')}}">
    <view class="op-toolbar">
      <picker wx:if="{{tab==='orders'}}" class="op-filter" range="{{statuses}}" value="{{statusIndex}}" bindchange="bindFilter"><view class="op-picker"><text>{{statuses[statusIndex]}}</text><text class="op-muted">筛选 ▾</text></view></picker>
      <view wx:else class="op-section-title">{{tab==='riders'?'骑手资格审核':'反馈与投诉'}}</view>
      <button wx:if="{{tab==='orders'}}" class="op-button-secondary op-button-small" bindtap="bindExport">导出订单</button>
    </view>
    <view class="op-muted op-list-hint">点击记录查看详情并处理，列表支持上拉加载</view>
    <view wx:if="{{!loading && !error && !list.length}}" class="op-card op-state">暂无记录</view>
    <view class="op-card" wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="bindDetail">
      <block wx:if="{{tab==='orders'}}">
        <view class="op-card-head"><text class="op-record-title">{{item.MAIL_OBJ.title || '快递代取'}}</text><text class="op-badge">{{item.status}}</text></view>
        <view class="op-row"><text>{{item.MAIL_OBJ.campus}}</text><text class="op-price">¥{{item.MAIL_OBJ.price}}</text></view>
        <view wx:if="{{item.overdue}}" class="op-warning">已超时，请及时跟进</view>
        <view class="op-card-foot"><text class="op-id">{{item.MAIL_ID}}</text><text>查看订单 ›</text></view>
      </block>
      <block wx:elif="{{tab==='riders'}}">
        <view class="op-card-head"><text class="op-record-title">{{item.USER_NAME}}</text><text class="op-badge">{{item.USER_RIDER_STATUS===1?'已通过':item.USER_RIDER_STATUS===2?'待审核':item.USER_RIDER_STATUS===8?'未通过':item.USER_RIDER_STATUS===9?'已停用':'无资格'}}</text></view>
        <view>{{item.USER_RIDER_CAMPUS || '未申请校区'}}</view>
        <view class="op-card-foot"><text>{{item.USER_MOBILE}}</text><text>查看申请 ›</text></view>
      </block>
      <block wx:else>
        <view class="op-card-head"><text class="op-record-title">{{item.FB_TITLE}}</text><text class="op-badge">{{item.FB_STATUS===0?'待处理':item.FB_STATUS===1?'已处理':'不予处理'}}</text></view>
        <view class="op-summary">{{item.FB_CONTENT}}</view>
        <view class="op-card-foot"><text>{{item.FB_USER_NAME}}</text><text>查看反馈 ›</text></view>
      </block>
    </view>
    <button wx:if="{{hasMore}}" class="op-button-secondary" bindtap="bindMore" loading="{{loading}}" disabled="{{loading}}">加载更多</button>
    <view wx:if="{{list.length && !hasMore && !loading && !error}}" class="op-state op-muted">已显示全部记录</view>
  </block>

  <block wx:if="{{detail}}">
    <button class="op-button-secondary op-back" bindtap="bindClose" disabled="{{busy}}">‹ 返回{{tab==='orders'?'订单':tab==='riders'?'骑手':'投诉'}}列表</button>
    <block wx:if="{{tab==='orders'}}">
      <view class="op-card">
        <view class="op-card-head"><view class="op-title">订单详情</view><text class="op-badge">{{detail.status}}</text></view>
        <view class="op-muted op-id">{{detail.MAIL_ID}}</view>
        <view class="op-row"><text>{{detail.MAIL_OBJ.campus}} · {{detail.MAIL_OBJ.title}}</text><text class="op-price">¥{{detail.MAIL_OBJ.price}}</text></view>
        <view class="op-row"><text class="op-muted">联系人</text><text>{{detail.MAIL_OBJ.poster}} · {{detail.MAIL_OBJ.tel}}</text></view>
        <view class="op-field-label">取件地址</view><view>{{detail.MAIL_OBJ.address1}}</view>
        <view class="op-field-label">送达地址</view><view>{{detail.MAIL_OBJ.address2}}</view>
        <view class="op-row"><text class="op-muted">取件码</text><text user-select>{{detail.MAIL_OBJ.code || '请查看凭证'}}</text></view>
        <view wx:if="{{detail.MAIL_PAYMENT_MODE!=='offline'}}" class="op-warning">旧支付订单必须人工核对资金，不可自动转线下订单。</view>
        <view class="op-images"><image wx:for="{{detail.MAIL_MEDIA.pickup}}" wx:key="*this" class="op-image" mode="aspectFill" src="{{item}}" data-url="{{item}}" bindtap="bindImage" /></view>
      </view>
      <view wx:if="{{detail.MAIL_DELIVERY_PROOF || detail.MAIL_EXCEPTION}}" class="op-card">
        <view class="op-title">履约与异常凭证</view>
        <block wx:if="{{detail.MAIL_DELIVERY_PROOF}}"><view class="op-field-label">送达说明</view><view>{{detail.MAIL_DELIVERY_PROOF.note || '无补充说明'}}</view><view class="op-images"><image wx:for="{{detail.MAIL_MEDIA.proof}}" wx:key="*this" class="op-image" mode="aspectFill" src="{{item}}" data-url="{{item}}" bindtap="bindImage" /></view></block>
        <block wx:if="{{detail.MAIL_EXCEPTION}}"><view class="op-field-label">异常说明</view><view>{{detail.MAIL_EXCEPTION.reason}} · {{detail.MAIL_EXCEPTION.note}}</view><view class="op-images"><image wx:for="{{detail.MAIL_MEDIA.exception}}" wx:key="*this" class="op-image" mode="aspectFill" src="{{item}}" data-url="{{item}}" bindtap="bindImage" /></view></block>
      </view>
      <view wx:if="{{detail.MAIL_HISTORY.length}}" class="op-card"><view class="op-title">处理记录</view><view class="op-history" wx:for="{{detail.MAIL_HISTORY}}" wx:key="id"><view>{{item.actor}} · {{item.action}}</view><view class="op-muted">{{item.note}}</view></view></view>
      <view wx:if="{{detail.MAIL_STATUS===0 || detail.MAIL_STATUS===1 || detail.MAIL_STATUS===2 || detail.MAIL_STATUS===3}}" class="op-card">
        <view class="op-title">{{detail.MAIL_STATUS===3?'处理异常':'人工介入'}}</view>
        <picker wx:if="{{detail.MAIL_STATUS===3}}" range="{{resolutions}}" value="{{resolutionIndex}}" bindchange="bindResolution"><view class="op-picker"><text>{{resolutions[resolutionIndex]}}</text><text>选择 ›</text></view></picker>
        <view class="op-field-label">处理依据（必填）</view>
        <textarea value="{{note}}" bindinput="bindNote" disabled="{{busy}}" maxlength="500" placeholder="请记录与双方核实的情况、处理依据与结论" />
        <button class="op-button-primary" bindtap="bindProcess" disabled="{{busy}}" loading="{{busy}}">{{detail.MAIL_STATUS===3?'提交异常处理结果':'转入异常处理'}}</button>
      </view>
    </block>
    <view wx:elif="{{tab==='riders'}}" class="op-card">
      <view class="op-title">{{detail.USER_NAME}}的骑手申请</view>
      <view class="op-row"><text class="op-muted">联系电话</text><text>{{detail.USER_MOBILE}}</text></view>
      <view class="op-row"><text class="op-muted">申请校区</text><text>{{detail.USER_RIDER_CAMPUS || '未申请'}}</text></view>
      <view wx:if="{{detail.USER_RIDER_REASON}}" class="op-notice">上次审核：{{detail.USER_RIDER_REASON}}</view>
      <view class="op-notice">请先线下核验校园身份和联系方式。停用不会删除既有订单，应继续协助处理。</view>
      <view class="op-field-label">审核说明（必填）</view><textarea value="{{note}}" bindinput="bindNote" disabled="{{busy}}" maxlength="300" placeholder="填写审核依据或停用原因" />
      <button class="op-button-primary" data-status="1" bindtap="bindProcess" disabled="{{busy}}">审核通过</button>
      <view class="op-actions"><button class="op-button-secondary" data-status="8" bindtap="bindProcess" disabled="{{busy}}">不通过</button><button class="op-button-danger" data-status="9" bindtap="bindProcess" disabled="{{busy}}">停用资格</button></view>
    </view>
    <view wx:elif="{{tab==='feedback'}}" class="op-card">
      <view class="op-title">{{detail.FB_TITLE}}</view><view class="op-prewrap">{{detail.FB_CONTENT}}</view>
      <view class="op-field-label">关联订单</view><view class="op-id">{{detail.FB_ORDER_ID || '未关联'}}</view>
      <view class="op-row"><text class="op-muted">联系方式</text><text>{{detail.FB_CONTACT || detail.FB_USER_MOBILE || '未提供'}}</text></view>
      <view class="op-images"><image class="op-image" wx:for="{{detail.FB_IMG_PREVIEW}}" wx:key="*this" mode="aspectFill" src="{{item}}" data-url="{{item}}" bindtap="bindImage" /></view>
      <view class="op-history" wx:for="{{detail.FB_HISTORY}}" wx:key="at">{{item.reply}}</view>
      <view class="op-field-label">回复与处理依据（必填）</view><textarea value="{{note}}" bindinput="bindNote" disabled="{{busy}}" maxlength="500" placeholder="填写回复内容和处理依据" />
      <button class="op-button-primary" data-status="1" bindtap="bindProcess" disabled="{{busy}}">回复并处理完成</button>
      <view class="op-actions"><button class="op-button-secondary" data-status="0" bindtap="bindProcess" disabled="{{busy}}">回复，继续跟进</button><button class="op-button-danger" data-status="2" bindtap="bindProcess" disabled="{{busy}}">说明不予处理</button></view>
    </view>
  </block>

  <block wx:if="{{tab==='config' && config}}">
    <view wx:if="{{!isSuperAdmin}}" class="op-notice">当前为只读模式。修改配置请联系超级管理员。</view>
    <view class="op-card">
      <view class="op-title">服务开关</view>
      <view class="op-warning">未保存配置时，服务按默认营业时间开放；已保存的暂停状态不会被自动覆盖。对外开放前请完成权限、内容审核和双账号真机验收；准备期间请关闭服务并保存。</view>
      <view class="op-row"><text>开放服务</text><switch color="#397bc8" checked="{{config.enabled}}" disabled="{{!isSuperAdmin || busy}}" data-key="enabled" bindchange="bindConfigSwitch" /></view>
      <view class="op-row"><text>注册需审核</text><switch color="#397bc8" checked="{{config.registrationReview}}" disabled="{{!isSuperAdmin || busy}}" data-key="registrationReview" bindchange="bindConfigSwitch" /></view>
      <view class="op-row"><text>开放加急</text><switch color="#397bc8" checked="{{config.urgentEnabled}}" disabled="{{!isSuperAdmin || busy}}" data-key="urgentEnabled" bindchange="bindConfigSwitch" /></view>
    </view>
    <view class="op-card">
      <view class="op-title">价格、限额与时效</view><view class="op-muted">营业时间按北京时间整点填写</view>
      <view class="op-number-field" wx:for="{{fields}}" wx:key="key"><view class="op-number-label">{{item.label}}</view><view class="op-number-value"><input type="{{item.type}}" value="{{config[item.key]}}" disabled="{{!isSuperAdmin || busy}}" data-key="{{item.key}}" bindinput="bindConfigNumber" /><text class="op-muted">{{item.unit}}</text></view></view>
    </view>
    <view class="op-card">
      <view class="op-title">校区与结算说明</view>
      <view class="op-field-label">服务校区（每行一个）</view><textarea value="{{campusText}}" disabled="{{!isSuperAdmin || busy}}" bindinput="bindCampuses" maxlength="600" placeholder="填写开放服务的校区" />
      <view class="op-field-label">线下结算说明</view><textarea value="{{config.offlineNotice}}" disabled="{{!isSuperAdmin || busy}}" bindinput="bindNotice" maxlength="300" />
      <button wx:if="{{isSuperAdmin}}" class="op-button-primary" bindtap="bindSave" disabled="{{busy}}" loading="{{busy}}">保存运营配置</button>
    </view>
  </block>
</view>
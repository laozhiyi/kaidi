<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="url" data-type="back">‹ 公告编辑</text><text>/</text><text>正文内容</text></view>
  <view class="ac-heading"><view><view class="ac-title">公告正文</view><view class="ac-subtitle">添加文字与图片，预览排版效果</view></view></view>
  <view class="ac-card"><cmpt-editor class="ac-editor" nodeList="{{formContent}}" viewMode="{{true}}" consoleMode="{{true}}" id="contentEditor" /></view>
  <view class="ac-form-actions"><button class="ac-ghost" bindtap="url" data-type="back">取消</button><button class="ac-primary" bindtap="bindSaveTap">完成编辑</button></view>
  <view class="ac-footnote">完成后返回公告页面，点击保存或发布。</view>
</view>

<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 投诉与反馈</text><text>/</text><text>反馈详情</text></view>
  <view class="ac-heading"><view><view class="ac-title">反馈详情</view><view class="ac-subtitle">核实问题并形成完整的处理记录</view></view></view>
  <view wx:if="{{error}}" class="ac-card ac-state"><view>{{error}}</view><button class="ac-secondary ac-small" bindtap="load" disabled="{{busy}}">重新读取详情</button></view>
  <view wx:if="{{loading && !detail}}" class="ac-card ac-state ac-muted">正在读取反馈…</view>
  <view wx:if="{{notFound}}" class="ac-card ac-state"><view class="ac-state-title">反馈不存在或已不可访问</view><button class="ac-secondary" bindtap="bindBack">返回反馈列表</button></view>
  <block wx:if="{{detail}}">
    <view class="ac-card ac-detail-hero"><view class="ac-order-head"><text class="ac-muted">{{detail.FB_TYPE || '用户反馈'}}</text><text class="ac-badge {{detail.tone}}">{{detail.statusLabel}}</text></view><view class="ac-detail-status">{{detail.FB_TITLE}}</view><view class="ac-summary-text">{{detail.FB_CONTENT}}</view><view class="ac-images"><image wx:for="{{detail.FB_IMG_PREVIEW}}" wx:key="*this" class="ac-image" mode="aspectFill" src="{{item}}" data-url="{{item}}" bindtap="bindImage" /></view></view>
    <view class="ac-card"><view class="ac-section-title">提交信息</view><view class="ac-row"><text class="ac-muted">提交用户</text><text>{{detail.FB_USER_NAME || '未填写'}}</text></view><view class="ac-row"><text class="ac-muted">联系方式</text><text user-select>{{detail.FB_CONTACT || detail.FB_USER_MOBILE || '未提供'}}</text></view><view class="ac-row"><text class="ac-muted">提交时间</text><text>{{detail.createdText}}</text></view><view class="ac-row"><text class="ac-muted">关联订单</text><text wx:if="{{detail.FB_ORDER_ID}}" class="ac-link" bindtap="bindOrder">查看订单详情 ›</text><text wx:else>未关联订单</text></view></view>
    <view wx:if="{{detail.FB_CAN_RATE || detail.FB_REVIEW_SCORE}}" class="ac-card"><view class="ac-section-title">被申诉用户</view><view class="ac-row"><text>{{detail.FB_TARGET_NAME || '订单对方'}}</text><text class="ac-badge">{{detail.FB_TARGET_ROLE}}</text></view><view class="ac-rating-note">根据关联订单确定评分对象，评分依据对双方可见。</view><view wx:if="{{detail.ratingStars}}" class="ac-current-rating"><text>{{detail.ratingStars}}</text><text>当前审核评分 · {{detail.FB_REVIEW_POINTS > 0 ? '+' : ''}}{{detail.FB_REVIEW_POINTS}} 分</text></view></view>
    <view class="ac-card"><view class="ac-section-head"><text class="ac-section-title">处理记录</text><text class="ac-muted">{{detail.history.length}} 条</text></view><view wx:if="{{!detail.history.length}}" class="ac-muted">尚无处理记录，请核实后回复用户。</view><view wx:else class="ac-timeline"><view class="ac-event" wx:for="{{detail.history}}" wx:key="key"><view class="ac-event-title">{{item.statusLabel}}</view><view class="ac-event-time">{{item.timeText}}</view><view class="ac-event-note">{{item.reply}}</view><view wx:if="{{item.ratingText}}" class="ac-rating-note">{{item.ratingText}}</view></view></view></view>
    <view class="ac-card"><view class="ac-section-head"><text class="ac-section-title">{{detail.FB_STATUS===0?'处理反馈':'补充处理回复'}}</text><text class="ac-badge">回复对用户可见</text></view>
      <view class="ac-field-label">处理方式</view><picker range="{{actions}}" value="{{actionIndex}}" bindchange="bindAction" disabled="{{busy}}"><view class="ac-form-picker"><text>{{actions[actionIndex]}}</text><text>⌄</text></view></picker>
      <block wx:if="{{(detail.FB_CAN_RATE || detail.FB_REVIEW_SCORE) && actionIndex === 0}}">
        <view class="ac-field-label">信誉分审核</view><picker range="{{ratingActions}}" value="{{ratingIndex}}" bindchange="bindRatingAction" disabled="{{busy}}"><view class="ac-form-picker"><text>{{ratingActions[ratingIndex]}}</text><text>⌄</text></view></picker>
        <view wx:if="{{ratingIndex === 1}}" class="ac-rating-box"><view class="ac-rating-stars"><button wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="ac-rating-star {{item <= reviewScore ? 'active' : ''}}" data-score="{{item}}" bindtap="bindReviewScore" disabled="{{busy}}" aria-label="{{item}}星">★</button></view><view class="ac-rating-note">{{reviewScore ? reviewScore + ' 星，对应 ' + ((reviewScore - 3) * 2) + ' 分' : '请选择核实后的星级'}}</view><view class="ac-rating-note">1～5 星分别计 -4 / -2 / 0 / +2 / +4 分。新评分替换原评分。</view></view>
        <view wx:if="{{ratingIndex === 2}}" class="ac-rating-note">撤销后，此条申诉评分不再计入对方信誉分，处理记录仍保留。</view>
      </block>
      <view wx:elif="{{detail.FB_REVIEW_SCORE && actionIndex !== 0}}" class="ac-rating-note">转为继续跟进或不予处理，会撤销此前已生效的评分。</view>
      <view wx:elif="{{!detail.FB_CAN_RATE}}" class="ac-rating-note">未关联明确的订单对方，仅处理反馈，不计入任何用户信誉分。</view>
      <view class="ac-field-label">回复与处理依据 <text class="ac-text-red">*</text></view><textarea value="{{note}}" bindinput="bindNote" maxlength="500" disabled="{{busy}}" placeholder="说明核实情况、处理结果及后续安排" /><view class="ac-counter">{{note.length}} / 500</view><button class="ac-primary" bindtap="bindProcess" loading="{{busy}}" disabled="{{busy || loading || error}}">提交处理结果</button>
    </view>
  </block>
</view>

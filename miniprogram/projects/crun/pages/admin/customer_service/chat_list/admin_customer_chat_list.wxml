<view wx:if="{{isAdmin}}" class="ac-page">
  <view class="ac-breadcrumb"><text class="ac-link" bindtap="bindBack">‹ 管理中心</text><text>/</text><text>客服会话</text></view>
  <view class="ac-heading"><view><view class="ac-title">客服会话</view><view class="ac-subtitle">所有用户的咨询都汇总在这里，谁在线谁接</view></view></view>
  <include src="../../catalog_filters.wxml" />
  <view wx:for="{{list}}" wx:key="_id" class="ac-card ac-conversation" bindtap="url" data-url="../chat_detail/admin_customer_chat_detail?sessionId={{item.CSM_SESSION_ID}}">
    <view class="ac-entry-head"><view class="ac-avatar"><text class="icon-profile"></text></view><view class="ac-entry-main"><view class="ac-entry-title">{{item.USER_NAME}}</view><view class="ac-entry-meta">{{item.lastSender=='user'?'用户咨询':'客服回复'}}{{item.lastStaffName?' · '+item.lastStaffName:''}}</view></view><text class="ac-badge {{item.unread?'red':'muted'}}">{{item.unread?item.unread+' 条未读':'已读'}}</text></view>
    <view class="ac-message-preview ac-clamp">{{item.lastContent || '暂无消息内容'}}</view>
    <view class="ac-conversation-user"><text class="icon-profile"></text><text class="ac-id">{{item.CSM_USER_ID}}</text></view>
    <view class="ac-order-foot"><text>{{item.lastTime}}</text><text class="ac-link">查看对话 ›</text></view>
  </view>
  <include src="../../catalog_footer.wxml" />
</view>

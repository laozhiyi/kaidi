@import "../../../style/skin.wxss";

page {
	background: #f1f6ff;
	color: #252b35;
}

/* 加载态 */
.mail-loading {
	color: #8a98a8;
}

/* ===== 顶部 Tab 切换 ===== */
.order-tab-bar {
	position: sticky;
	top: 0;
	z-index: 30;
	display: flex;
	align-items: stretch;
	height: 96rpx;
	background: #fff;
	box-shadow: 0 4rpx 12rpx rgba(57, 123, 200, .06);
}

.order-tab {
	flex: 1;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 28rpx;
	padding: 0 4rpx;
	white-space: nowrap;
	line-height: 96rpx;
	color: #72819a;
	font-weight: 500;
	transition: color .2s ease;
}

.order-tab.cur {
	color: #397bc8;
	font-weight: 600;
}

.order-tab-indicator {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 25%;
	height: 6rpx;
	background: #397bc8;
	border-radius: 6rpx 6rpx 0 0;
	transition: transform .25s ease;
}

/* ===== 筛选条 ===== */
.order-filter {
	position: sticky;
	top: 96rpx;
	z-index: 25;
	background: #fff;
	border-bottom: 1rpx solid #eef0f3;
	padding: 14rpx 0;
}

.order-filter-scroll {
	width: 100%;
	white-space: nowrap;
	padding: 0 20rpx;
	box-sizing: border-box;
}

.filter-chip {
	display: inline-block;
	padding: 12rpx 28rpx;
	margin-right: 14rpx;
	border-radius: 32rpx;
	background: #f1f4f8;
	font-size: 26rpx;
	line-height: 1.4;
	color: #51607a;
	transition: all .2s ease;
}

.filter-chip.active {
	background: #eaf1fb;
	color: #397bc8;
	font-weight: 600;
	box-shadow: 0 2rpx 8rpx rgba(57, 123, 200, .18);
}

/* 地点筛选 chip 内部布局 */
.phase-chip {
	display: inline-flex;
	align-items: center;
	gap: 6rpx;
}

.phase-caret {
	font-size: 20rpx;
	color: inherit;
	opacity: .7;
	line-height: 1;
}

/* ===== 地点选择弹层 ===== */
.phase-mask {
	position: fixed;
	inset: 0;
	z-index: 200;
	background: rgba(20, 28, 44, .45);
	display: flex;
	align-items: flex-end;
	justify-content: center;
}

.phase-sheet {
	width: 100%;
	max-height: 70vh;
	background: #fff;
	border-radius: 24rpx 24rpx 0 0;
	padding-bottom: env(safe-area-inset-bottom);
	overflow: hidden;
	display: flex;
	flex-direction: column;
}

.phase-sheet-title {
	padding: 28rpx 0 16rpx;
	font-size: 30rpx;
	font-weight: 600;
	color: #1f2a44;
	text-align: center;
	border-bottom: 1rpx solid #f0f1f3;
}

.phase-sheet-list {
	padding: 8rpx 0 24rpx;
	max-height: 56vh;
	overflow-y: auto;
}

.phase-sheet-item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 26rpx 36rpx;
	font-size: 28rpx;
	color: #30353d;
	line-height: 1.4;
	transition: background .15s ease;
}

.phase-sheet-item.active {
	color: #397bc8;
	font-weight: 600;
	background: #f4f8ff;
}

.phase-sheet-label {
	flex: 1;
}

.phase-sheet-check {
	font-size: 30rpx;
	color: #397bc8;
	font-weight: 700;
}

.phase-sheet-cancel {
	margin: 8rpx 24rpx 24rpx;
	padding: 22rpx 0;
	border-radius: 16rpx;
	background: #f1f4f8;
	color: #51607a;
	font-size: 28rpx;
	text-align: center;
	font-weight: 500;
}

/* ===== 列表容器 ===== */
.order-list {
	padding: 20rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
	box-sizing: border-box;
}

/* ===== 订单卡片 ===== */
.order-card {
	margin-bottom: 22rpx;
	padding: 24rpx 26rpx 22rpx;
	background: #fff;
	border-radius: 22rpx;
	box-shadow: 0 8rpx 24rpx rgba(75, 115, 172, .1);
	transition: transform .15s ease;
}

.order-card:active {
	transform: scale(.99);
}

.order-card-hover {
	transform: scale(.99);
	background: #f4f8ff;
}

/* 顶部 */
.card-top {
	display: flex;
	justify-content: space-between;
	align-items: center;
	min-height: 80rpx;
}

.user-info {
	display: flex;
	align-items: center;
	flex: 1;
	min-width: 0;
}

.avatar {
	width: 72rpx;
	height: 72rpx;
	border-radius: 50%;
	background: #eef0f4;
	flex-shrink: 0;
	margin-right: 16rpx;
}

.user-meta {
	flex: 1;
	min-width: 0;
	overflow: hidden;
}

.nick-line {
	display: flex;
	align-items: center;
	font-size: 28rpx;
	font-weight: 600;
	color: #1f2a44;
	line-height: 36rpx;
}

.nick {
	max-width: 240rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.credit {
	margin-left: 12rpx;
	font-size: 22rpx;
	font-weight: 500;
	color: #f0ad3d;
}

.sub {
	margin-top: 4rpx;
	font-size: 22rpx;
	color: #94a3b8;
	line-height: 28rpx;
}

.card-side {
	flex-shrink: 0;
	text-align: right;
	margin-left: 14rpx;
	display: flex;
	flex-direction: column;
	align-items: flex-end;
}

.distance {
	font-size: 26rpx;
	font-weight: 600;
	color: #1989fa;
	line-height: 32rpx;
}

.urgent-tag {
	display: inline-block;
	margin-top: 6rpx;
	padding: 2rpx 14rpx;
	border-radius: 16rpx;
	background: #ff4d4f;
	color: #fff;
	font-size: 20rpx;
	line-height: 28rpx;
	font-weight: 500;
}

.deadline {
	display: block;
	margin-top: 6rpx;
	font-size: 22rpx;
	color: #f56c6c;
	line-height: 28rpx;
}

/* 分隔线 */
.card-divider {
	height: 1rpx;
	background: #f0f1f3;
	margin: 18rpx 0;
}

/* 中部 */
.card-mid {
	padding: 0;
}

.info-row {
	display: flex;
	align-items: flex-start;
	font-size: 26rpx;
	line-height: 38rpx;
	margin-bottom: 8rpx;
}

.info-row:last-child {
	margin-bottom: 0;
}

.info-row .lbl {
	flex-shrink: 0;
	width: 96rpx;
	font-size: 26rpx;
	color: #94a3b8;
}

.info-row .val {
	flex: 1;
	min-width: 0;
	color: #30353d;
	word-break: break-all;
}

.info-row .val.code-text {
	font-family: 'din';
	font-weight: 700;
	font-size: 32rpx;
	color: #397bc8;
	letter-spacing: 2rpx;
}

.info-row .val.ellipsis {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

/* 标签 */
.tag-list {
	display: flex;
	flex-wrap: wrap;
	gap: 10rpx;
	padding-top: 2rpx;
}

.tag {
	display: inline-block;
	padding: 4rpx 14rpx;
	border-radius: 8rpx;
	font-size: 22rpx;
	line-height: 28rpx;
}

.tag.tag-blue {
	background: #eaf1fb;
	color: #397bc8;
}

.tag.tag-orange {
	background: #fff5e6;
	color: #ff7a00;
}

.tag.tag-red {
	background: #ffece6;
	color: #f56c6c;
}

/* 底部 */
.card-bot {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.price-block {
	display: flex;
	align-items: baseline;
	color: #ff4d4f;
}

.price-block .symbol {
	font-size: 26rpx;
	font-weight: 600;
}

.price-block .num {
	font-size: 44rpx;
	font-weight: 700;
	margin-left: 2rpx;
	line-height: 1;
}

.price-block .tip {
	margin-left: 10rpx;
	font-size: 22rpx;
	color: #94a3b8;
}

.price-block.muted {
	color: #94a3b8;
}

.price-block.muted .num {
	color: #94a3b8;
}

.actions {
	display: flex;
	align-items: center;
}

.actions button {
	margin: 0 0 0 14rpx;
	padding: 0;
	height: 60rpx;
	min-height: 60rpx;
	line-height: 60rpx;
	border-radius: 30rpx;
	font-size: 26rpx;
	font-weight: 500;
	box-sizing: border-box;
}

.actions button::after {
	border: 0;
}

.btn-ghost {
	background: #f1f4f8 !important;
	color: #51607a !important;
	border: 0 !important;
	padding: 0 24rpx !important;
}

.btn-primary {
	background: linear-gradient(90deg, #5C9BEA 0%, #397BC8 100%) !important;
	color: #fff !important;
	border: 0 !important;
	padding: 0 32rpx !important;
	font-weight: 600 !important;
	box-shadow: 0 4rpx 14rpx rgba(57, 123, 200, .35);
}

/* 状态标签 */
.status-tag {
	display: inline-block;
	padding: 6rpx 18rpx;
	border-radius: 18rpx;
	font-size: 22rpx;
	line-height: 28rpx;
	font-weight: 500;
}

.status-tag.status-taking {
	background: #eaf1fb;
	color: #397bc8;
}

.status-tag.status-unpaid {
	background: #fff5e6;
	color: #d97706;
}

.status-tag.status-done {
	background: #f0f9f3;
	color: #43a847;
}

/* 已完成卡片 - 弱化 */
.done-card {
	opacity: .85;
}

/* ===== 空态 ===== */
.empty {
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 160rpx 0 80rpx;
}

.empty-img {
	width: 220rpx;
	height: 220rpx;
	opacity: .6;
	margin-bottom: 26rpx;
}

.empty-title {
	font-size: 30rpx;
	font-weight: 600;
	color: #51607a;
	line-height: 42rpx;
}

.empty-sub {
	margin-top: 10rpx;
	font-size: 24rpx;
	color: #94a3b8;
	line-height: 34rpx;
}

/* ===== 悬浮发布按钮 ===== */
.fab-publish {
	position: fixed;
	right: 30rpx;
	bottom: calc(140rpx + env(safe-area-inset-bottom));
	z-index: 40;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	width: 110rpx;
	height: 110rpx;
	border-radius: 50%;
	background: linear-gradient(135deg, #5C9BEA 0%, #397BC8 100%);
	box-shadow: 0 10rpx 24rpx rgba(57, 123, 200, .4);
	transition: transform .15s ease;
}

.fab-publish:active {
	transform: scale(.92);
}

.fab-icon {
	font-size: 44rpx;
	font-weight: 300;
	color: #fff;
	line-height: 1;
}

.fab-text {
	margin-top: 2rpx;
	font-size: 22rpx;
	color: #fff;
	line-height: 1.2;
	font-weight: 500;
}

/* 小屏适配 */
@media (max-width: 360px) {
	.order-tab {
		font-size: 24rpx;
	}

	.order-card {
		padding: 22rpx;
	}

	.avatar {
		width: 64rpx;
		height: 64rpx;
	}

	.info-row .lbl {
		width: 84rpx;
		font-size: 24rpx;
	}

	.price-block .num {
		font-size: 38rpx;
	}

	.actions button {
		padding: 0 22rpx !important;
		font-size: 24rpx;
	}

	.actions .btn-ghost {
		padding-left: 16rpx !important;
		padding-right: 16rpx !important;
	}

	.btn-primary {
		padding: 0 20rpx !important;
	}

	.nick {
		max-width: 180rpx;
	}
}

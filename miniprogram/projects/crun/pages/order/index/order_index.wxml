<!-- 文件级 import：listLoadTpl 模板全局可用 -->
<import src="../../../../../tpls/public/list_load_tpl.wxml" />

<!-- 顶部状态：加载中 / 空数据提示 -->
<view wx:if="{{!isLoad}}" class="mail-loading load loading text-l text-grey"></view>

<!-- 主页面 -->
<block wx:if="{{isLoad}}">

	<!-- 顶部 Tab 切换：可接单 / 我接的 / 已完成 -->
	<view class="order-tab-bar">
		<view class="order-tab {{tabIndex===0?'cur':''}}" data-idx="0" bindtap="bindTabTap">可接单</view>
		<view class="order-tab {{tabIndex===1?'cur':''}}" data-idx="1" bindtap="bindTabTap">我的接单</view>
		<view class="order-tab {{tabIndex===2?'cur':''}}" data-idx="2" bindtap="bindTabTap">我的发布</view>
		<view class="order-tab {{tabIndex===3?'cur':''}}" data-idx="3" bindtap="bindTabTap">已完成</view>
		<view class="order-tab-indicator" style="transform: translateX({{tabIndex*100}}%);"></view>
	</view>
	<view wx:if="{{orderSyncError}}" class="order-fav-error" bindtap="_syncOrders">网络暂不稳定，点击更新订单</view>

	<!-- ===== 筛选条（所有 Tab 共用，条件叠加生效） ===== -->
	<view class="order-filter">
		<scroll-view scroll-x="true" class="order-filter-scroll" enhanced show-scrollbar="{{false}}">
			<view class="filter-chip {{filterActive ? '' : 'active'}}" bindtap="bindFilterReset">全部</view>
			<view class="filter-chip {{filter.price ? 'active' : ''}}" bindtap="bindTogglePrice">高价优先</view>
			<view class="filter-chip {{filter.urgent ? 'active' : ''}}" bindtap="bindToggleUrgent">加急单</view>
			<view class="filter-chip phase-chip {{filter.deliver.length || filter.deliverOther ? 'active' : ''}}" bindtap="bindOpenLocSheet" data-dim="deliver">
				<text>送达地点{{deliverText ? ' · ' + deliverText : ''}}</text>
				<text class="phase-caret">▾</text>
			</view>
			<view class="filter-chip phase-chip {{filter.pickup.length ? 'active' : ''}}" bindtap="bindOpenLocSheet" data-dim="pickup">
				<text>取件地点{{pickupText ? ' · ' + pickupText : ''}}</text>
				<text class="phase-caret">▾</text>
			</view>
		</scroll-view>
	</view>

	<!-- ===== 地点筛选弹层：送达地点 / 取件地点共用 ===== -->
	<view class="phase-mask" wx:if="{{locSheet}}" bindtap="bindCloseLocSheet" catchtouchmove="bindStopProp">
		<view class="phase-sheet {{locTall ? 'phase-sheet-tall' : ''}}" catchtap="bindStopProp">
			<view class="phase-head">
				<view class="phase-head-main">
					<view class="phase-sheet-title">{{locSheet === 'deliver' ? '送达地点' : '取件地点'}}</view>
					<view class="phase-sheet-hint">{{locSheet === 'deliver' ? '和填写收件地址时选的是同一套地点' : '和下单时选的是同一套取件点'}}</view>
				</view>
				<view class="phase-close" bindtap="bindCloseLocSheet">×</view>
			</view>
			<!-- 其他：下单时没选地点、按详细地址送达的订单，始终可见，不用滚到底 -->
			<view wx:if="{{locSheet === 'deliver'}}" class="place-other {{locOther ? 'on' : ''}}" bindtap="bindLocToggleOther">
				<view class="place-other-main">
					<text class="place-other-title">其他</text>
					<text class="place-other-sub">下单时没选地点，按详细地址送达</text>
				</view>
				<view class="place-other-box">{{locOther ? '✓' : ''}}</view>
			</view>
			<!-- 快递公司本来就跟着快递点走，所以按快递点分组，只能选这个点自己的快递 -->
			<view wx:if="{{locSheet === 'pickup'}}" class="phase-tip">每家快递只到固定的快递点，按快递点分组选</view>
			<scroll-view scroll-y class="phase-sheet-list {{locTall ? 'phase-sheet-list-tall' : ''}}" enhanced show-scrollbar="{{false}}">
				<block wx:for="{{locGroups}}" wx:key="key" wx:for-item="group" wx:for-index="gi">
					<view class="place-group-head">
						<text class="place-group-title">{{group.title}}</text>
						<text class="place-group-hint">{{group.hint}}</text>
					</view>
					<view class="place-grid {{locSheet === 'pickup' ? 'place-grid-courier' : ''}}">
						<view wx:for="{{group.items}}" wx:key="value" wx:for-item="opt" wx:for-index="oi"
							class="place-chip {{opt.on ? 'selected' : ''}} {{opt.name ? 'place-chip-dorm' : ''}}"
							data-g="{{gi}}" data-i="{{oi}}" bindtap="bindLocToggle">
							<text class="place-chip-label">{{opt.label}}</text>
							<text wx:if="{{opt.name}}" class="place-chip-name">{{opt.name}}</text>
						</view>
					</view>
				</block>
				<view wx:if="{{!locGroups.length}}" class="place-empty-line">暂无可选{{locSheet === 'deliver' ? '地点' : '取件点'}}</view>
			</scroll-view>
			<view class="phase-foot">
				<view class="place-summary"><text>已选：{{locSummary || '未选择'}}</text><text wx:if="{{locCount}}" class="place-clear" bindtap="bindLocClear">清空</text></view>
				<view class="phase-confirm" bindtap="bindLocConfirm">确定{{locCount ? '（' + locCount + '）' : ''}}</view>
			</view>
		</view>
	</view>

	<!-- ===== 可接单 Tab ===== -->
	<block wx:if="{{tabIndex===0}}">
		<view wx:if="{{favoriteSyncError}}" class="order-fav-error" bindtap="bindRefreshFavorites">收藏数量暂未更新，点击重试</view>

		<cmpt-comm-list id="cmpt-list-take" source='user' type="order-mail-take" search="{{search||''}}" _dataList="{{dataList}}" _params="{{listParams.take}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" placeholder="搜索取件码/地址" bind:list="bindCommListCmpt">

			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover" hover-stay-time="80">

						<!-- 顶部：发单人 + 距离 + 截止 -->
						<view class="card-top">
							<view class="user-info">
								<image class="avatar" src="{{order.MAIL_OBJ.posterPic || '/projects/crun/images/menu/mail.png'}}" mode="aspectFill"></image>
								<view class="user-meta">
									<view class="nick-line">
										<text class="nick">{{order.MAIL_OBJ.poster || '匿名用户'}}</text>
										<text wx:if="{{order.user && order.user.USER_CREDIT}}" class="credit">⭐ {{order.user.USER_CREDIT}}</text>
									</view>
									<text class="sub">已发 {{order.user.MAIL_PUB_CNT || 0}} 单</text>
								</view>
							</view>
							<view class="card-side">
								<text wx:if="{{order.MAIL_OBJ.distance}}" class="distance">{{order.MAIL_OBJ.distance}}km</text>
								<text wx:if="{{order.MAIL_OBJ.urgent}}" class="urgent-tag">加急</text>
								<text wx:if="{{order.MAIL_OBJ.leftSoon}}" class="deadline">剩 {{order.MAIL_OBJ.leftTimeLabel}}</text>
								<text wx:elif="{{order.MAIL_OBJ.expectLabel}}" class="deadline deadline-expect">期望 {{order.MAIL_OBJ.expectLabel}}</text>
								<text wx:else class="deadline">剩 {{order.MAIL_OBJ.leftTimeLabel}}</text>
							</view>
						</view>

						<!-- 分隔线 -->
						<view class="card-divider"></view>

						<!-- 中部：快递信息 -->
						<view class="card-mid">
                            <view class="info-row"><text class="lbl">服务</text><text class="val">{{order.MAIL_CATE_NAME || '快递代取'}}</text></view>
                            <view wx:if="{{order.MAIL_OBJ.serviceType === 'buy'}}" class="info-row"><text class="lbl">商品</text><text class="val">{{order.MAIL_OBJ.goods}} × {{order.MAIL_OBJ.buyQuantity}} · 预算 ¥{{order.MAIL_OBJ.goodsBudget}}</text></view>
							<view class="info-row">
								<text class="lbl">{{order.MAIL_OBJ.serviceType === 'buy' ? '购买点' : order.MAIL_OBJ.serviceType === 'send' ? '取件点' : '快递点'}}</text>
								<text class="val">{{order.MAIL_OBJ.address1}}</text>
							</view>
							<view class="info-row">
								<text class="lbl">送达</text>
								<text class="val">{{order.deliveryAddress || '送达地点待补充'}}</text>
							</view>
							<view wx:if="{{order.MAIL_OBJ.expectLabel}}" class="info-row info-row-expect">
								<text class="lbl">期待送达</text>
								<text class="val expect-val">{{order.MAIL_OBJ.expectLabel}}</text>
							</view>
							<view class="info-row">
								<text wx:if="{{order.MAIL_OBJ.serviceType !== 'buy'}}" class="lbl">类型</text>
								<view wx:if="{{order.MAIL_OBJ.serviceType !== 'buy'}}" class="val package-types">
									<text wx:if="{{order.MAIL_OBJ.small}}" class="package-type package-small">小件×{{order.MAIL_OBJ.small}}</text>
									<text wx:if="{{order.MAIL_OBJ.medium}}" class="package-type package-medium">中件×{{order.MAIL_OBJ.medium}}</text>
									<text wx:if="{{order.MAIL_OBJ.large}}" class="package-type package-large">大件×{{order.MAIL_OBJ.large}}</text>
								</view>
							</view>
							<view wx:if="{{order.MAIL_OBJ.desc}}" class="info-row">
								<text class="lbl">备注</text>
								<text class="val ellipsis">{{order.MAIL_OBJ.desc}}</text>
							</view>
						</view>

						<!-- 分隔线 -->
						<view class="card-divider"></view>

						<!-- 底部：金额 + 操作 -->
						<view class="card-bot">
							<view class="price-block">
								<text class="symbol">¥</text>
								<text class="num">{{order.MAIL_OBJ.price}}</text>
								<text class="tip">{{order.MAIL_OBJ.serviceType === 'buy' ? '跑腿费' : '含打赏'}}</text>
							</view>
							<view class="actions" catchtap="bindStop">
								<button class="btn-ghost btn-fav {{order.MAIL_IS_FAV ? 'saved' : ''}}" catchtap="bindFavoriteTap" data-id="{{order._id}}" disabled="{{!!favoriteBusyId || (!order.MAIL_IS_FAV && order.MAIL_CAN_FAV === false)}}" loading="{{favoriteBusyId === order._id}}" aria-label="{{order.MAIL_IS_FAV ? '取消收藏订单' : '收藏订单'}}">{{order.MAIL_IS_FAV ? '已收藏' : '收藏'}}({{order.MAIL_FAV_CNT || 0}})</button>
								<button class="btn-ghost" catchtap="bindDetailTap" data-id="{{order._id}}">详情</button>
								<button class="btn-primary" catchtap="bindAcceptTap" data-id="{{order._id}}" data-idx="{{index}}" loading="{{acceptingId === order._id}}" disabled="{{!!acceptingId || order.MAIL_CAN_FAV === false}}" hover-stay-time="80">{{acceptingId === order._id ? '接单中' : order.MAIL_CAN_FAV === false ? '已不可接单' : '立即接单'}}</button>
							</view>
						</view>

					</view>
				</view>

				<!-- 空态 -->
				<view wx:elif="{{dataList && !dataList.error && dataList.total === 0}}" class="empty">
					<image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image>
					<view class="empty-title">附近暂无订单</view>
					<view class="empty-sub">下拉刷新看看，或调整筛选条件</view>
				</view>

				<!-- 加载态/到底 -->
				<template is="listLoadTpl" data="{{dataList,skin:'load-project'}}" />
			</block>

		</cmpt-comm-list>

	</block>

	<!-- ===== 我接的 Tab ===== -->
	<block wx:elif="{{tabIndex===1}}">
		<cmpt-comm-list id="cmpt-list-mine" source="user" type="order-mail-mine" search="{{search||''}}" _dataList="{{dataList}}" _params="{{listParams.mine}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" bind:list="bindCommListCmpt">
			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover">
						<view class="card-top">
							<view class="user-info"><image class="avatar" src="{{order.MAIL_OBJ.posterPic || '/projects/crun/images/menu/mail.png'}}" mode="aspectFill"></image><view class="user-meta"><view class="nick-line"><text class="nick">{{order.MAIL_OBJ.poster || '匿名用户'}}</text></view><text class="sub">期望 {{order.expect2 || order.end2 || '未设置'}}</text></view></view>
							<view class="card-side"><text class="status-tag status-taking">{{order.status || '已接单'}}</text></view>
						</view>
						<view class="card-divider"></view>
						<view wx:if="{{order.showProgress}}" class="card-progress"><view wx:for="{{order.progressSteps}}" wx:key="index" wx:for-item="step" class="progress-step {{step.done ? 'progress-step-active' : ''}}"><view class="progress-dot"></view><text>{{step.displayLabel}}</text></view></view>
						<view class="card-mid">
                            <view class="info-row"><text class="lbl">服务</text><text class="val">{{order.MAIL_CATE_NAME || '快递代取'}}</text></view>
                            <view wx:if="{{order.MAIL_OBJ.serviceType === 'buy'}}" class="info-row"><text class="lbl">商品</text><text class="val">{{order.MAIL_OBJ.goods}} × {{order.MAIL_OBJ.buyQuantity}} · 预算 ¥{{order.MAIL_OBJ.goodsBudget}}</text></view>
							<view class="package-proofs" wx:if="{{order.packageProofs.length && order.MAIL_OBJ.serviceType !== 'buy'}}"><view wx:for="{{order.packageProofs}}" wx:key="index" class="package-proof-item"><view class="info-row"><text class="lbl">取件点</text><text class="val">{{item.pickupPoint}}</text></view><view class="package-proof-row"><text class="lbl">{{order.MAIL_OBJ.serviceType === 'send' ? '物品' : '取件码'}}</text><text class="val code-text">{{item.code}}</text><text class="package-note-label">{{item.noteLabel}}</text></view></view></view>
							<view wx:else class="info-row"><text class="lbl">{{order.MAIL_OBJ.serviceType === 'buy' ? '购买点' : order.MAIL_OBJ.serviceType === 'send' ? '取件点' : '快递点'}}</text><text class="val">{{order.MAIL_OBJ.address1}}</text></view>
							<view class="info-row"><text class="lbl">送达</text><text class="val">{{order.deliveryAddress || '送达地点待补充'}}</text></view>
						</view>
						<view class="card-divider"></view>
						<view class="card-bot"><view class="price-block"><text class="symbol">¥</text><text class="num">{{order.MAIL_OBJ.price}}</text></view><view class="actions" catchtap="bindStop"><button class="btn-ghost" catchtap="bindCallTap" data-tel="{{order.MAIL_OBJ.tel}}">联系</button><button class="btn-ghost" catchtap="bindComplaintTap" data-id="{{order._id}}">申诉</button><button wx:if="{{order.MAIL_STATUS===1}}" class="btn-primary" catchtap="bindOrderAction" data-action="pickup" data-id="{{order._id}}" loading="{{actionBusyId === order._id}}" disabled="{{!!actionBusyId}}">{{order.MAIL_OBJ.serviceType === 'buy' ? '已购齐' : '已取件'}}</button><button wx:elif="{{order.MAIL_STATUS===4}}" class="btn-primary" catchtap="bindOrderAction" data-action="deliver" data-id="{{order._id}}" loading="{{actionBusyId === order._id}}" disabled="{{!!actionBusyId}}">已送达</button><button wx:elif="{{order.MAIL_STATUS===2}}" class="btn-ghost" catchtap="bindDetailTap" data-id="{{order._id}}">待收货</button></view></view>
					</view>
				</view>
				<view wx:elif="{{dataList && !dataList.error && dataList.total === 0}}" class="empty"><image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image><view class="empty-title">还没有接过的订单</view><view class="empty-sub">切到「可接单」看看新订单吧</view></view>
				<template is="listLoadTpl" data="{{dataList,skin:'load-project'}}" />
			</block>
		</cmpt-comm-list>
	</block>
	<!-- ===== 我发布的 Tab ===== -->
	<block wx:elif="{{tabIndex===2}}">
		<cmpt-comm-list id="cmpt-list-posted" source='user' type="order-mail-posted" search="{{search||''}}" _dataList="{{dataList}}" _params="{{listParams.posted}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" bind:list="bindCommListCmpt">
			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover">
						<view class="card-top">
							<view class="user-info">
								<image class="avatar" src="/projects/crun/images/menu/mail.png" mode="aspectFill"></image>
								<view class="user-meta"><view class="nick-line"><text class="nick">{{order.MAIL_OBJ.title || '快递代取'}}</text></view><text class="sub">{{order.MAIL_ADD_TIME}}</text></view>
							</view>
							<text class="status-tag status-taking">{{order.status || '待接单'}}</text>
						</view>
						<view class="card-divider"></view>
						<view class="card-mid">
                            <view class="info-row"><text class="lbl">服务</text><text class="val">{{order.MAIL_CATE_NAME || '快递代取'}}</text></view>
                            <view wx:if="{{order.MAIL_OBJ.serviceType === 'buy'}}" class="info-row"><text class="lbl">商品</text><text class="val">{{order.MAIL_OBJ.goods}} × {{order.MAIL_OBJ.buyQuantity}} · 预算 ¥{{order.MAIL_OBJ.goodsBudget}}</text></view>
							<view class="info-row"><text class="lbl">{{order.MAIL_OBJ.serviceType === 'buy' ? '购买点' : order.MAIL_OBJ.serviceType === 'send' ? '取件点' : '快递点'}}</text><text class="val">{{order.MAIL_OBJ.address1}}</text></view>
							<view class="info-row"><text class="lbl">送达</text><text class="val">{{order.deliveryAddress || '送达地点待补充'}}</text></view>
						</view>
						<view class="card-divider"></view>
						<view class="card-bot">
							<view class="price-block"><text class="symbol">¥</text><text class="num">{{order.MAIL_OBJ.price}}</text></view>
							<view class="actions" catchtap="bindStop">
								<button class="btn-ghost" catchtap="bindDetailTap" data-id="{{order._id}}">查看详情</button>
								<button wx:if="{{order.receipt.visible}}" class="btn-primary" catchtap="bindConfirmReceiptTap" data-id="{{order._id}}" loading="{{confirmingId === order._id}}" disabled="{{confirmingId !== ''}}">确认收货</button>
							</view>
						</view>
						<view wx:if="{{order.receipt.visible}}" class="receipt-hint">{{order.receipt.hint}}</view>
					</view>
				</view>
				<view wx:elif="{{dataList && !dataList.error && dataList.total === 0}}" class="empty"><image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image><view class="empty-title">还没有发布过订单</view><view class="empty-sub">可前往首页填写并发布订单</view></view>
				<template is="listLoadTpl" data="{{dataList,skin:'load-project'}}" />
			</block>
		</cmpt-comm-list>
	</block>

	<!-- ===== 已完成 Tab ===== -->
	<block wx:else>
		<cmpt-comm-list id="cmpt-list-done" source='user' type="order-mail-done" search="{{search||''}}" _dataList="{{dataList}}" _params="{{listParams.done}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" bind:list="bindCommListCmpt">

			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project done-card" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover" hover-stay-time="80">
						<view class="card-top">
							<view class="user-info">
								<image class="avatar" src="{{order.MAIL_OBJ.posterPic || '/projects/crun/images/menu/mail.png'}}" mode="aspectFill"></image>
								<view class="user-meta">
									<view class="nick-line">
										<text class="nick">{{order.MAIL_OBJ.poster || '匿名用户'}}</text>
									</view>
									<text class="sub">{{order.MAIL_OVER_TIME}}</text>
								</view>
							</view>
							<view class="card-side">
								<text class="status-tag status-done">已完成</text>
							</view>
						</view>
						<view class="card-divider"></view>
						<view class="card-mid">
                            <view class="info-row"><text class="lbl">服务</text><text class="val">{{order.MAIL_CATE_NAME || '快递代取'}}</text></view>
                            <view wx:if="{{order.MAIL_OBJ.serviceType === 'buy'}}" class="info-row"><text class="lbl">商品</text><text class="val">{{order.MAIL_OBJ.goods}} × {{order.MAIL_OBJ.buyQuantity}} · 预算 ¥{{order.MAIL_OBJ.goodsBudget}}</text></view>
							<view class="info-row">
								<text class="lbl">{{order.MAIL_OBJ.serviceType === 'buy' ? '购买点' : order.MAIL_OBJ.serviceType === 'send' ? '取件点' : '快递点'}}</text>
								<text class="val">{{order.MAIL_OBJ.address1}}</text>
							</view>
							<view class="info-row">
								<text class="lbl">送达</text>
								<text class="val">{{order.deliveryAddress || '送达地点待补充'}}</text>
							</view>
						</view>
						<view class="card-divider"></view>
						<view class="card-bot">
							<view class="price-block muted">
								<text class="symbol">¥</text>
								<text class="num">{{order.MAIL_OBJ.price}}</text>
							</view>
							<view class="actions" catchtap="bindStop">
								<button class="btn-ghost" catchtap="bindDetailTap" data-id="{{order._id}}">查看详情</button>
								<button wx:if="{{order.MAIL_CAN_REVIEW || order.MAIL_REVIEWED}}" class="{{order.MAIL_REVIEWED ? 'btn-ghost' : 'btn-primary'}}" catchtap="bindReviewTap" data-id="{{order._id}}">{{order.MAIL_REVIEWED ? '已评价' : '评价对方'}}</button>
							</view>
						</view>
					</view>
				</view>

				<view wx:elif="{{dataList && !dataList.error && dataList.total === 0}}" class="empty">
					<image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image>
					<view class="empty-title">还没有完成的订单</view>
					<view class="empty-sub">加油赚配送费～</view>
				</view>


<!-- 文件级 import：listLoadTpl 模板全局可用 -->
<import src="../../../../../tpls/public/list_load_tpl.wxml" />

<!-- 顶部状态：加载中 / 空数据提示 -->
<view wx:if="{{!isLoad}}" class="mail-loading load loading text-l text-grey"></view>

<!-- 主页面 -->
<block wx:if="{{isLoad}}">

	<!-- 顶部 Tab 切换：可接单 / 我接的 / 已完成 -->
	<view class="order-tab-bar">
		<view class="order-tab {{tabIndex===0?'cur':''}}" data-idx="0" bindtap="bindTabTap">可接单</view>
		<view class="order-tab {{tabIndex===1?'cur':''}}" data-idx="1" bindtap="bindTabTap">我接的</view>
		<view class="order-tab {{tabIndex===2?'cur':''}}" data-idx="2" bindtap="bindTabTap">我发布的</view>
		<view class="order-tab {{tabIndex===3?'cur':''}}" data-idx="3" bindtap="bindTabTap">已完成</view>
		<view class="order-tab-indicator" style="transform: translateX({{tabIndex*100}}%);"></view>
	</view>

	<!-- ===== 可接单 Tab ===== -->
	<block wx:if="{{tabIndex===0}}">
		<!-- 筛选条 -->
		<view class="order-filter">
			<scroll-view scroll-x="true" class="order-filter-scroll" enhanced show-scrollbar="{{false}}">
				<view class="filter-chip {{sortVal===''?'active':''}}" bindtap="bindSortTap" data-type="" data-val="">全部</view>
				<view class="filter-chip {{sortVal==='price_desc'?'active':''}}" bindtap="bindSortTap" data-type="sort" data-val="price_desc">高价优先</view>
				<view class="filter-chip {{sortVal==='urgent'?'active':''}}" bindtap="bindSortTap" data-type="urgent" data-val="urgent">加急单</view>
				<view class="filter-chip phase-chip {{phaseVal?'active':''}}" bindtap="bindOpenPhasePicker">
					<text>地点{{phaseVal ? ' · ' + phaseVal : ''}}</text>
					<text class="phase-caret">▾</text>
				</view>
			</scroll-view>
		</view>

		<!-- 地点选择弹层 -->
		<view class="phase-mask" wx:if="{{phasePickerVisible}}" bindtap="bindClosePhasePicker" catchtouchmove="bindStopProp">
			<view class="phase-sheet" catchtap="bindStopProp">
				<view class="phase-sheet-title">选择地点</view>
				<view class="phase-sheet-list">
					<view wx:for="{{phaseOptions}}" wx:key="value" class="phase-sheet-item {{phaseVal===item.value?'active':''}}" data-value="{{item.value}}" data-label="{{item.label}}" bindtap="bindPhaseSelect">
						<text class="phase-sheet-label">{{item.label}}</text>
						<text wx:if="{{phaseVal===item.value}}" class="phase-sheet-check">✓</text>
					</view>
				</view>
				<view class="phase-sheet-cancel" bindtap="bindClosePhasePicker">取消</view>
			</view>
		</view>

		<cmpt-comm-list id="cmpt-list-take" source='user' type="order-mail-take" search="{{search||''}}" _params="{{listParams.take}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" placeholder="搜索取件码/地址" bind:list="bindCommListCmpt">

			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover" hover-stay-time="80">

						<!-- 顶部：发单人 + 距离 + 截止 -->
						<view class="card-top">
							<view class="user-info">
								<image class="avatar" src="{{order.MAIL_OBJ.posterPic || '/projects/crun/images/menu/mail.png'}}" mode="aspectFill"></image>
								<view class="user-meta">
									<view class="nick-line">
										<text class="nick">{{order.MAIL_OBJ.poster || '匿名用户'}}</text>
										<text wx:if="{{order.user && order.user.USER_CREDIT}}" class="credit">⭐ {{order.user.USER_CREDIT}}</text>
									</view>
									<text class="sub">已发 {{order.user.MAIL_PUB_CNT || 0}} 单</text>
								</view>
							</view>
							<view class="card-side">
								<text wx:if="{{order.MAIL_OBJ.distance}}" class="distance">{{order.MAIL_OBJ.distance}}km</text>
								<text wx:if="{{order.MAIL_OBJ.urgent}}" class="urgent-tag">加急</text>
								<text class="deadline">剩 {{order.MAIL_OBJ.leftTimeLabel}}</text>
							</view>
						</view>

						<!-- 分隔线 -->
						<view class="card-divider"></view>

						<!-- 中部：快递信息 -->
						<view class="card-mid">
							<view class="info-row">
								<text class="lbl">快递点</text>
								<text class="val">{{order.MAIL_OBJ.address1}}</text>
							</view>
							<view class="info-row">
								<text class="lbl">送达</text>
								<text class="val">{{order.MAIL_OBJ.address2}}</text>
							</view>
							<view class="info-row">
								<text class="lbl">类型</text>
								<view class="val tag-list">
									<text wx:if="{{order.MAIL_OBJ.small}}" class="tag tag-blue">小件×{{order.MAIL_OBJ.small}}</text>
									<text wx:if="{{order.MAIL_OBJ.medium}}" class="tag tag-orange">中件×{{order.MAIL_OBJ.medium}}</text>
									<text wx:if="{{order.MAIL_OBJ.large}}" class="tag tag-red">大件×{{order.MAIL_OBJ.large}}</text>
								</view>
							</view>
							<view wx:if="{{order.MAIL_OBJ.desc}}" class="info-row">
								<text class="lbl">备注</text>
								<text class="val ellipsis">{{order.MAIL_OBJ.desc}}</text>
							</view>
						</view>

						<!-- 分隔线 -->
						<view class="card-divider"></view>

						<!-- 底部：金额 + 操作 -->
						<view class="card-bot">
							<view class="price-block">
								<text class="symbol">¥</text>
								<text class="num">{{order.MAIL_OBJ.price}}</text>
								<text class="tip">含打赏</text>
							</view>
							<view class="actions" catchtap="bindStop">
								<button class="btn-ghost" catchtap="bindDetailTap" data-id="{{order._id}}">详情</button>
								<button class="btn-primary" catchtap="bindAcceptTap" data-id="{{order._id}}" data-idx="{{index}}">立即接单</button>
							</view>
						</view>

					</view>
				</view>

				<!-- 空态 -->
				<view wx:elif="{{dataList && dataList.total === 0}}" class="empty">
					<image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image>
					<view class="empty-title">附近暂无订单</view>
					<view class="empty-sub">下拉刷新看看，或调整筛选条件</view>
				</view>

				<!-- 加载态/到底 -->
				<template is="listLoadTpl" data="{{dataList,skin:'load-project'}}" />
			</block>

		</cmpt-comm-list>

		<!-- 悬浮发布按钮 -->
		<view class="fab-publish" bindtap="bindPublishTap">
			<text class="fab-icon">+</text>
			<text class="fab-text">发布</text>
		</view>
	</block>

	<!-- ===== 我接的 Tab ===== -->
	<block wx:elif="{{tabIndex===1}}">
		<cmpt-comm-list id="cmpt-list-mine" source='user' type="order-mail-mine" search="{{search||''}}" _params="{{listParams.mine}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" bind:list="bindCommListCmpt">

			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover" hover-stay-time="80">
						<view class="card-top">
							<view class="user-info">
								<image class="avatar" src="{{order.MAIL_OBJ.posterPic || '/projects/crun/images/menu/mail.png'}}" mode="aspectFill"></image>
								<view class="user-meta">
									<view class="nick-line">
										<text class="nick">{{order.MAIL_OBJ.poster || '匿名用户'}}</text>
									</view>
									<text class="sub">{{order.MAIL_OBJ.tel || '联系方式接单后可见'}}</text>
								</view>
							</view>
							<view class="card-side">
								<text class="status-tag status-taking">{{order.status || '待取件'}}</text>
							</view>
						</view>
						<view class="card-divider"></view>
						<view class="card-mid">
							<view class="info-row">
								<text class="lbl">取件码</text>
								<text class="val code-text">{{order.MAIL_OBJ.code}}</text>
							</view>
							<view class="info-row">
								<text class="lbl">快递点</text>
								<text class="val">{{order.MAIL_OBJ.address1}}</text>
							</view>
							<view class="info-row">
								<text class="lbl">送达</text>
								<text class="val">{{order.MAIL_OBJ.address2}}</text>
							</view>
						</view>
						<view class="card-divider"></view>
						<view class="card-bot">
							<view class="price-block">
								<text class="symbol">¥</text>
								<text class="num">{{order.MAIL_OBJ.price}}</text>
							</view>
							<view class="actions" catchtap="bindStop">
								<button class="btn-ghost" catchtap="bindCallTap" data-tel="{{order.MAIL_OBJ.tel}}">联系</button>
								<button class="btn-primary" catchtap="bindOverTap" data-id="{{order._id}}" data-idx="{{index}}">完成</button>
							</view>
						</view>
					</view>
				</view>

				<view wx:elif="{{dataList && dataList.total === 0}}" class="empty">
					<image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image>
					<view class="empty-title">还没有接过的订单</view>
					<view class="empty-sub">切到「可接单」看看新订单吧</view>
				</view>

				<template is="listLoadTpl" data="{{dataList,skin:'load-project'}}" />
			</block>

		</cmpt-comm-list>
	</block>

	<!-- ===== 我发布的 Tab ===== -->
	<block wx:elif="{{tabIndex===2}}">
		<cmpt-comm-list id="cmpt-list-posted" source='user' type="order-mail-posted" search="{{search||''}}" _params="{{listParams.posted}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" bind:list="bindCommListCmpt">
			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover">
						<view class="card-top">
							<view class="user-info">
								<image class="avatar" src="/projects/crun/images/menu/mail.png" mode="aspectFill"></image>
								<view class="user-meta"><view class="nick-line"><text class="nick">{{order.MAIL_OBJ.title || '快递代取'}}</text></view><text class="sub">{{order.MAIL_ADD_TIME}}</text></view>
							</view>
							<text class="status-tag {{order.MAIL_PAY_STATUS===0 ? 'status-unpaid' : 'status-taking'}}">{{order.MAIL_PAY_STATUS===0 ? '待支付' : (order.status || '待接单')}}</text>
						</view>
						<view class="card-divider"></view>
						<view class="card-mid">
							<view class="info-row"><text class="lbl">快递点</text><text class="val">{{order.MAIL_OBJ.address1}}</text></view>
							<view class="info-row"><text class="lbl">送达</text><text class="val">{{order.MAIL_OBJ.address2}}</text></view>
						</view>
						<view class="card-divider"></view>
						<view class="card-bot"><view class="price-block"><text class="symbol">¥</text><text class="num">{{order.MAIL_OBJ.price}}</text></view><view class="actions"><button class="btn-ghost" catchtap="bindDetailTap" data-id="{{order._id}}">查看详情</button><button wx:if="{{order.MAIL_PAY_STATUS===0 && order.MAIL_TOTAL_FEE>0}}" class="btn-primary" catchtap="bindPayTap" data-id="{{order._id}}" data-index="{{index}}">去支付</button></view></view>
					</view>
				</view>
				<view wx:elif="{{dataList && dataList.total === 0}}" class="empty"><image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image><view class="empty-title">还没有发布过订单</view><view class="empty-sub">点击右下角发布一个新订单</view></view>
				<template is="listLoadTpl" data="{{dataList,skin:'load-project'}}" />
			</block>
		</cmpt-comm-list>
	</block>

	<!-- ===== 已完成 Tab ===== -->
	<block wx:else>
		<cmpt-comm-list id="cmpt-list-done" source='user' type="order-mail-done" search="{{search||''}}" _params="{{listParams.done}}" route="mail/list" isTotalMenu="{{false}}" showSearch="{{false}}" topBottom="120" bind:list="bindCommListCmpt">

			<block>
				<view class="order-list" wx:if="{{dataList && dataList.list && dataList.list.length}}">
					<view wx:for="{{dataList.list}}" wx:key="_id" wx:for-item="order" class="order-card shadow card-project done-card" bindtap="bindDetailTap" data-id="{{order._id}}" hover-class="order-card-hover" hover-stay-time="80">
						<view class="card-top">
							<view class="user-info">
								<image class="avatar" src="{{order.MAIL_OBJ.posterPic || '/projects/crun/images/menu/mail.png'}}" mode="aspectFill"></image>
								<view class="user-meta">
									<view class="nick-line">
										<text class="nick">{{order.MAIL_OBJ.poster || '匿名用户'}}</text>
									</view>
									<text class="sub">{{order.MAIL_OVER_TIME}}</text>
								</view>
							</view>
							<view class="card-side">
								<text class="status-tag status-done">已完成</text>
							</view>
						</view>
						<view class="card-divider"></view>
						<view class="card-mid">
							<view class="info-row">
								<text class="lbl">快递点</text>
								<text class="val">{{order.MAIL_OBJ.address1}}</text>
							</view>
							<view class="info-row">
								<text class="lbl">送达</text>
								<text class="val">{{order.MAIL_OBJ.address2}}</text>
							</view>
						</view>
						<view class="card-divider"></view>
						<view class="card-bot">
							<view class="price-block muted">
								<text class="symbol">¥</text>
								<text class="num">{{order.MAIL_OBJ.price}}</text>
							</view>
							<view class="actions" catchtap="bindStop">
								<button class="btn-ghost" catchtap="bindDetailTap" data-id="{{order._id}}">查看详情</button>
							</view>
						</view>
					</view>
				</view>

				<view wx:elif="{{dataList && dataList.total === 0}}" class="empty">
					<image class="empty-img" src="/projects/crun/images/follow/bag.png" mode="aspectFit"></image>
					<view class="empty-title">还没有完成的订单</view>
					<view class="empty-sub">加油赚配送费～</view>
				</view>

				<template is="listLoadTpl" data="{{dataList,skin:'load-project'}}" />
			</block>

		</cmpt-comm-list>
	</block>

</block>

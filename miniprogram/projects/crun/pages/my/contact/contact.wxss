page{background:#f4f7fb}.profile-page{min-height:100vh;padding:28rpx 24rpx;box-sizing:border-box}.profile-hero{padding:30rpx;background:linear-gradient(135deg,#397bc8,#6aa7eb);border-radius:24rpx;color:#fff}.profile-title{font-size:38rpx;font-weight:700}.profile-desc{margin-top:10rpx;font-size:24rpx;opacity:.88}.profile-section{margin-top:20rpx;padding:26rpx;background:#fff;border-radius:20rpx}.profile-section-title-row{display:flex;justify-content:space-between;align-items:center}.profile-section-title{font-size:31rpx;font-weight:600;color:#24334b}.profile-add-button{margin:0;color:#397bc8;background:#edf5ff;border:0;border-radius:30rpx;font-size:23rpx}.profile-add-button::after,.save::after{border:0}.default{margin-left:10rpx;color:#397bc8;font-size:21rpx}.save{margin-top:22rpx;background:#397bc8;color:#fff;border-radius:40rpx}.tab-bar-placeholder{height:124rpx}.profile-editor input{height:76rpx;margin-top:12rpx;padding:0 16rpx;background:#f5f8fc;border-radius:12rpx;box-sizing:border-box}

.profile-editor-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.profile-editor-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: auto;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 0;
  border-radius: 16rpx;
  color: #62748b;
  background: #f0f4f9;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  transition: background-color .18s ease, box-shadow .18s ease;
}

.profile-editor-actions button::after {
  border: 0;
}

.profile-editor-actions .primary {
  flex: 1.6;
  color: #fff;
  background: #397bc8;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(57, 123, 200, .16);
}

.profile-editor-actions button.button-hover {
  background: #e5ebf3;
  opacity: 1;
}

.profile-editor-actions .primary.button-hover {
  background: #316caf;
  box-shadow: 0 2rpx 6rpx rgba(57, 123, 200, .12);
}
.profile-editor-actions button[disabled] { opacity:.55; }
.profile-save-error { margin-top:18rpx; color:#b87539; font-size:24rpx; text-align:center; }
.profile-retry { height:80rpx; margin-top:16rpx; border-radius:14rpx; color:#397bc8; background:#edf5ff; font-size:26rpx; line-height:80rpx; }
.profile-retry::after { border:0; }

.profile-item-list{margin-top:18rpx}.profile-item-card{display:flex;align-items:center;padding:20rpx;margin-top:14rpx;border:1rpx solid #e5edf6;border-radius:18rpx}.profile-item-main{flex:1;min-width:0}.profile-item-title{font-size:28rpx;font-weight:600}.profile-item-detail{margin-top:7rpx;color:#6f8097;font-size:24rpx}.profile-item-actions{display:flex;gap:16rpx;margin-left:12rpx;color:#397bc8;font-size:22rpx}.danger{color:#e06b6b}.profile-empty{text-align:center;color:#a0adbc;padding:28rpx}.profile-section-title-row + .profile-item-list{margin-top:4rpx}

@import "../edit/my_edit.wxss";
page{background:#f4f7fb}.profile-page{min-height:100vh;padding:28rpx 24rpx;box-sizing:border-box}.profile-hero{padding:30rpx;background:linear-gradient(135deg,#397bc8,#6aa7eb);border-radius:24rpx;color:#fff}.profile-title{font-size:38rpx;font-weight:700}.profile-desc{margin-top:10rpx;font-size:24rpx;opacity:.88}.profile-section{margin-top:20rpx;padding:26rpx;background:#fff;border-radius:20rpx}.profile-section-title-row{display:flex;justify-content:space-between;align-items:center}.profile-section-title{font-size:31rpx;font-weight:600;color:#24334b}.profile-add-button{margin:0;color:#397bc8;background:#edf5ff;border:0;border-radius:30rpx;font-size:23rpx}.profile-add-button::after,.save::after{border:0}.default{margin-left:10rpx;color:#397bc8;font-size:21rpx}.save{margin-top:22rpx;background:#397bc8;color:#fff;border-radius:40rpx}.tab-bar-placeholder{height:124rpx}.profile-editor input{height:76rpx;margin-top:12rpx;padding:0 16rpx;background:#f5f8fc;border-radius:12rpx;box-sizing:border-box}.profile-editor-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:16rpx}.profile-editor-actions button{margin:0}.profile-editor-actions .primary{color:#fff;background:#397bc8}.profile-item-list{margin-top:18rpx}.profile-item-card{display:flex;align-items:center;padding:20rpx;margin-top:14rpx;border:1rpx solid #e5edf6;border-radius:18rpx}.profile-item-main{flex:1;min-width:0}.profile-item-title{font-size:28rpx;font-weight:600}.profile-item-detail{margin-top:7rpx;color:#6f8097;font-size:24rpx}.profile-item-actions{display:flex;gap:16rpx;margin-left:12rpx;color:#397bc8;font-size:22rpx}.danger{color:#e06b6b}.profile-empty{text-align:center;color:#a0adbc;padding:28rpx}.profile-section-title-row + .profile-item-list{margin-top:4rpx}
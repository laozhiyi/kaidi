<view wx:if="{{isLoad}}" class="profile-page">
  <view class="profile-hero"><view class="profile-title">常用联系人</view><view class="profile-desc">发布订单时可快速选择联系人</view></view>
  <view class="profile-section"><view class="profile-section-title-row"><view class="profile-section-title">联系人</view><button class="profile-add-button" bindtap="bindAddContact">+ 添加</button></view>
    <view wx:if="{{contacts.length}}" class="profile-item-list"><view wx:for="{{contacts}}" wx:key="index" class="profile-item-card"><view class="profile-item-main"><view class="profile-item-title">{{item.name}} <text wx:if="{{item.isDefault}}" class="default">默认</text></view><view class="profile-item-detail">{{item.phone}}</view></view><view class="profile-item-actions"><text bindtap="bindSetDefaultContact" data-index="{{index}}">设默认</text><text bindtap="bindEditContact" data-index="{{index}}">编辑</text><text class="danger" bindtap="bindDeleteContact" data-index="{{index}}">删除</text></view></view></view><view wx:else class="profile-empty">暂无常用联系人</view>
    <view wx:if="{{contactEditorVisible}}" class="profile-editor"><input value="{{contactDraft.name}}" placeholder="联系人姓名" bindinput="bindContactInput" data-field="name"/><input value="{{contactDraft.phone}}" type="number" placeholder="手机号码" bindinput="bindContactInput" data-field="phone"/><view class="profile-editor-actions"><button bindtap="bindCancelContact">取消</button><button class="primary" bindtap="bindSaveContact">保存</button></view></view>
  </view><button class="save" bindtap="bindSubmitTap">保存联系人</button><view class="tab-bar-placeholder"></view>
</view>
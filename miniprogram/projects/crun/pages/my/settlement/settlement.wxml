<view class="settlement-page">
 <view wx:if="{{statusLoading}}" class="settlement-card settlement-state">
  <view class="settlement-loader" aria-hidden="{{true}}"></view>
  <view class="settlement-card-title">正在加载结算信息…</view>
  <view class="settlement-card-desc">请稍候</view>
 </view>
 <view wx:elif="{{statusError || !account}}" class="settlement-card settlement-state">
  <view class="settlement-card-title">结算信息加载失败</view>
  <view class="settlement-card-desc">{{statusError || '请重新加载结算信息'}}</view>
  <button class="settlement-submit settlement-retry" bindtap="bindRetryStatus">重新加载</button>
 </view>
 <block wx:else>
 <view class="settlement-status">
  <view class="settlement-status-icon"><text class="icon-moneybag"></text></view>
  <view class="settlement-status-copy"><view class="settlement-title">{{account.opened ? '跑腿结算' : '开通跑腿结算'}}</view><view class="settlement-subtitle">{{account.opened ? '收益按支付机构规则结算至银行卡' : '完成开通，管理跑腿收益'}}</view></view>
  <text class="settlement-badge">{{account.opened ? '已开通' : account.pending ? '待核对' : account.identified ? '待绑卡' : '待开通'}}</text>
 </view>
 <view class="settlement-card settlement-key-terms"><view class="settlement-card-title">报酬与到账说明</view><view class="settlement-hint">骑手90%、平台10%；支付及结算手续费由平台承担，不另收提现手续费。</view><view class="settlement-hint">发布者确认收货，或送达满8小时自动确认后，报酬进入支付机构结算流程。</view><view class="settlement-hint">银行卡不会立即到账。符合结算条件的款项，会按账户安排在次日或下一个工作日分批打款；遇周末或法定节假日，部分账户会顺延。具体到账时间以支付机构和银行处理为准。</view></view>
 <view class="settlement-notice"><text class="icon-info"></text><text>请使用本人信息申请，结算账户用于接收跑腿服务报酬。</text></view>

 <view wx:if="{{!account.opened && account.pending}}" class="settlement-card settlement-pending">
  <view class="settlement-card-title">上次办理结果确认中</view>
  <view class="settlement-card-desc">支付机构还未返回明确结果。请稍后刷新；如需修改填写内容，直接重新提交即可，系统会先向支付机构核对。</view>
  <button class="settlement-link-button" bindtap="bindRetryStatus" disabled="{{submitting}}">刷新办理结果</button>
 </view>
 <view wx:if="{{account.opened}}" class="settlement-card">
  <view class="settlement-card-title">结算账户已开通</view>
  <view class="settlement-card-desc">{{account.name}} · 银行卡尾号 {{account.cardTail}}</view>
  <view wx:if="{{boundAtText}}" class="settlement-card-desc">绑定时间 {{boundAtText}}</view>
  <view class="settlement-hint">报酬会自动打入这张银行卡，无需手动提现。具体打款批次及到账时间以支付机构和银行处理为准。</view>
  <block wx:if="{{mode !== 'change'}}">
   <button class="settlement-link-button" bindtap="bindStartChange" disabled="{{!!account.changeBlocked}}">更换结算银行卡<text class="icon-right"></text></button>
   <view wx:if="{{account.changeBlocked}}" class="settlement-hint settlement-blocked">{{account.changeBlocked}}</view>
  </block>
 </view>
 <block wx:if="{{!account.opened || mode === 'change'}}">
 <view class="settlement-card {{mode === 'change' ? 'settlement-change-card' : ''}}">
  <view class="settlement-card-title">{{mode === 'change' ? '更换结算银行卡' : '结算账户信息'}}</view>
  <view class="settlement-card-desc">{{mode === 'change' ? '请填写开通时的本人姓名和身份证号，以及新的本人Ⅰ类借记卡。提交后原卡先解除绑定，新卡核验通过后生效。' : '以下信息用于支付机构核验身份及结算账户'}}</view>
  <view id="guide-realName" class="{{guideField === 'realName' ? 'form-guide-invalid' : ''}} settlement-field"><view wx:if="{{guideField === 'realName'}}" class="form-guide-message">{{guideMessage}}</view>
   <label for="settlement-name" class="settlement-label">真实姓名</label>
   <input id="settlement-name" class="settlement-input" value="{{form.realName}}" data-field="realName" bindinput="bindInput" placeholder="请输入本人真实姓名" maxlength="50" placeholder-class="settlement-placeholder" adjust-position="{{true}}"/>
  </view>
  <view id="guide-identity" class="{{guideField === 'identity' ? 'form-guide-invalid' : ''}} settlement-field"><view wx:if="{{guideField === 'identity'}}" class="form-guide-message">{{guideMessage}}</view>
   <label for="settlement-identity" class="settlement-label">身份证号</label>
   <input id="settlement-identity" class="settlement-input" type="idcard" value="{{form.identity}}" data-field="identity" bindinput="bindInput" placeholder="请输入18位身份证号" maxlength="18" placeholder-class="settlement-placeholder" adjust-position="{{true}}"/>
  </view>
  <view id="guide-bankCard" class="{{guideField === 'bankCard' ? 'form-guide-invalid' : ''}} settlement-field"><view wx:if="{{guideField === 'bankCard'}}" class="form-guide-message">{{guideMessage}}</view>
   <label for="settlement-bank" class="settlement-label">本人Ⅰ类银行卡号</label>
   <input id="settlement-bank" class="settlement-input" type="number" value="{{form.bankCard}}" data-field="bankCard" bindinput="bindInput" placeholder="请输入本人借记卡号" maxlength="19" placeholder-class="settlement-placeholder" adjust-position="{{true}}"/>
   <view class="settlement-hint">请使用与实名信息一致的本人银行卡</view>
  </view>
  <view id="guide-phone" class="{{guideField === 'phone' ? 'form-guide-invalid' : ''}} settlement-field"><view wx:if="{{guideField === 'phone'}}" class="form-guide-message">{{guideMessage}}</view>
   <label for="settlement-phone" class="settlement-label">银行预留手机号</label>
   <input id="settlement-phone" class="settlement-input" type="number" value="{{form.phone}}" data-field="phone" bindinput="bindInput" placeholder="请输入银行卡预留手机号" maxlength="11" placeholder-class="settlement-placeholder" adjust-position="{{true}}"/>
  </view>
 </view>

 <view class="settlement-security">
  <text class="icon-lock"></text>
  <view><view class="settlement-security-title">你的信息由你授权</view><view class="settlement-security-copy">信息仅用于开户与结算验证。云速取不留存完整证件号或银行卡号；填写内容只保存在当前页面，关闭页面或离开超过10分钟后清空。</view></view>
 </view>
 </block>
 <block wx:if="{{!account.opened || mode === 'change' || !account.consentCurrent}}">
 <view wx:if="{{account.opened && mode !== 'change'}}" class="settlement-card-desc">请阅读并确认更新后的协议；本次确认不改变结算银行卡。</view>
 <checkbox-group bindchange="bindAgreement" class="settlement-agreements">
  <label id="guide-rules" class="settlement-agreement {{guideField === 'rules' ? 'form-guide-invalid' : ''}}"><view wx:if="{{guideField === 'rules'}}" class="form-guide-message">{{guideMessage}}</view><view class="settlement-check-control"><checkbox class="settlement-native-check" value="rules" checked="{{rulesAccepted}}" color="#397bc8"/><view aria-hidden="{{true}}" class="settlement-check-box {{rulesAccepted ? 'settlement-check-box-active' : ''}}"></view></view><text>我已阅读并同意《云速取代取人（骑手）服务与结算协议》</text></label>
  <button class="settlement-document-link" data-kind="rules" bindtap="bindDocument">查看骑手服务与结算协议<text class="icon-right"></text></button>
  <label id="guide-authorization" class="settlement-agreement {{guideField === 'authorization' ? 'form-guide-invalid' : ''}}"><view wx:if="{{guideField === 'authorization'}}" class="form-guide-message">{{guideMessage}}</view><view class="settlement-check-control"><checkbox class="settlement-native-check" value="authorization" checked="{{authorizationAccepted}}" color="#397bc8"/><view aria-hidden="{{true}}" class="settlement-check-box {{authorizationAccepted ? 'settlement-check-box-active' : ''}}"></view></view><text>我已阅读《实名与结算信息处理说明》，同意按说明向上海汇付支付有限公司提供实名及银行卡信息用于开户与结算</text></label>
  <button class="settlement-document-link" data-kind="privacy" bindtap="bindDocument">查看实名与结算信息处理说明<text class="icon-right"></text></button>
 </checkbox-group>
 <view wx:if="{{error}}" class="settlement-error">{{error}}</view>
 <button class="settlement-submit" bindtap="bindSubmit" loading="{{submitting}}" disabled="{{submitting}}">{{mode === 'change' ? '确认更换' : account.opened ? '确认新版协议' : '完成开通'}}</button>
 <button wx:if="{{mode === 'change'}}" class="settlement-cancel" bindtap="bindCancelChange" disabled="{{submitting}}">暂不更换</button>
 <view class="settlement-submit-note">{{mode === 'change' ? '更换结果以支付机构核验为准' : account.opened ? '结算账户继续有效，无需重新开户' : '开通结果以支付机构审核为准'}}</view>
 </block>

 <view wx:if="{{account.opened && mode !== 'change' && account.consentCurrent}}" class="settlement-document-links"><button class="settlement-document-link" data-kind="rules" bindtap="bindDocument">骑手服务与结算协议</button><button class="settlement-document-link" data-kind="privacy" bindtap="bindDocument">实名与结算信息处理说明</button></view>
 </block>
</view>

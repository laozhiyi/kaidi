.review-add-page{min-height:100vh;background:#f4f7fb;padding:40rpx 24rpx;box-sizing:border-box}.review-add-card{background:#fff;border-radius:24rpx;padding:36rpx 28rpx;box-shadow:0 8rpx 24rpx rgba(32,64,102,.06)}.review-add-title{font-size:36rpx;font-weight:700;color:#263750}.review-add-sub{margin-top:12rpx;color:#94a3b8;font-size:24rpx}.score-row{display:flex;justify-content:center;gap:18rpx;margin:48rpx 0}.score-star{font-size:64rpx;color:#dce4ee}.score-star.active{color:#f4a340}.review-input{width:100%;min-height:220rpx;padding:22rpx;background:#f7f9fc;border-radius:16rpx;box-sizing:border-box;color:#51607a}.review-submit{margin-top:34rpx;background:#397bc8;color:#fff;border:0;border-radius:44rpx}.review-submit::after{border:0}
page { background:#f3f6fb; }
.reputation-page { padding:24rpx 24rpx calc(36rpx + env(safe-area-inset-bottom)); color:#243b5b; font-size:27rpx; line-height:1.6; }
.reputation-hero { padding:30rpx 32rpx; color:#fff; border-radius:26rpx; background:linear-gradient(125deg,#397bc8,#659fe0); box-shadow:0 10rpx 28rpx rgba(57,123,200,.14); }
.reputation-hero-top { display:flex; align-items:center; justify-content:space-between; gap:16rpx; font-size:22rpx; color:#e5f0ff; }
.reputation-badge { flex-shrink:0; padding:4rpx 14rpx; border:1rpx solid rgba(255,255,255,.32); border-radius:24rpx; }
.reputation-caption { margin-top:34rpx; color:#e5f0ff; font-size:26rpx; }
.reputation-number { margin-top:2rpx; font-size:112rpx; font-weight:600; line-height:1.2; letter-spacing:-3rpx; }
.reputation-number text { margin-left:14rpx; font-size:27rpx; font-weight:400; letter-spacing:0; }
.reputation-progress { height:10rpx; margin-top:28rpx; border-radius:10rpx; overflow:hidden; background:rgba(255,255,255,.2); }
.reputation-progress-value { height:100%; border-radius:10rpx; background:#d9ebff; }
.reputation-range { display:flex; justify-content:space-between; margin-top:10rpx; color:#deecfd; font-size:20rpx; }
.reputation-hero-note { margin-top:26rpx; padding-top:20rpx; border-top:1rpx solid rgba(255,255,255,.18); font-size:23rpx; color:#f0f6ff; }
.reputation-card { margin-top:22rpx; padding:28rpx; border-radius:22rpx; background:#fff; border:1rpx solid #edf1f6; }
.reputation-heading { font-size:30rpx; font-weight:600; }
.reputation-breakdown { display:flex; margin:28rpx -12rpx 22rpx; }
.reputation-part { flex:1; min-width:0; text-align:center; padding:0 8rpx; }
.reputation-part + .reputation-part { border-left:1rpx solid #edf1f6; }
.reputation-part-value { font-size:42rpx; font-weight:600; line-height:1.3; }
.reputation-part-title { margin-top:12rpx; font-size:25rpx; }
.reputation-small { margin-top:8rpx; color:#8a99ac; font-size:22rpx; }
.reputation-hint { padding:18rpx; border-radius:12rpx; background:#f5f8fc; color:#8191a6; font-size:22rpx; line-height:1.7; }
.reputation-rule-grid { display:flex; margin:24rpx 0; padding:20rpx 0; background:#f7f9fc; border-radius:14rpx; }
.reputation-rule { flex:1; text-align:center; }
.reputation-rule-star { color:#b98530; font-size:24rpx; }
.reputation-rule-points { margin-top:6rpx; font-size:24rpx; font-weight:500; }
.reputation-rule-copy { margin-top:14rpx; color:#8392a6; font-size:23rpx; line-height:1.8; }
.reputation-section-head { display:flex; align-items:center; justify-content:space-between; margin:34rpx 4rpx 18rpx; }
.reputation-tabs { display:flex; padding:8rpx; gap:8rpx; border-radius:18rpx; background:#e9eef6; }
.reputation-tab { flex:1; margin:0; padding:8rpx 4rpx; background:transparent; color:#8292a9; font-size:25rpx; border-radius:12rpx; line-height:2; }
.reputation-tab text { margin-left:8rpx; font-size:22rpx; }
.reputation-tab.active { color:#397bc8; background:#fff; box-shadow:0 3rpx 12rpx rgba(36,59,91,.04); }
.reputation-tab::after,.reputation-button::after,.reputation-record-foot button::after { border:0; }
.reputation-state,.reputation-empty { padding:60rpx 28rpx; text-align:center; color:#7d8da3; }
.reputation-empty-star { display:block; color:#b3c6de; font-size:64rpx; margin-bottom:12rpx; }
.reputation-button { margin-top:24rpx; padding:14rpx 28rpx; border-radius:14rpx; background:#eaf2fc; color:#397bc8; font-size:25rpx; line-height:2; }
.reputation-record-top { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.reputation-record-name { font-size:27rpx; font-weight:500; word-break:break-all; }
.reputation-role { margin-left:10rpx; padding:4rpx 10rpx; border-radius:6rpx; background:#f2f6fc; color:#7f96b2; font-size:21rpx; font-weight:400; white-space:nowrap; }
.reputation-record-stars { margin-top:8rpx; color:#d6a04d; font-size:24rpx; letter-spacing:3rpx; }
.reputation-record-points { flex-shrink:0; font-size:38rpx; font-weight:500; }
.reputation-record-points text { margin-left:5rpx; font-size:22rpx; font-weight:400; }
.reputation-record-content { margin-top:20rpx; font-size:25rpx; color:#667a93; line-height:1.8; white-space:pre-wrap; word-break:break-all; }
.reputation-record-foot { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-top:16rpx; color:#9aa8b9; font-size:21rpx; }
.reputation-record-foot button { flex-shrink:0; margin:0; padding:8rpx 0 8rpx 12rpx; color:#5b8bc1; background:transparent; font-size:23rpx; line-height:2; }
.reputation-end { margin-top:28rpx; color:#a0adbd; font-size:23rpx; text-align:center; }
.reputation-page .positive { color:#397bc8; }
.reputation-page .negative { color:#cf775e; }

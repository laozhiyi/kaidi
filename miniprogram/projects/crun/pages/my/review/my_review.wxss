.review-page{min-height:100vh;background:#f4f7fb;padding:28rpx 24rpx;box-sizing:border-box}.review-hero{padding:30rpx;background:linear-gradient(135deg,#397bc8,#6aa7eb);border-radius:24rpx;color:#fff;box-shadow:0 12rpx 30rpx rgba(57,123,200,.18)}.review-title{font-size:38rpx;font-weight:700}.review-desc{margin-top:10rpx;font-size:24rpx;opacity:.88}.review-card{margin-top:20rpx;background:#fff;border-radius:20rpx;padding:26rpx;box-shadow:0 8rpx 24rpx rgba(32,64,102,.06)}.review-card-top{display:flex;align-items:center;gap:20rpx}.review-target{font-size:29rpx;color:#263750;font-weight:600}.review-stars{margin-top:6rpx;color:#f4a340;font-size:26rpx;letter-spacing:2rpx;white-space:nowrap}.review-content{margin-top:20rpx;color:#51607a;font-size:26rpx;line-height:1.7}.review-state,.review-empty{text-align:center;color:#8190a5;padding:130rpx 20rpx}.review-empty-icon{font-size:80rpx;color:#b8c6d8}.review-empty-desc{margin-top:14rpx;color:#a0adbd;font-size:23rpx}.review-more{margin:24rpx auto;background:#fff;color:#397bc8;border:0;border-radius:30rpx}.review-more::after{border:0}
.review-tabs{display:flex;gap:8rpx;margin-top:24rpx;padding:8rpx;border-radius:18rpx;background:#e9eef6}.review-tab{flex:1;margin:0;padding:8rpx;background:transparent;color:#8494a9;border-radius:12rpx;font-size:26rpx;line-height:2}.review-tab.active{color:#397bc8;background:#fff}.review-tab::after{border:0}
.review-avatar { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:84rpx; height:84rpx; border-radius:50%; overflow:hidden; background:#edf3fb; }
.review-avatar-image { display:block; width:100%; height:100%; }
.review-avatar-fallback { display:block; width:48rpx; height:48rpx; }
.review-person { flex:1; min-width:0; }
.review-target, .review-content { word-break:break-all; white-space:pre-wrap; }
.review-content-empty { color:#94a3b8; }
.review-tab { min-width:0; min-height:88rpx; display:flex; align-items:center; justify-content:center; line-height:1.5; }

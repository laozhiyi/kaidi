.review-page{min-height:100vh;background:#f4f7fb;padding:28rpx 24rpx;box-sizing:border-box}.review-hero{padding:30rpx;background:linear-gradient(135deg,#397bc8,#6aa7eb);border-radius:24rpx;color:#fff;box-shadow:0 12rpx 30rpx rgba(57,123,200,.18)}.review-title{font-size:38rpx;font-weight:700}.review-desc{margin-top:10rpx;font-size:24rpx;opacity:.88}.review-card{margin-top:20rpx;background:#fff;border-radius:20rpx;padding:26rpx;box-shadow:0 8rpx 24rpx rgba(32,64,102,.06)}.review-card-top{display:flex;justify-content:space-between;gap:20rpx}.review-target{font-size:29rpx;color:#263750;font-weight:600}.review-order{margin-top:8rpx;color:#94a3b8;font-size:22rpx}.review-stars{color:#f4a340;font-size:26rpx;letter-spacing:2rpx;white-space:nowrap}.review-content{margin-top:20rpx;color:#51607a;font-size:26rpx;line-height:1.7}.review-time{margin-top:18rpx;color:#a3afbe;font-size:22rpx}.review-state,.review-empty{text-align:center;color:#8190a5;padding:130rpx 20rpx}.review-empty-icon{font-size:80rpx;color:#b8c6d8}.review-empty-desc{margin-top:14rpx;color:#a0adbd;font-size:23rpx}.review-more{margin:24rpx auto;background:#fff;color:#397bc8;border:0;border-radius:30rpx}.review-more::after{border:0}
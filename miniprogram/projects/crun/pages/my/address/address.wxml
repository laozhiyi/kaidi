<view wx:if="{{isLoad}}" class="profile-page">
  <view class="profile-hero"><view class="profile-title">常用地址</view><view class="profile-desc">选择所在地点，填写楼栋和门牌号</view></view>
  <view class="profile-section">
    <view class="profile-section-title-row"><view class="profile-section-title">地址</view><button class="profile-add-button" bindtap="bindAddAddress">+ 添加</button></view>
    <view wx:if="{{addresses.length}}" class="profile-item-list">
      <view wx:for="{{addresses}}" wx:key="index" class="profile-item-card">
        <view class="profile-item-main"><view class="profile-item-title">{{item.label || item.detail}} <text wx:if="{{item.isDefault}}" class="default">默认</text></view><view wx:if="{{item.label}}" class="profile-item-detail">{{item.detail}}</view><view wx:if="{{item.note}}" class="profile-item-note">备注：{{item.note}}</view></view>
        <view class="profile-item-actions"><text bindtap="bindSetDefaultAddress" data-index="{{index}}">设默认</text><text bindtap="bindEditAddress" data-index="{{index}}">编辑</text><text class="danger" bindtap="bindDeleteAddress" data-index="{{index}}">删除</text></view>
      </view>
    </view>
    <view wx:else class="profile-empty">暂无常用地址</view>
    <view wx:if="{{addressEditorVisible}}" class="profile-editor">
      <view class="address-editor-title">{{editingAddressIndex >= 0 ? '编辑地址' : '添加地址'}}</view>
      <view class="address-field-label">所在地点 <text class="address-field-optional">选填</text></view>
      <view class="place-trigger {{addressDraft.label ? '' : 'place-empty'}}" bindtap="bindOpenPlacePicker"><text class="place-text">{{addressDraft.label || '不选也行，按详细地址送达'}}</text><text class="place-arrow">›</text></view>
      <view class="address-field-label">详细地址 <text>*</text></view>
      <textarea class="address-detail" value="{{addressDraft.detail}}" placeholder="楼栋门牌，例如：3栋201室" auto-height maxlength="180" bindinput="bindAddressInput" data-field="detail" disabled="{{collectionSaving}}" />
      <view class="address-field-label">补充信息（选填）</view>
      <input class="address-note" value="{{addressDraft.note}}" placeholder="例如：放门口架子上、电话联系" maxlength="60" bindinput="bindAddressInput" data-field="note" disabled="{{collectionSaving}}" />
      <view class="profile-editor-actions"><button bindtap="bindCancelAddress" disabled="{{collectionSaving}}">取消</button><button class="primary" bindtap="bindSaveAddress" loading="{{collectionSaving}}" disabled="{{collectionSaving}}">{{collectionSaving ? '保存中' : '保存并关闭'}}</button></view>
    </view>
  </view>
  <view wx:if="{{loadError}}" class="profile-save-error">{{loadError}}<button class="profile-retry" bindtap="bindRetryLoad">重新加载</button></view>
  <view wx:if="{{saveError}}" class="profile-save-error">{{saveError}}</view>
  <view class="tab-bar-placeholder"></view>
  <view wx:if="{{placePickerVisible}}" class="place-mask" catchtouchmove="bindProfileSheetTouchMove" bindtap="bindClosePlacePicker">
    <view class="place-sheet" catchtap="bindPlaceSheetStop">
      <view class="place-head"><view class="place-head-main"><view class="place-title">所在地点</view><view class="place-note">选填，不选就按详细地址送达</view></view><button class="place-close" bindtap="bindClosePlacePicker" aria-label="关闭地点选择">×</button></view>
      <scroll-view scroll-y class="place-body">
        <block wx:for="{{placeGroups}}" wx:key="key">
          <view class="place-group-head"><text class="place-group-title">{{item.title}}</text><text class="place-group-hint">{{item.hint}}</text></view>
          <view class="place-grid">
            <button wx:for="{{item.items}}" wx:for-item="place" wx:key="label" class="place-chip {{placeDraft === place.label ? 'selected' : ''}} {{place.name ? 'place-chip-dorm' : ''}}" data-label="{{place.label}}" bindtap="bindSelectPlace" disabled="{{collectionSaving}}"><text class="place-chip-label">{{place.label}}</text><text wx:if="{{place.name}}" class="place-chip-name">{{place.name}}</text></button>
          </view>
        </block>
      </scroll-view>
      <view class="place-foot"><view class="place-summary"><text>已选：{{placeDraft || '未选择'}}</text><text wx:if="{{placeDraft}}" class="place-clear" bindtap="bindClearPlace">清除</text></view><button class="place-confirm" bindtap="bindConfirmPlace" disabled="{{collectionSaving}}">确认</button></view>
    </view>
  </view>
</view>

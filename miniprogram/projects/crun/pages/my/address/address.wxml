<view wx:if="{{isLoad}}" class="profile-page"><view class="profile-hero"><view class="profile-title">常用地址</view><view class="profile-desc">发布订单时可快速选择地址</view></view><view class="profile-section"><view class="profile-section-title-row"><view class="profile-section-title">地址</view><button class="profile-add-button" bindtap="bindAddAddress">+ 添加</button></view><view wx:if="{{addresses.length}}" class="profile-item-list"><view wx:for="{{addresses}}" wx:key="index" class="profile-item-card"><view class="profile-item-main"><view class="profile-item-title">{{item.label}} <text wx:if="{{item.isDefault}}" class="default">默认</text></view><view class="profile-item-detail">{{item.detail}}</view></view><view class="profile-item-actions"><text bindtap="bindSetDefaultAddress" data-index="{{index}}">设默认</text><text bindtap="bindEditAddress" data-index="{{index}}">编辑</text><text class="danger" bindtap="bindDeleteAddress" data-index="{{index}}">删除</text></view></view></view><view wx:else class="profile-empty">暂无常用地址</view><view wx:if="{{addressEditorVisible}}" class="profile-editor"><input value="{{addressDraft.label}}" placeholder="地址名称" bindinput="bindAddressInput" data-field="label"/><input value="{{addressDraft.detail}}" placeholder="详细地址" bindinput="bindAddressInput" data-field="detail"/><view class="profile-editor-actions"><button bindtap="bindCancelAddress">取消</button><button class="primary" bindtap="bindSaveAddress">保存</button></view></view></view><button class="save" bindtap="bindSubmitTap">保存地址</button><view class="tab-bar-placeholder"></view></view>
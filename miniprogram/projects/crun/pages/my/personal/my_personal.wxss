@import "../../../style/skin.wxss";

page { background: #f3f6fb; }
.profile-page { width:100%; min-height:100vh; padding:24rpx; box-sizing:border-box; color:#243b5b; }
.profile-section { width:100%; padding:30rpx 28rpx; border:1rpx solid #e5edf7; border-radius:18rpx; background:#fff; box-sizing:border-box; box-shadow:0 8rpx 22rpx rgba(36,63,96,.04); }
.profile-section-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; margin-bottom:26rpx; }
.profile-section-title { color:#243b5b; font-size:32rpx; font-weight:600; line-height:1.35; }
.profile-section-subtitle { margin-top:6rpx; color:#8494a9; font-size:22rpx; line-height:1.5; }
.profile-section-tag { flex-shrink:0; padding:5rpx 12rpx; border-radius:8rpx; color:#397bc8; background:#edf5ff; font-size:20rpx; line-height:1.3; }
.profile-field-list { border-top:1rpx solid #edf1f6; }
.profile-field { display:flex; align-items:center; min-height:98rpx; border-bottom:1rpx solid #edf1f6; }
.profile-field-label { flex-shrink:0; color:#52647c; font-size:26rpx; line-height:1.4; }
.profile-field > .profile-field-label { width:138rpx; }
.profile-field-input { flex:1; min-width:0; height:76rpx; color:#243b5b; font-size:26rpx; text-align:right; }
.profile-phone-field > .profile-field-label { width:112rpx; }
.profile-phone-value { flex:1; min-width:0; color:#243b5b; font-size:26rpx; text-align:right; word-break:break-all; }
.profile-phone-authorize { flex-shrink:0; margin:0 0 0 16rpx; padding:12rpx 16rpx; border-radius:10rpx; background:#edf5ff; color:#397bc8; font-size:23rpx; line-height:1.4; }
.profile-phone-authorize::after { border:0; }
.profile-avatar-button { display:flex; align-items:center; width:100%; min-height:112rpx; padding:16rpx 0; border:0; border-bottom:1rpx solid #edf1f6; border-radius:0; background:transparent; text-align:left; }
.profile-avatar-button::after, .profile-save::after, .profile-logout::after { border:0; }
.profile-avatar-button > view:first-child { flex:1; min-width:0; }
.profile-field-note { margin-top:5rpx; color:#98a6b7; font-size:21rpx; line-height:1.4; }
.profile-avatar, .profile-avatar-placeholder { flex-shrink:0; width:74rpx; height:74rpx; border-radius:16rpx; }
.profile-avatar { background:#edf3fa; }
.profile-avatar-placeholder { display:flex; align-items:center; justify-content:center; color:#6e97c8; background:#edf5ff; font-size:34rpx; }
.profile-arrow { flex-shrink:0; margin-left:16rpx; color:#9cabbc; font-size:25rpx; }
.profile-choice-field { display:flex; align-items:center; min-height:106rpx; border-bottom:1rpx solid #edf1f6; }
.profile-choice-field > .profile-field-label { width:138rpx; }
.profile-choice-group { display:flex; flex:1; min-width:0; gap:12rpx; }
.profile-choice { display:flex; align-items:center; justify-content:center; flex:1; height:60rpx; border:1rpx solid #dce6f2; border-radius:10rpx; color:#71839a; background:#f8fafd; font-size:24rpx; }
.profile-choice-dot { width:12rpx; height:12rpx; margin-right:8rpx; border:2rpx solid #aebccc; border-radius:50%; box-sizing:border-box; }
.profile-choice-selected { border-color:#397bc8; color:#397bc8; background:#edf5ff; font-weight:600; }
.profile-choice-selected .profile-choice-dot { border:4rpx solid #397bc8; }
.profile-campus-control { display:flex; align-items:center; justify-content:space-between; min-height:104rpx; padding:0 18rpx; margin-top:22rpx; border:1rpx solid #dce6f2; border-radius:12rpx; background:#f8fafd; }
.profile-campus-selected { border-color:#b9d3f0; background:#f1f7ff; }
.profile-campus-value { margin-top:5rpx; color:#8b9aae; font-size:23rpx; line-height:1.4; }
.profile-campus-selected .profile-campus-value { color:#397bc8; }
.profile-campus-action { flex-shrink:0; color:#397bc8; font-size:23rpx; }
.profile-campus-action text { margin-left:6rpx; font-size:20rpx; }
.profile-campus-pressed { opacity:.8; }
.profile-campus-overlay { position:fixed; inset:0; z-index:11000; }
.profile-campus-mask { position:absolute; inset:0; background:rgba(24,39,60,.4); }
.profile-campus-sheet { position:absolute; right:0; bottom:0; left:0; padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:32rpx 32rpx 0 0; background:#fff; box-shadow:0 -12rpx 48rpx rgba(36,63,96,.08); }
.profile-campus-sheet-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; margin-bottom:28rpx; }
.profile-campus-sheet-title { color:#243b5b; font-size:34rpx; font-weight:600; }
.profile-campus-sheet-desc { margin-top:10rpx; color:#8494a9; font-size:23rpx; line-height:1.5; }
.profile-campus-close { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:60rpx; height:60rpx; margin:0; padding:0; border-radius:50%; color:#8190a5; background:#f3f6fa; font-size:28rpx; }
.profile-campus-close::after, .profile-campus-sheet-actions button::after { border:0; }
.profile-campus-options { max-height:52vh; }
.profile-campus-option { display:flex; align-items:center; min-height:112rpx; padding:20rpx; margin-bottom:16rpx; border:2rpx solid #edf1f6; border-radius:18rpx; background:#f8fafd; box-sizing:border-box; }
.profile-campus-option-selected { border-color:#91b9e6; background:#edf5ff; }
.profile-campus-option-icon { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:64rpx; height:64rpx; margin-right:18rpx; border-radius:16rpx; color:#6a89ad; background:#edf1f6; font-size:32rpx; }
.profile-campus-option-selected .profile-campus-option-icon { color:#397bc8; background:#dcecff; }
.profile-campus-option-name { flex:1; min-width:0; color:#344a66; font-size:28rpx; font-weight:500; word-break:break-all; }
.profile-campus-current { flex-shrink:0; margin-left:12rpx; color:#8294ab; font-size:22rpx; }
.profile-campus-radio { display:flex; align-items:center; justify-content:center; flex-shrink:0; width:36rpx; height:36rpx; margin-left:20rpx; border:2rpx solid #c8d5e5; border-radius:50%; color:#fff; font-size:24rpx; box-sizing:border-box; }
.profile-campus-option-selected .profile-campus-radio { border-color:#397bc8; background:#397bc8; }
.profile-campus-sheet-actions { display:flex; gap:18rpx; margin-top:16rpx; }
.profile-campus-sheet-actions button { display:flex; align-items:center; justify-content:center; flex:1; min-width:0; height:88rpx; margin:0; padding:0 24rpx; border-radius:16rpx; font-size:28rpx; font-weight:500; line-height:1; }
.profile-campus-cancel { color:#62748b; background:#f0f4f9; }
.profile-campus-sheet-actions .profile-campus-confirm { flex:1.6; color:#fff; background:#397bc8; font-weight:600; }
.profile-campus-sheet-actions .profile-campus-confirm[disabled] { color:#94a4b8; background:#e8edf4; }
.profile-required-hint, .profile-save-error { color:#c27b42; font-size:22rpx; line-height:1.5; }
.profile-required-hint { margin-top:14rpx; }
.profile-save { width:100%; height:86rpx; margin-top:24rpx; border-radius:14rpx; color:#fff; background:#397bc8; font-size:29rpx; font-weight:600; line-height:86rpx; box-shadow:0 8rpx 18rpx rgba(57,123,200,.16); }
.profile-save[disabled] { color:#9aa9ba; background:#dce4ee; box-shadow:none; }
.profile-logout { width:100%; height:86rpx; margin-top:24rpx; border:1rpx solid #eadbdd; border-radius:14rpx; color:#c95353; background:#fff; font-size:29rpx; font-weight:500; line-height:84rpx; box-sizing:border-box; }
.profile-logout[disabled] { color:#9aa9ba; border-color:#e1e7ef; background:#f5f7fa; }
.profile-cancel-account { width:100%; margin-top:20rpx; color:#8b6269; background:transparent; font-size:26rpx; }
.profile-cancel-account::after { border:0; }
.profile-cancel-account[disabled] { color:#9aa9ba; }
.profile-save-error { margin-top:12rpx; text-align:center; }
.profile-load-state { margin:60rpx 24rpx; padding:30rpx; text-align:center; color:#8190a5; font-size:26rpx; }
.profile-invite { margin-top:20rpx; }
.profile-personal { margin-top:20rpx; }
.profile-nickname-hint { margin-top:18rpx; color:#8494a9; font-size:22rpx; line-height:1.6; }
.profile-next-actions { margin-top:30rpx; text-align:center; }
.profile-secondary, .profile-skip { width:100%; margin-top:18rpx; padding:20rpx 16rpx; border-radius:14rpx; font-size:26rpx; line-height:1.5; }
.profile-secondary { color:#397bc8; background:#e8f1fc; }
.profile-skip { margin-top:8rpx; color:#8494a9; background:transparent; }
.profile-secondary::after, .profile-skip::after { border:0; }
.profile-secondary[disabled], .profile-skip[disabled] { color:#a1adbc; }
.profile-invite .profile-field { border-bottom:0; }
.profile-invite .profile-field-label { width:auto; margin-right:20rpx; }
@media (max-width:360px) { .profile-page { padding-left:18rpx; padding-right:18rpx; } .profile-section { padding-left:20rpx; padding-right:20rpx; } .profile-field > .profile-field-label, .profile-choice-field > .profile-field-label { width:122rpx; } }

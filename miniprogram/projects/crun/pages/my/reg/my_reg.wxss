@import "../personal/my_personal.wxss";
.account-login-page { padding-top:48rpx; }
.wechat-login-header { margin-bottom:32rpx; text-align:center; }
.account-login-page .wechat-login-button { margin-top:28rpx; padding:0 18rpx; }
.account-login-page .wechat-login-note { text-align:center; }
.wechat-login-page { min-height:100vh; padding:100rpx 48rpx 60rpx; box-sizing:border-box; color:#243b5b; text-align:center; }
.wechat-login-mark { display:flex; align-items:center; justify-content:center; width:132rpx; height:132rpx; margin:0 auto 36rpx; border-radius:36rpx; background:#fff; box-shadow:0 12rpx 36rpx rgba(57,123,200,.1); }
.wechat-login-mark image { width:76rpx; height:76rpx; }
.wechat-login-title { font-size:40rpx; font-weight:600; line-height:1.5; }
.wechat-login-description { margin-top:16rpx; color:#71839a; font-size:27rpx; line-height:1.6; }
.wechat-login-button { margin-top:80rpx; padding:24rpx 18rpx; border-radius:16rpx; background:#07a95a; color:#fff; font-size:30rpx; font-weight:600; line-height:1.5; }
.wechat-login-button::after { border:0; }
.wechat-login-button[disabled] { background:#80c8a3; color:#fff; }
.wechat-login-note { margin-top:26rpx; color:#8494a9; font-size:24rpx; line-height:1.6; }
.profile-login-success { margin:0 0 22rpx; padding:20rpx 24rpx; border-radius:12rpx; color:#22734c; background:#e8f6ee; font-size:24rpx; line-height:1.6; }
.wechat-profile-overlay { position:fixed; inset:0; z-index:1000; }
.wechat-profile-mask { position:absolute; inset:0; background:rgba(20,35,52,.45); }
.wechat-profile-sheet { position:absolute; bottom:0; left:0; right:0; padding:32rpx 28rpx; padding-bottom:calc(32rpx + env(safe-area-inset-bottom)); border-radius:28rpx 28rpx 0 0; background:#f7fafc; box-sizing:border-box; }
.wechat-profile-heading { margin-bottom:24rpx; color:#243b5b; font-size:30rpx; font-weight:600; }
.wechat-profile-actions { display:flex; gap:20rpx; margin-top:24rpx; }
.wechat-profile-actions button { flex:1; margin:0; padding:22rpx 16rpx; line-height:1.5; font-size:28rpx; border-radius:14rpx; }
.wechat-profile-cancel { color:#51667e; background:#e9eff5; }
.wechat-profile-cancel::after { border:0; }

/* ---- 未登录首页：沿用首页／我的页的卡片语言 ---- */
.account-login-page--guest { padding:24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); background:#f3f6fb; }
.login-brand { padding:44rpx 32rpx; margin-bottom:24rpx; border-radius:24rpx; background:linear-gradient(120deg,#397bc8,#589be4); color:#fff; text-align:center; overflow:hidden; }
.login-brand-mark { display:flex; align-items:center; justify-content:center; width:112rpx; height:112rpx; margin:0 auto 22rpx; border-radius:28rpx; background:rgba(255,255,255,.18); font-size:52rpx; }
.login-brand-name { font-size:38rpx; font-weight:600; letter-spacing:2rpx; }
.login-brand-slogan { margin-top:8rpx; font-size:24rpx; color:#eef5ff; letter-spacing:1rpx; }
.login-card { padding:32rpx 28rpx; margin-bottom:24rpx; border-radius:24rpx; background:#fff; box-shadow:0 6rpx 24rpx rgba(36,51,75,.035); }
.login-card-title { color:#24334b; font-size:30rpx; font-weight:600; }
.login-card-desc { margin-top:8rpx; color:#7c8ba0; font-size:24rpx; }
.account-login-page--guest .login-submit { height:88rpx; margin:28rpx 0 0; padding:0 24rpx; border-radius:14rpx; background:#397bc8; color:#fff; font-size:30rpx; font-weight:600; line-height:88rpx; }
.account-login-page--guest .login-submit::after { border:0; }
.account-login-page--guest .login-submit[disabled] { background:#397bc8; color:#fff; opacity:.5; }
.login-tip { margin-top:20rpx; color:#8d9bb0; font-size:23rpx; text-align:center; }
.login-error { margin-top:16rpx; }
.login-services { padding:28rpx 20rpx 26rpx; border-radius:24rpx; background:#fff; box-shadow:0 6rpx 24rpx rgba(36,51,75,.035); }
.login-services-title { margin:0 8rpx 24rpx; color:#24334b; font-size:30rpx; font-weight:600; }
.login-service-list { display:flex; width:100%; align-items:flex-start; }
.login-service { display:flex; flex-direction:column; align-items:center; flex:1; min-width:0; padding:4rpx 2rpx 8rpx; }
.login-service-icon { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; margin-bottom:14rpx; border-radius:22rpx; color:#397bc8; background:#eaf3ff; font-size:38rpx; }
.login-service-send { color:#33a184; background:#eaf8f3; }
.login-service-buy { color:#c88934; background:#fff5e5; }
.login-service-label { color:#24334b; font-size:26rpx; font-weight:500; }
.login-service-desc { margin-top:4rpx; color:#7c8ba0; font-size:22rpx; }
.login-foot { margin-top:32rpx; color:#9aa8ba; font-size:22rpx; line-height:1.6; text-align:center; }

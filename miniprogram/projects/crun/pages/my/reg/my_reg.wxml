<view wx:if="{{!isLoad && !loadError}}" class="profile-load-state">正在加载登录信息…</view>
<view wx:if="{{loadError}}" class="profile-load-state"><view>{{loadError}}</view><button class="profile-save" bindtap="_loadDetail">重新加载</button></view>
<view wx:if="{{isLoad}}" class="profile-page account-login-page">
  <view class="wechat-login-header">
    <view class="wechat-login-title">GXNU校跑</view>
    <view class="wechat-login-description">微信登录，开启校园互助</view>
  </view>
  <block wx:if="{{!phoneLoginEnabled}}">
    <button class="wechat-login-button" bindtap="bindOpenWechatProfile" loading="{{identityLoggingIn}}" disabled="{{identityLoggingIn || saving}}">{{identityLoggingIn ? '微信登录中' : '点击微信登录'}}</button>
    <view class="wechat-login-note">登录后进入个人资料页，按提示填写资料</view>
    <view wx:if="{{loginError}}" class="profile-save-error">{{loginError}}</view>
  </block>
  <form wx:else bindsubmit="bindProfileFormSubmit">
    <block wx:if="{{phoneVerified}}">
      <include src="../personal/wechat_profile_fields.wxml" />
      <block>
        <include src="../personal/personal_form.wxml" />
        <view class="profile-section profile-invite"><view class="profile-field"><text class="profile-field-label">邀请码（选填）</text><input class="profile-field-input" value="{{inviteCode}}" maxlength="6" placeholder="输入好友的6位邀请码" bindinput="bindInviteCodeInput" /></view></view>
      </block>
      <button form-type="submit" loading="{{saving}}" disabled="{{saving || phoneAuthorizing}}" class="profile-save wechat-login-button">保存资料并继续</button>
    </block>
    <block wx:else>
      <button wx:if="{{canGetWechatPhone}}" class="wechat-login-button" open-type="getPhoneNumber" bindtap="bindWechatPhoneTap" bindgetphonenumber="bindWechatLogin" loading="{{phoneAuthorizing}}" disabled="{{phoneAuthorizing}}">微信手机号一键登录</button>
      <view wx:else class="wechat-login-note">当前微信不支持手机号授权，请更新微信后重试</view>
    </block>
    <view wx:if="{{loginError || saveError}}" class="profile-save-error">{{saveError || loginError}}</view>
  </form>
</view>
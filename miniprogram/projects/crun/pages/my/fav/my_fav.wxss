page { background:#f3f6fb; }
.fav-page { min-height:100vh; padding:28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); box-sizing:border-box; color:#243b5b; }
.fav-header { padding:28rpx; border-radius:22rpx; color:#fff; background:linear-gradient(135deg,#397bc8,#6aa7eb); }
.fav-title { font-size:36rpx; font-weight:600; }
.fav-subtitle { margin-top:10rpx; font-size:24rpx; line-height:1.6; opacity:.8; }
.fav-search { display:flex; align-items:center; gap:14rpx; margin:24rpx 0; padding:12rpx 16rpx; border-radius:16rpx; color:#8294ab; background:#fff; }
.fav-search input { flex:1; min-width:0; height:64rpx; color:#243b5b; font-size:26rpx; }
.fav-search-button, .fav-clear { flex-shrink:0; margin:0; padding:0 18rpx; height:60rpx; border-radius:12rpx; color:#397bc8; background:#edf5ff; font-size:24rpx; line-height:60rpx; }
.fav-clear { padding:0 8rpx; color:#94a3b8; background:transparent; }
.fav-search button::after, .fav-button::after, .fav-delete::after { border:0; }
.fav-card { padding:24rpx; margin-top:18rpx; border:1rpx solid #edf1f6; border-radius:20rpx; background:#fff; }
.fav-card-head, .fav-card-foot { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.fav-type { padding:6rpx 12rpx; border-radius:8rpx; color:#397bc8; background:#edf5ff; font-size:22rpx; }
.fav-delete { height:56rpx; margin:0; padding:0 18rpx; border-radius:10rpx; color:#b67373; background:#fff6f6; font-size:23rpx; line-height:56rpx; }
.fav-card-title { margin:20rpx 0; font-size:29rpx; font-weight:500; line-height:1.5; word-break:break-all; }
.fav-card-foot { color:#91a0b3; font-size:22rpx; }
.fav-card-foot text:last-child { flex-shrink:0; color:#397bc8; }
.fav-state { padding:70rpx 24rpx; text-align:center; color:#8190a5; }
.fav-empty-icon { display:block; margin-bottom:20rpx; color:#b6c8df; font-size:72rpx; }
.fav-button { height:80rpx; margin-top:24rpx; border-radius:14rpx; color:#397bc8; background:#eaf2fc; font-size:26rpx; line-height:80rpx; }
.fav-end { padding:28rpx 0; color:#a0adbd; font-size:23rpx; text-align:center; }
.fav-pressed { opacity:.8; }
.fav-order-meta { display:flex; align-items:center; gap:18rpx; margin-bottom:22rpx; color:#91a0b3; font-size:23rpx; }
.fav-order-status { padding:5rpx 12rpx; border-radius:8rpx; background:#f0f3f7; color:#8b97a8; }
.fav-order-status.available { background:#e8f7ef; color:#28825a; }
.fav-price { margin-left:auto; color:#e07846; font-size:30rpx; font-weight:600; }

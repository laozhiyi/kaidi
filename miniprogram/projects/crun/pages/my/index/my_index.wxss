@import "../../../style/skin.wxss";

/* ============================================================
   我的页面整体布局（左右贴边、宽度撑满屏幕）
   - 顶部用户区、订单宫格、常用服务宫格、设置列表
     全部左右贴边、宽度撑满屏幕
   - 内容文字相对屏幕保留 24rpx 内边距
   ============================================================ */

.main {
	padding: 0;
	background-color: #f1f6ff;
	width: 100%;
	box-sizing: border-box;
}

/* ============================================================
   顶部用户区域（蓝色渐变条，左右贴边）
   ============================================================ */
.main .upside {
	background: linear-gradient(135deg, #4a8fe0 0%, #397bc8 50%, #2f69b3 100%);
	width: 100%;
	height: 280rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	position: relative;
	overflow: hidden;
	padding: 50rpx 32rpx 60rpx;
	box-sizing: border-box;
	border-bottom-left-radius: 30rpx;
	border-bottom-right-radius: 30rpx;
	box-shadow: 0 8rpx 20rpx rgba(57, 123, 200, .25);
}

.main .upside .up-bg {
	position: absolute;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	opacity: .18;
	background-image:
		radial-gradient(circle at 18% 28%, rgba(255, 255, 255, .55) 0%, transparent 35%),
		radial-gradient(circle at 82% 72%, rgba(255, 255, 255, .45) 0%, transparent 45%);
	pointer-events: none;
}

.main .upside .user-bar {
	width: 100%;
	display: flex;
	justify-content: space-between;
	align-items: center;
	z-index: 99;
	position: relative;
}

.main .upside .user-bar .avatar {
	width: 120rpx;
	height: 120rpx;
	border: 4rpx solid rgba(255, 255, 255, .95);
	border-radius: 50%;
	background-color: rgba(255, 255, 255, .95);
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, .15);
	overflow: hidden;
	flex-shrink: 0;
}

.main .upside .user-bar .avatar image {
	width: 70rpx;
	height: 70rpx;
}

.main .upside .user-bar .detail {
	flex: 1;
	min-width: 0;
	margin-left: 24rpx;
	margin-right: 16rpx;
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: flex-start;
	box-sizing: border-box;
}

.main .upside .user-bar .detail .name {
	width: 100%;
	font-size: 38rpx;
	font-weight: bold;
	color: #ffffff;
	line-height: 50rpx;
	text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .15);
}

.main .upside .user-bar .detail .desc {
	width: 100%;
	font-size: 24rpx;
	margin-top: 8rpx;
	color: rgba(255, 255, 255, .92);
	line-height: 34rpx;
}

.main .upside .user-bar .detail .desc .tag {
	background-color: rgba(255, 255, 255, .9) !important;
	color: #397bc8 !important;
}

.main .upside .upside-arrow {
	position: absolute;
	right: 32rpx;
	top: 50%;
	transform: translateY(-50%);
	color: rgba(255, 255, 255, .75);
	font-size: 32rpx;
	z-index: 99;
}

/* ============================================================
   全局：宫格区域、设置列表 —— 左右贴边、宽度撑满
   ============================================================ */
.order-section,
.service-section,
.comm-list.menu.card-project {
	width: 100%;
	margin-left: 0 !important;
	margin-right: 0 !important;
	border-radius: 0 !important;
	box-sizing: border-box;
}

/* ============================================================
   订单宫格：白色块，左右贴边，向上顶入渐变条
   ============================================================ */
.order-section {
	margin-top: -40rpx;
	padding: 28rpx 0 32rpx;
	position: relative;
	z-index: 10;
	background-color: #fff;
	box-shadow: 0 4rpx 16rpx rgba(216, 220, 223, .35);
}

.order-section .section-head {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 0 24rpx;
	margin-bottom: 28rpx;
}

.order-section .section-title {
	font-size: 30rpx;
	font-weight: 600;
	color: #1f2a44;
	position: relative;
	padding-left: 20rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.order-section .section-title .head-icon {
	font-size: 28rpx;
	margin-right: 6rpx;
	font-style: normal;
}

.order-section .section-title::before {
	content: '';
	position: absolute;
	left: 0;
	top: 8rpx;
	bottom: 8rpx;
	width: 6rpx;
	background-color: #397bc8;
	border-radius: 4rpx;
}

.order-section .section-more {
	font-size: 24rpx;
	color: #94a3b8;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.order-section .section-more .icon-right {
	margin-left: 4rpx;
	font-size: 22rpx;
}

.order-section .order-grid {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 0;
}

.order-section .order-item {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	padding: 8rpx 0;
}

.order-section .order-icon {
	width: 92rpx;
	height: 92rpx;
	border-radius: 50%;
	background-color: rgba(57, 123, 200, .1);
	display: flex;
	align-items: center;
	justify-content: center;
	margin-bottom: 16rpx;
	position: relative;
}

.order-section .order-icon::before {
	content: '';
	width: 44rpx;
	height: 44rpx;
	background-color: #397bc8;
	display: block;
	mask-position: center;
	mask-size: contain;
	mask-repeat: no-repeat;
	-webkit-mask-position: center;
	-webkit-mask-size: contain;
	-webkit-mask-repeat: no-repeat;
}


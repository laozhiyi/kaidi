/* Isolate this page from global .main / .menu / .card-project layout rules.
   The native navigation bar handles the status bar and capsule safe area. */
page { background: #f3f6fb; }
.my-page { box-sizing: border-box; width: 100%; min-height: 100vh; padding: 24rpx 24rpx 0; color: #24334b; font-size: 28rpx; line-height: 1.5; }
.my-page .my-profile { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-height: 196rpx; padding: 32rpx 28rpx; margin-bottom: 24rpx; border-radius: 24rpx; background: linear-gradient(120deg, #397bc8, #589be4); color: #fff; }
.my-page .my-avatar { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 108rpx; height: 108rpx; border: 4rpx solid rgba(255,255,255,.65); border-radius: 50%; box-sizing: border-box; background: #eef5ff; overflow: hidden; }
.my-page .my-avatar image { width: 64rpx; height: 64rpx; }
.my-page .my-profile-copy { flex: 1; min-width: 0; margin-left: 24rpx; }
.my-page .my-name { font-size: 34rpx; font-weight: 600; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.my-page .my-profile-desc { margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; color: #eef5ff; word-break: break-word; }
.my-page .my-status { display: inline-block; padding: 4rpx 12rpx; border-radius: 8rpx; background: rgba(255,255,255,.18); }
.my-page .my-profile-arrow { flex-shrink: 0; margin-left: 14rpx; font-size: 32rpx; opacity: .85; }
.my-page .my-card { box-sizing: border-box; width: 100%; padding: 28rpx 20rpx; margin-bottom: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(36,51,75,.035); }
.my-page .my-section-title { margin: 0 8rpx 24rpx; font-size: 30rpx; font-weight: 600; }
.my-page .my-grid { display: flex; width: 100%; align-items: flex-start; }
.my-page .my-grid-item { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 0; padding: 4rpx 2rpx 8rpx; }
.my-page .my-grid-icon { display: flex; justify-content: center; align-items: center; width: 76rpx; height: 76rpx; margin-bottom: 14rpx; border-radius: 22rpx; color: #397bc8; background: #edf4fc; font-size: 40rpx; }
.my-page .my-grid-label { font-size: 24rpx; text-align: center; line-height: 1.5; word-break: break-word; }
.my-page .my-links { padding: 0 28rpx; }
.my-page .my-link { display: flex; align-items: center; padding: 28rpx 0; min-height: 104rpx; box-sizing: border-box; }
.my-page .my-link + .my-link { border-top: 1rpx solid #edf1f6; }
.my-page .my-link-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 72rpx; height: 72rpx; border-radius: 18rpx; color: #397bc8; background: #edf4fc; font-size: 36rpx; }
.my-page .my-link-copy { flex: 1; min-width: 0; margin-left: 20rpx; word-break: break-word; }
.my-page .my-link-title { font-size: 28rpx; font-weight: 500; }
.my-page .my-link-desc { margin-top: 6rpx; font-size: 23rpx; color: #7c8ba0; }
.my-page .my-arrow { flex-shrink: 0; margin-left: 12rpx; color: #a5b2c2; font-size: 28rpx; }
.my-page .my-icon-warm { color: #bd8334; background: #fff6e7; }
.my-page .my-icon-green { color: #32927c; background: #eaf7f2; }
.my-page .my-tap { opacity: .75; }
.my-page .tab-bar-placeholder { height: calc(124rpx + env(safe-area-inset-bottom)); }

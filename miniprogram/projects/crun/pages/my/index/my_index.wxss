	mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path fill='black' d='M3 4h18v2H3V4zm0 4h18v12H3V8zm2 2v8h14v-8H5zm2 2h10v2H7v-2z'/></svg>");

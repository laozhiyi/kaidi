.order-section .order-label {
	font-size: 26rpx;
	color: #1f2a44;
}

/* ============================================================
   常用服务区：左右贴边、宽度撑满屏幕
   ============================================================ */
.service-section {
	margin-top: 20rpx;
	padding: 28rpx 0 32rpx;
	background-color: #fff;
}

.service-section .section-title-row {
	font-size: 30rpx;
	font-weight: 600;
	color: #1f2a44;
	margin-bottom: 24rpx;
	position: relative;
	padding-left: 20rpx;
	margin-left: 24rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.service-section .section-title-row .head-icon {
	font-size: 28rpx;
	margin-right: 6rpx;
	font-style: normal;
}

.service-section .section-title-row::before {
	content: '';
	position: absolute;
	left: 0;
	top: 8rpx;
	bottom: 8rpx;
	width: 6rpx;
	background-color: #397bc8;
	border-radius: 4rpx;
}

.service-section .service-grid {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 0;
}

.service-section .service-item {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
}

.service-section .service-icon {
	width: 90rpx;
	height: 90rpx;
	border-radius: 24rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 46rpx;
	color: #fff;
	margin-bottom: 14rpx;
	box-shadow: 0 6rpx 14rpx rgba(57, 123, 200, .15);
}

.service-section .service-icon-service {
	background: linear-gradient(135deg, #4a8fe0, #397bc8);
}

.service-section .service-icon-feedback {
	background: linear-gradient(135deg, #f59e0b, #ed8936);
}

.service-section .service-icon-invite {
	background: linear-gradient(135deg, #ff6b9d, #ee5a6f);
}

.service-section .service-icon-about {
	background: linear-gradient(135deg, #2dc87a, #1aa05f);
}

.service-section .service-icon .iconfont {
	font-size: 52rpx;
	color: #fff;
	font-style: normal;
}

.service-section .service-label {
	font-size: 26rpx;
	color: #1f2a44;
}

/* ============================================================
   设置列表：左右贴边、宽度撑满屏幕
   ============================================================ */
.comm-list.menu.card-project {
	margin-top: 20rpx;
	padding: 0;
	background-color: #fff;
	box-shadow: none;
}

.comm-list .item {
	border-bottom: 2rpx solid #f1f4fa;
	padding: 28rpx 24rpx;
}

.comm-list .item:last-child {
	border-bottom: none;
}

.comm-list .item .content {
	display: flex;
	flex-direction: row;
	align-items: center;
	font-size: 28rpx;
	color: #1f2a44;
}

.comm-list .item .content .left-icon {
	width: 38rpx;
	height: 38rpx;
	background-color: #397bc8;
	mask-position: center;
	mask-size: contain;
	mask-repeat: no-repeat;
	-webkit-mask-position: center;
	-webkit-mask-size: contain;
	-webkit-mask-repeat: no-repeat;
	margin-right: 18rpx;
	flex-shrink: 0;
}


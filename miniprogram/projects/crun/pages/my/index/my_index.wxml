<view class="main {{skin.IS_SUB?'sub-margin-bottom':''}}">

	<!--top area begin-->
	<view class="upside upside-shadow" bindtap="url" data-url="{{user?'../edit/my_edit':'../reg/my_reg'}}">
		<image mode="aspectFill" lazy-load class="upImg loading" src="../../../images/my.jpg" />
		<view class="user-bar">
			<view class="detail">
				<view class="name text-cut">{{user?user.USER_NAME:'欢迎回来~~~'}}</view>
				<view class="desc">
					<view wx:if="{{user&&user.USER_STATUS==9}}" class="tag small radius bg-blue light">已禁用</view>
					<view wx:elif="{{user&&user.USER_STATUS==0}}" class="tag small radius bg-blue light">已注册，待审核</view>
					<view wx:elif="{{user&&user.USER_STATUS==8}}" class="tag small radius bg-blue light">审核未通过，请修改资料</view>
					<view wx:else class="text-cut">{{user?'欢迎回来~~~':'马上注册，使用更多功能'}}</view>
				</view>
			</view>
			<view class="avatar" wx:if="{{!user || !user.USER_PIC}}">
				<image mode="aspectFit" src="../../../images/tabbar/my_cur.png" />
			</view>
			<image wx:else src="{{user.USER_PIC}}" class="avatar loading" mode="aspectFill" />
		</view>
	</view>
	<!--top area end-->

	<!--down area begin-->
	<view class="down padding-project">
		<view class="record card-project shadow-project">
			<view class="title"><text class="icon-circlefill margin-right-xs text-blue"></text>我的记录</view>
			<view class="list">
			
				<view class="item" bind:tap="bindMyPostTap">
					<view class="line1"><text class="icon-forwardfill text-blue"></text></view>
					<view class="line2">我的发布</view>
				</view>

				<view class="item" bind:tap="bindMyAcceptTap">
					<view class="line1"><text class="icon-formfill text-blue"></text></view>
					<view class="line2">我的接单</view>
				</view>

				<view class="item" bind:tap="bindMyFavTap">
					<view class="line1"><text class="icon-favorfill text-blue"></text></view>
					<view class="line2">我的收藏</view>
				</view>

				<view class="item" bind:tap="url" data-url="../foot/my_foot">
					<view class="line1"><text class="icon-attentionfill text-blue"></text></view>
					<view class="line2">我的浏览</view>
				</view>
			
			</view>
		</view>

		<!--base begin -->
		<view class="comm-list menu card-project shadow-project">
			<view wx:if="{{user&&user.USER_STATUS!=9}}" class="item arrow" bindtap="url" data-url="../edit/my_edit">
				<view class="content">
					<text class="icon-form my-icon-project"></text>
					<text class="text-black">修改我的个人资料</text>
				</view>
			</view> 

			<view wx:if="{{skin.IS_SUB}}" class="item arrow" bindtap="bindSetTap">
				<view class="content">
					<text class="icon-settings my-icon-project"></text>
					<text class="text-blue text-bold ">系统后台管理<text class="text-grey text-normal">（点击试用）</text></text>
				</view>
			</view>



			<view wx:if="{{skin.IS_SUB}}" class="item arrow" bindtap="url" data-url="/projects/crun/pages/about/index/about_index">
				<view class="content">
					<text class="icon-phone my-icon-project"></text>
					<text class="text-blue">联系作者了解更多详情</text>
				</view>
			</view>

			<view wx:if="{{!skin.IS_SUB}}" class="item arrow" bindtap="bindSetTap">
				<view class="content">
					<text class="icon-settings my-icon-project"></text>
					<text class="text-black">设置</text>
				</view>
			</view>

		</view>
		<!--sys end -->

	</view>
	<!--down area end-->

</view>
<view style="height:100rpx"></view>



<block wx:if="{{skin.IS_SUB}}">
	<import src="../../tpls/menu_tpl.wxml" />
	<template is="menuTpl" data="{{curMenu:'my_index',returnHome:false}}" />
</block>

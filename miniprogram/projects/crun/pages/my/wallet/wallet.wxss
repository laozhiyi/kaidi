.mall-page { position: relative; min-height: 100vh; padding: 0 24rpx 60rpx; box-sizing: border-box; background: linear-gradient(180deg, #397bc8 0, #397bc8 150rpx, #eef3fa 150rpx, #eef3fa 100%); }

/* 顶部积分卡：接着导航栏的蓝色往下延伸 */
.mall-hero { position: relative; overflow: hidden; padding: 30rpx 34rpx 34rpx; border-radius: 28rpx; background: linear-gradient(135deg, #4d93e3 0%, #2f69b6 100%); box-shadow: 0 18rpx 40rpx rgba(36, 86, 150, .28); color: #fff; top: 16rpx; }
.mall-hero-glow { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, .12); }
.mall-hero-glow-a { width: 260rpx; height: 260rpx; right: -70rpx; top: -90rpx; }
.mall-hero-glow-b { width: 160rpx; height: 160rpx; right: 120rpx; bottom: -90rpx; background: rgba(255, 214, 120, .18); }
.mall-hero-top { position: relative; display: flex; align-items: center; justify-content: space-between; }
.mall-hero-label { display: flex; align-items: center; gap: 10rpx; font-size: 27rpx; color: rgba(255, 255, 255, .92); }
.mall-hero-label .icon-coin { color: #ffd77a; font-size: 32rpx; }
.mall-hero-link { display: flex; align-items: center; gap: 4rpx; padding: 8rpx 18rpx; border-radius: 999rpx; background: rgba(255, 255, 255, .18); font-size: 23rpx; }
.mall-points-value { position: relative; margin-top: 14rpx; font-size: 84rpx; font-weight: 700; line-height: 1.05; letter-spacing: 2rpx; }
.mall-hero-tip { position: relative; margin-top: 12rpx; font-size: 22rpx; color: rgba(255, 255, 255, .75); }

/* 分段 Tab */
.mall-tabs { display: flex; gap: 8rpx; margin: 44rpx 0 24rpx; padding: 8rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 22rpx rgba(45, 84, 133, .06); }
.mall-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 18rpx 0; border-radius: 14rpx; color: #7b8ca3; font-size: 28rpx; }
.mall-tab-on { background: linear-gradient(135deg, #4d93e3, #3170c0); color: #fff; font-weight: 600; box-shadow: 0 6rpx 16rpx rgba(49, 112, 192, .3); }

/* 商品卡 */
.mall-card { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 26rpx; margin-bottom: 20rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 26rpx rgba(45, 84, 133, .07); }
.mall-card-icon { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; border-radius: 22rpx; background: linear-gradient(135deg, #ffb35c, #ff7f45); color: #fff; font-size: 52rpx; box-shadow: 0 8rpx 18rpx rgba(255, 127, 69, .3); }
.mall-card-copy { flex: 1; min-width: 0; }
.mall-card-name { color: #1f2f4a; font-size: 31rpx; font-weight: 700; }
.mall-card-desc { margin-top: 6rpx; color: #8b9aae; font-size: 22rpx; }
.mall-progress { margin-top: 14rpx; }
.mall-progress-bar { height: 10rpx; border-radius: 999rpx; background: #edf1f6; overflow: hidden; }
.mall-progress-fill { height: 100%; min-width: 10rpx; border-radius: 999rpx; background: linear-gradient(90deg, #ffb35c, #ff7f45); }
.mall-card-lack { display: block; margin-top: 8rpx; color: #d0703f; font-size: 21rpx; }
.mall-card-side { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 12rpx; }
.mall-card-cost { color: #ff7f45; }
.mall-card-cost-num { font-size: 40rpx; font-weight: 700; }
.mall-card-cost-unit { margin-left: 4rpx; font-size: 22rpx; }
.mall-card-btn { padding: 10rpx 24rpx; border-radius: 999rpx; background: linear-gradient(135deg, #4d93e3, #3170c0); color: #fff; font-size: 23rpx; }
.mall-card-disabled .mall-card-icon { background: linear-gradient(135deg, #ffd3a3, #ffb38f); box-shadow: none; }
.mall-card-disabled .mall-card-btn { background: #e6ebf2; color: #9aa7b8; }

/* 已兑换：票券样式 */
.mall-ticket { position: relative; display: flex; align-items: stretch; margin-bottom: 20rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 26rpx rgba(45, 84, 133, .07); overflow: hidden; }
.mall-ticket::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 10rpx; background: linear-gradient(180deg, #ffb35c, #ff7f45); }
.mall-ticket-main { flex: 1; min-width: 0; padding: 30rpx 26rpx 30rpx 38rpx; }
.mall-ticket-name { color: #1f2f4a; font-size: 30rpx; font-weight: 700; }
.mall-ticket-time { margin-top: 8rpx; color: #9aa7b8; font-size: 22rpx; }
.mall-ticket-side { flex-shrink: 0; display: flex; align-items: center; padding: 0 28rpx; border-left: 2rpx dashed #e3e9f1; }
.mall-view-btn { margin: 0; padding: 0 32rpx; height: 60rpx; line-height: 60rpx; border-radius: 999rpx; background: linear-gradient(135deg, #4d93e3, #3170c0); color: #fff; font-size: 25rpx; }
.mall-view-btn::after { border: 0; }

.mall-empty { display: flex; flex-direction: column; align-items: center; gap: 14rpx; padding: 60rpx 0; text-align: center; color: #a3b0c2; font-size: 24rpx; }
.mall-empty-icon { font-size: 72rpx; color: #c9d5e5; }
.mall-more { padding: 22rpx 0 4rpx; text-align: center; color: #a3b0c2; font-size: 22rpx; }
.mall-error { margin-top: 16rpx; color: #c0634a; font-size: 23rpx; text-align: center; }

/* 获取规则 */
.mall-rules { margin-top: 28rpx; padding: 26rpx 28rpx 10rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 26rpx rgba(45, 84, 133, .05); }
.mall-rules-title { margin-bottom: 10rpx; color: #1f2f4a; font-size: 28rpx; font-weight: 700; }
.mall-rule-row { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-top: 1rpx solid #f1f4fa; }
.mall-rules-title + .mall-rule-row { border-top: 0; }
.mall-rule-icon { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 18rpx; background: #e8f1fc; color: #397bc8; font-size: 36rpx; }
.mall-rule-icon-warm { background: #fff1e6; color: #ff7f45; }
.mall-rule-copy { flex: 1; min-width: 0; }
.mall-rule-name { color: #2b3b55; font-size: 26rpx; font-weight: 600; }
.mall-rule-desc { margin-top: 4rpx; color: #9aa7b8; font-size: 21rpx; }
.mall-rule-num { flex-shrink: 0; color: #2f9e6f; font-size: 30rpx; font-weight: 700; }

/* 弹层 */
.mall-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 20; display: flex; align-items: flex-end; background: rgba(20, 32, 52, .45); }
.mall-sheet { width: 100%; padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #fff; border-radius: 28rpx 28rpx 0 0; }
.mall-sheet-tall { max-height: 80vh; }
.mall-sheet-title { margin-bottom: 20rpx; color: #233552; font-size: 32rpx; font-weight: 700; text-align: center; }
.mall-code-box { margin-bottom: 12rpx; padding: 26rpx 24rpx; border-radius: 20rpx; background: linear-gradient(135deg, #fff6ec, #ffeede); text-align: center; }
.mall-code-label { color: #c0723f; font-size: 22rpx; }
.mall-sheet-code { margin: 10rpx 0 14rpx; color: #1f2f4a; font-size: 48rpx; font-weight: 700; letter-spacing: 10rpx; }
.mall-sheet-copy { display: inline-flex; align-items: center; gap: 6rpx; padding: 8rpx 22rpx; border-radius: 999rpx; background: #fff; color: #ff7f45; font-size: 23rpx; }
.mall-sheet-row { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid #f1f4fa; color: #2b3b55; font-size: 27rpx; }
.mall-sheet-key { width: 150rpx; color: #8b9aae; }
.mall-status { padding: 4rpx 16rpx; border-radius: 999rpx; background: #e7f6ee; color: #2f9e6f; font-size: 23rpx; }
.mall-sheet-hint { margin: 16rpx 0 24rpx; color: #7b8ca3; font-size: 24rpx; }
.mall-sheet-close { background: #e8f1fc; color: #397bc8; font-size: 28rpx; border-radius: 14rpx; }
.mall-sheet-close::after { border: 0; }
.mall-log-scroll { height: 760rpx; }
.mall-log-item { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-top: 1rpx solid #f1f4fa; }
.mall-log-copy { flex: 1; min-width: 0; }
.mall-log-title { color: #2b3b55; font-size: 26rpx; word-break: break-word; }
.mall-log-time { margin-top: 6rpx; color: #9aa7b8; font-size: 22rpx; }
.mall-log-change { flex-shrink: 0; color: #8b9aae; font-size: 32rpx; font-weight: 700; }
.mall-plus { color: #2f9e6f; }

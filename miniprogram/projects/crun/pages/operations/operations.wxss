@import "../../style/operations.wxss";

.inbox-page { background: #f3f6fb; }
.inbox-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 8rpx 0 24rpx; }
.inbox-title { font-size: 40rpx; font-weight: 700; line-height: 1.4; margin-bottom: 8rpx; }
.inbox-page .inbox-read-all { flex-shrink: 0; margin: 0; padding: 12rpx 18rpx; background: #e7f0fb; color: #315f97; font-size: 24rpx; }
.inbox-tools { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.inbox-filter { padding: 10rpx 22rpx; background: #fff; border: 1rpx solid #dce5f1; border-radius: 30rpx; font-size: 25rpx; }
.inbox-filter-active { background: #e8f1fe; border-color: #9fbfe7; color: #2866af; }
.inbox-tip { color: #8392a6; font-size: 22rpx; }
.inbox-message { border: 1rpx solid #e6ecf5; border-radius: 20rpx; }
.inbox-message-unread { border-color: #cbdcf2; }
.inbox-message-hover { background: #f6f9fe; }
.inbox-message-meta { display: flex; align-items: center; gap: 10rpx; margin-bottom: 18rpx; font-size: 21rpx; }
.inbox-category { padding: 3rpx 12rpx; background: #eff3f8; color: #64778f; border-radius: 6rpx; }
.inbox-category-news { color: #386eaf; background: #eaf2fe; }
.inbox-important { padding: 3rpx 10rpx; background: #fff1da; color: #a46b20; border-radius: 6rpx; }
.inbox-time { flex: 1; text-align: right; color: #8492a5; }
.inbox-page .op-message-title { font-size: 29rpx; line-height: 1.6; word-break: break-all; }
.inbox-page .op-unread { background: #e74b4b; width: 12rpx; height: 12rpx; }
.inbox-unread-label { flex-shrink: 0; color: #d25450; font-size: 22rpx; padding-top: 5rpx; }
.inbox-preview { color: #66758b; font-size: 25rpx; line-height: 1.8; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.inbox-page .op-card-foot { margin-top: 18rpx; font-size: 22rpx; color: #8c98a9; }
.inbox-detail-link { color: #397bc8; }
.inbox-update { display: flex; justify-content: space-between; margin-bottom: 20rpx; padding: 18rpx 24rpx; border-radius: 14rpx; background: #e6effc; color: #2f68ad; font-size: 25rpx; }
.inbox-sync-error { margin-bottom: 20rpx; color: #9a6c31; font-size: 23rpx; }
.inbox-empty > .icon-notice { display: block; font-size: 64rpx; color: #91b2db; margin: 12rpx 0 24rpx; }
.inbox-subscribe { margin-top: 20rpx; }
.inbox-subscribe-title { margin-bottom: 8rpx; font-weight: 600; }

@import "../../../style/skin.wxss";

page {
	background-color: #f1f6ff;
}

.main {
	width: 100%;
	min-height: 100vh;
	padding: 18rpx 24rpx 44rpx;
	padding-bottom: calc(44rpx + constant(safe-area-inset-bottom));
	padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	align-items: stretch;
	justify-content: flex-start;
}

.notice {
	display: flex;
	align-items: center;
	width: 100%;
	min-height: 92rpx;
	margin: 0 0 18rpx;
	padding: 14rpx 18rpx;
	box-sizing: border-box;
	background-color: #fff;
	border: 1rpx solid #d8e8ff;
	border-left: 6rpx solid #397bc8;
	border-radius: 16rpx;
	box-shadow: 0 8rpx 24rpx rgba(94, 128, 184, .08);
	transition: background-color .2s ease;
}

.notice-hover {
	background-color: #f3f8ff;
}

.notice-badge {
	flex-shrink: 0;
	width: 56rpx;
	height: 56rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 50%;
	background-color: #e5f0ff;
}

.notice-icon {
	font-size: 32rpx;
	line-height: 1;
	color: #397bc8;
}

.notice-content {
	flex: 1;
	min-width: 0;
	margin-left: 16rpx;
}

.notice-label {
	font-size: 26rpx;
	font-weight: 600;
	line-height: 34rpx;
	color: #1f2a44;
}

.notice-text {
	width: 100%;
	margin-top: 2rpx;
	font-size: 22rpx;
	line-height: 30rpx;
	color: #7b8799;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.notice-count {
	font-size: 26rpx;
	font-weight: 700;
	color: #397bc8;
}

.notice-action {
	flex-shrink: 0;
	display: flex;
	align-items: center;
	margin-left: 12rpx;
	font-size: 22rpx;
	line-height: 32rpx;
	color: #397bc8;
}

.notice-arrow {
	margin-left: 2rpx;
	font-size: 26rpx;
	line-height: 1;
}

.hero {
	width: 100%;
	/* Keep the banner ratio stable on phones from 320px to large screens. */
	height: 0;
	padding-top: 32.94%;
	box-sizing: border-box;
	border-radius: 22rpx;
	overflow: hidden;
	position: relative;
	background-color: #397BC8;
}

.hero image {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	display: block;
}

.express-card {
	width: 100%;
	margin: 0 0 20rpx;
	padding: 0 28rpx;
	box-sizing: border-box;
	background-color: #fff;
	border-radius: 18rpx;
	box-shadow: 0 8rpx 24rpx rgba(94, 128, 184, .08);
	overflow: hidden;
}

.express-card-head {
	display: flex;
	align-items: center;
	width: 100%;
	min-height: 100rpx;
}

.express-card-arrow {
	flex-shrink: 0;
	margin-left: auto;
	font-size: 34rpx;
	line-height: 1;
	color: #aeb6c0;
	transform: rotate(0deg);
	transition: transform .2s ease;
}

.express-card-icon {
	flex-shrink: 0;
	width: 64rpx;
	height: 64rpx;
	margin-right: 20rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 54rpx;
	line-height: 1;
	color: #397bc8;
}

.express-card-title {
	min-width: 0;
	font-size: 30rpx;
	font-weight: 600;
	color: #333;
}

.express-card-copy {
	flex: 1;
	min-width: 0;
}

.express-card-subtitle {
	margin-top: 4rpx;
	font-size: 22rpx;
	line-height: 30rpx;
	color: #94a3b8;
}

.feature-panel {
	margin-top: 24rpx;
	padding: 28rpx 28rpx 24rpx;
	background: linear-gradient(135deg, #4a8fe0 0%, #397bc8 50%, #2f69b3 100%);
	box-shadow: 0 14rpx 32rpx rgba(57, 123, 200, .22);
	color: #fff;
}

.feature-main {
	display: flex;
	align-items: center;
}

.feature-icon {
	flex-shrink: 0;
	width: 110rpx;
	height: 110rpx;
	border-radius: 28rpx;
	background-color: rgba(255, 255, 255, .18);
	display: flex;
	align-items: center;
	justify-content: center;
	margin-right: 22rpx;
	box-sizing: border-box;
	padding: 16rpx;
}

.feature-icon image {
	width: 100%;
	height: 100%;
	display: block;
}

.feature-info {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
	justify-content: center;
}

.feature-title {
	font-size: 34rpx;
	font-weight: 700;
	color: #fff;
	line-height: 44rpx;
}

.feature-desc {
	font-size: 24rpx;
	color: rgba(255, 255, 255, .82);
	line-height: 34rpx;
	margin-top: 6rpx;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.feature-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 10rpx;
	margin-top: 10rpx;
}

.feature-tag {
	font-size: 20rpx;
	color: #fff;
	background-color: rgba(255, 255, 255, .22);
	padding: 4rpx 14rpx;
	border-radius: 18rpx;
	line-height: 28rpx;
}

.feature-arrow {
	flex-shrink: 0;
	margin-left: 8rpx;
	font-size: 56rpx;
	line-height: 1;
	color: rgba(255, 255, 255, .6);
	font-weight: 300;
	align-self: flex-start;
	padding-top: 22rpx;
}

.feature-foot {
	display: flex;
	align-items: center;
	margin-top: 22rpx;
	padding-top: 20rpx;
	border-top: 1rpx solid rgba(255, 255, 255, .22);
}

.feature-stat {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	min-width: 0;
}

.feature-stat-num {
	font-size: 30rpx;
	font-weight: 700;
	color: #fff;
	line-height: 38rpx;
}

.feature-stat-label {
	font-size: 22rpx;
	color: rgba(255, 255, 255, .78);
	line-height: 30rpx;
	margin-top: 2rpx;
}

.feature-action {
	flex-shrink: 0;
	font-size: 24rpx;
	font-weight: 600;
	color: #397bc8;
	background-color: #fff;
	padding: 12rpx 22rpx;
	border-radius: 30rpx;
	margin-left: 18rpx;
	line-height: 30rpx;
}

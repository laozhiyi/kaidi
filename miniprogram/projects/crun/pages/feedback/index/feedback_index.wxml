<view class="page">

	<!-- 顶部蓝色导语区：系统导航栏已提供返回，这里只保留标题、说明与历史入口 -->
	<view class="hero">
		<view class="hero-bar">
			<text class="hero-title">反馈投诉</text>
			<view class="hero-history" bindtap="bindMyListTap" hover-class="hero-hover">
				<text>我的反馈</text>
				<text class="hero-history-arrow">›</text>
			</view>
		</view>
		<view class="hero-desc">您的建议和投诉是我们改进的动力</view>
	</view>

	<view class="form-wrap">
		<!-- 关联订单：让管理员一眼看到申诉的是哪一单 -->
		<view class="card">
			<view class="card-title">
				<text class="card-title-text">关联订单</text>
				<text class="card-title-sub">{{orderBrief ? '已关联' : '选填 · 建议关联，便于快速核实'}}</text>
			</view>

			<view wx:if="{{orderBrief}}" class="fb-order">
				<view class="fb-order-top">
					<text class="fb-order-status">{{orderBrief.statusText}}</text>
					<text class="fb-order-no">订单号 {{orderBrief.no}}</text>
				</view>
				<view class="fb-order-line"><text class="fb-order-lbl">取件</text><text class="fb-order-val">{{orderBrief.from || '待补充'}}</text></view>
				<view class="fb-order-line"><text class="fb-order-lbl">送达</text><text class="fb-order-val">{{orderBrief.to || '待补充'}}</text></view>
				<view class="fb-order-foot">
					<text class="fb-order-meta">{{orderBrief.serviceName || '快递代取'}} · ¥{{orderBrief.fee || '0.00'}}</text>
					<view class="fb-order-ops">
						<text class="fb-order-op" bindtap="bindPickOrderTap">更换</text>
						<text class="fb-order-op fb-order-op-muted" bindtap="bindClearedOrderTap">取消关联</text>
					</view>
				</view>
			</view>

			<view wx:else class="fb-order-empty" bindtap="bindPickOrderTap" hover-class="fb-order-empty-hover">
				<view class="fb-order-empty-main">
					<text class="fb-order-empty-title">选择我的订单</text>
					<text class="fb-order-empty-sub">关联后管理员能看到单号、取件地址与对方信息</text>
				</view>
				<text class="fb-order-empty-arrow">›</text>
			</view>

			<view wx:if="{{orderLoading}}" class="fb-order-tip">正在核实关联订单…</view>
			<view wx:elif="{{orderError}}" class="fb-order-tip fb-order-tip-error">{{orderError}}<text class="retry-link" bindtap="loadOrder">重新加载</text></view>
		</view>

		<view wx:if="{{orderTarget}}" class="card">
			<view class="card-title">
				<text class="card-title-text">申诉对象</text>
			</view>
			<view class="order-target">{{orderTarget.name}} · {{orderTarget.role}}</view>
			<view class="card-note">来自关联订单的另一位参与者。提交后由管理员核实并评定星级，审核前不影响对方信誉分。</view>
		</view>

		<aftersales-card />

		<!-- 选择投诉对象 -->
		<view wx:if="{{!orderTarget}}" class="card">
			<view class="card-title">
				<text class="card-title-text">投诉对象</text>
				<text class="card-title-required">*</text>
			</view>
			<view class="tag-row">
				<view wx:for="{{targetArr}}" wx:key="val"
					class="tag-item {{targetIdx==index?'tag-active':''}}"
					bindtap="bindTargetTap" data-idx="{{index}}">
					<text class="tag-label">{{item.label}}</text>
				</view>
				<view class="tag-item tag-custom {{customShow?'tag-active':''}}"
					bindtap="bindCustomTap">
					<text class="tag-label">自定义</text>
				</view>
			</view>

			<!-- 自定义输入框 -->
			<view wx:if="{{customShow}}" class="custom-input-wrap">
				<input class="custom-input" maxlength="20" placeholder="请输入投诉对象"
					value="{{customTarget}}" bindinput="bindCustomInput" disabled="{{isSubmit}}" />
			</view>
		</view>

		<!-- 写投诉内容 -->
		<view class="card">
			<view class="card-title">
				<text class="card-title-text">投诉内容</text>
				<text class="card-title-required">*</text>
			</view>
			<textarea class="textarea" maxlength="500"
				placeholder="请详细描述您遇到的问题，便于我们快速处理…"
				value="{{content}}" bindinput="bindContentInput" disabled="{{isSubmit}}">
			</textarea>
			<view class="input-counter">{{content.length}}/500</view>
		</view>

		<!-- 上传凭证 -->
		<view class="card">
			<view class="card-title">
				<text class="card-title-text">上传凭证</text>
				<text class="card-title-sub">选填 · 最多 6 张 · 已上传 {{img.length}}/6</text>
			</view>
			<view class="img-list">
				<view wx:for="{{img}}" wx:key="*this" class="img-item">
					<image class="img" src="{{item}}" mode="aspectFill"
						bindtap="bindPreviewImage" data-url="{{item}}"></image>
					<view class="img-del" bindtap="bindDelImage" data-idx="{{index}}">×</view>
				</view>
				<view wx:if="{{img.length<6}}" class="img-add" bindtap="bindChooseImage">
					<view class="add-icon">+</view>
					<view class="add-label">添加图片</view>
				</view>
			</view>
		</view>

		<!-- 温馨提示 -->
		<view class="tips">
			<view class="tips-line">请文明用语，共同维护良好的反馈环境</view>
			<view class="tips-line">我们会在 1–3 个工作日内处理，请耐心等待</view>
		</view>

	</view>

	<!-- 底部固定提交按钮 -->
	<view class="footer">
		<view wx:if="{{submitError}}" class="submit-error">{{submitError}}</view>
		<view class="btn-submit {{isSubmit?'btn-disabled':''}}" bindtap="bindSubmitTap">
			<text>{{isSubmit ? submitHint : submitError ? '重试提交' : '提交反馈'}}</text>
		</view>
	</view>

	<order-picker show="{{orderPickerShow}}" title="选择要申诉的订单"
		hint="支持全部历史订单，含我发布和我接的单" bind:close="bindCloseOrderPicker" bind:select="bindOrderPicked" />

</view>

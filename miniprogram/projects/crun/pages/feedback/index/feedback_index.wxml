<view class="page">

	<!-- 顶部蓝色导航条（带返回箭头） -->
	<view class="header">
		<view class="header-back" bindtap="bindBackTap">
			<text class="header-back-arrow">‹</text>
		</view>
		<view class="header-title">反馈投诉</view>
		<view class="header-desc">您的建议和投诉是我们改进的动力</view>
		<view class="feedback-history" bindtap="bindMyListTap">查看我的反馈 ›</view>
	</view>

	<view class="form-wrap">
		<view wx:if="{{orderLoading}}" class="card">正在核实关联订单…</view>
		<view wx:if="{{orderError}}" class="card"><view>{{orderError}}</view><button bindtap="loadOrder">重新加载订单</button></view>
		<view wx:if="{{orderTarget}}" class="card"><view class="card-title"><text class="card-title-text">申诉对象</text></view><view>{{orderTarget.name}} · {{orderTarget.role}}</view><view class="tips">来自关联订单的另一位参与者。提交后由管理员核实并评定星级，审核前不影响对方信誉分。</view></view>

		<!-- 选择投诉对象 -->
		<view wx:if="{{!orderTarget && !orderLoading && !orderError}}" class="card">
			<view class="card-title">
				<text class="card-title-text">投诉对象</text>
				<text class="card-title-required">*</text>
			</view>
			<view class="tag-row">
				<view wx:for="{{targetArr}}" wx:key="val"
					class="tag-item {{targetIdx==index?'tag-active':''}}"
					bindtap="bindTargetTap" data-idx="{{index}}">
					<text class="tag-label">{{item.label}}</text>
				</view>
				<view class="tag-item tag-custom {{customShow?'tag-active':''}}"
					bindtap="bindCustomTap">
					<text class="tag-label">自定义</text>
				</view>
			</view>

			<!-- 自定义输入框 -->
			<view wx:if="{{customShow}}" class="custom-input-wrap">
				<input class="custom-input" maxlength="20" placeholder="请输入投诉对象"
					value="{{customTarget}}" bindinput="bindCustomInput" disabled="{{isSubmit}}" />
			</view>
		</view>

		<!-- 写投诉内容 -->
		<view class="card">
			<view class="card-title">
				<text class="card-title-text">投诉内容</text>
				<text class="card-title-required">*</text>
			</view>
			<textarea class="textarea" maxlength="500"
				placeholder="请详细描述您遇到的问题，便于我们快速处理…"
				value="{{content}}" bindinput="bindContentInput" disabled="{{isSubmit}}">
			</textarea>
			<view class="input-counter">{{content.length}}/500</view>
		</view>

		<!-- 上传凭证 -->
		<view class="card">
			<view class="card-title">
					<text class="card-title-text">上传凭证</text>
					<text class="card-title-sub">（选填，最多6张，已上传 {{img.length}}/6）</text>
			</view>
			<view class="img-list">
				<view wx:for="{{img}}" wx:key="*this" class="img-item">
					<image class="img" src="{{item}}" mode="aspectFill"
						bindtap="bindPreviewImage" data-url="{{item}}"></image>
					<view class="img-del" bindtap="bindDelImage" data-idx="{{index}}">×</view>
				</view>
				<view wx:if="{{img.length<6}}" class="img-add" bindtap="bindChooseImage">
					<view class="add-icon">+</view>
					<view class="add-label">添加图片</view>
				</view>
			</view>
		</view>

		<!-- 温馨提示 -->
		<view class="tips">
			<view>· 请文明用语，共同维护良好的反馈环境</view>
			<view>· 我们会在 1-3 个工作日内处理，请耐心等待</view>
		</view>

	</view>

	<!-- 底部固定提交按钮 -->
	<view class="footer">
		<view wx:if="{{submitError}}" class="submit-error">{{submitError}}</view>
		<view class="btn-submit {{isSubmit?'btn-disabled':''}}" bindtap="bindSubmitTap">
			<text>{{isSubmit ? submitHint : submitError ? '重试提交' : '提交反馈'}}</text>
		</view>
	</view>

</view>

@import "../../../style/skin.wxss";

/* ============================================================
   反馈投诉提交页（左右贴边、宽度撑满屏幕）
   ============================================================ */

.page {
	min-height: 100vh;
	background-color: #f1f6ff;
	padding: 0 0 200rpx;
	box-sizing: border-box;
	width: 100%;
}

/* ============================================================
   顶部蓝色导航条（带返回箭头）
   ============================================================ */
.header {
	background: linear-gradient(135deg, #4a8fe0 0%, #397bc8 50%, #2f69b3 100%);
	width: 100%;
	padding: 40rpx 32rpx 48rpx;
	box-sizing: border-box;
	box-shadow: 0 6rpx 18rpx rgba(57, 123, 200, .25);
	position: relative;
}

.header-back {
	position: absolute;
	left: 24rpx;
	top: 36rpx;
	width: 60rpx;
	height: 60rpx;
	display: flex;
	align-items: center;
	justify-content: center;
}

.header-back-arrow {
	color: #fff;
	font-size: 60rpx;
	font-weight: 300;
	line-height: 1;
	margin-top: -8rpx;
}

.header-title {
	font-size: 44rpx;
	font-weight: bold;
	color: #fff;
	line-height: 60rpx;
	padding-left: 50rpx;
}

.header-desc {
	font-size: 26rpx;
	color: rgba(255, 255, 255, .85);
	margin-top: 10rpx;
	line-height: 36rpx;
	padding-left: 50rpx;
}

/* ============================================================
   表单容器
   ============================================================ */
.form-wrap {
	padding: 24rpx 24rpx 0;
}

/* ============================================================
   通用卡片
   ============================================================ */
.card {
	width: 100%;
	background-color: #fff;
	border-radius: 20rpx;
	padding: 32rpx 28rpx;
	margin-bottom: 24rpx;
	box-sizing: border-box;
	box-shadow: 0 4rpx 12rpx rgba(216, 220, 223, .25);
}

.card-title {
	font-size: 32rpx;
	font-weight: 600;
	color: #1f2a44;
	margin-bottom: 28rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	flex-wrap: wrap;
}

.card-title-text {
	font-size: 32rpx;
	font-weight: 600;
	color: #1f2a44;
}

.card-title-required {
	color: #ff4d4f;
	font-size: 32rpx;
	margin-left: 6rpx;
	line-height: 1;
}

.card-title-sub {
	font-size: 24rpx;
	color: #94a3b8;
	font-weight: normal;
	margin-left: 12rpx;
}

/* ============================================================
   投诉对象标签（一行平铺、可换行）
   ============================================================ */
.tag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16rpx;
}

.tag-item {
	padding: 14rpx 28rpx;
	background-color: #f5f8ff;
	border-radius: 32rpx;
	border: 2rpx solid transparent;
	box-sizing: border-box;
	transition: all .2s;
	display: flex;
	align-items: center;
	justify-content: center;
}

.tag-active {
	background-color: rgba(57, 123, 200, .12);
	border-color: #397bc8;
}

.tag-custom {
	background-color: #f5f8ff;
}

.tag-active.tag-custom {
	background-color: rgba(57, 123, 200, .12);
	border-color: #397bc8;
}

.tag-label {
	font-size: 26rpx;
	color: #4a5b7c;
	line-height: 1;
}

.tag-active .tag-label {
	color: #397bc8;
	font-weight: 600;
}

/* 自定义输入框 */
.custom-input-wrap {
	margin-top: 24rpx;
}

.custom-input {
	width: 100%;
	background-color: #f5f8ff;
	border-radius: 12rpx;
	padding: 22rpx 24rpx;
	font-size: 28rpx;
	color: #1f2a44;
	box-sizing: border-box;
	border: 2rpx solid transparent;
}

.custom-input:focus {
	border-color: #397bc8;
	background-color: #fff;
}

/* ============================================================
   文本域
   ============================================================ */
.textarea {
	width: 100%;
	height: 280rpx;
	background-color: #f5f8ff;
	border-radius: 12rpx;
	padding: 24rpx;
	font-size: 28rpx;
	color: #1f2a44;
	box-sizing: border-box;
	line-height: 44rpx;
	border: 2rpx solid transparent;
}

.textarea:focus {
	border-color: #397bc8;
	background-color: #fff;
}

.input-counter {
	text-align: right;
	color: #94a3b8;
	font-size: 22rpx;
	margin-top: 12rpx;
}

/* ============================================================
   图片上传（9 宫格）
   ============================================================ */
.img-list {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 20rpx;
}

.img-item {
	width: 200rpx;
	height: 200rpx;
	position: relative;
}

.img {
	width: 200rpx;
	height: 200rpx;
	border-radius: 12rpx;
	background-color: #f5f8ff;
}

.img-del {
	position: absolute;
	top: -12rpx;
	right: -12rpx;
	width: 44rpx;
	height: 44rpx;
	background-color: rgba(0, 0, 0, .65);
	color: #fff;
	border-radius: 50%;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 30rpx;
	line-height: 1;
}

.img-add {
	width: 200rpx;
	height: 200rpx;
	border: 2rpx dashed #cbd5e1;
	border-radius: 12rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	background-color: #f5f8ff;
	box-sizing: border-box;
}

.add-icon {
	font-size: 56rpx;
	color: #94a3b8;
	line-height: 1;
	font-weight: 200;
}

.add-label {
	font-size: 22rpx;
	color: #94a3b8;
	margin-top: 10rpx;
}

/* ============================================================
   温馨提示
   ============================================================ */
.tips {
	padding: 16rpx 12rpx;
	font-size: 24rpx;
	color: #94a3b8;
	line-height: 40rpx;
}

/* ============================================================
   底部固定提交按钮
   ============================================================ */
.footer {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 24rpx 24rpx 40rpx;
	background-color: #fff;
	box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .06);
	box-sizing: border-box;
}

.btn-submit {
	width: 100%;
	height: 92rpx;
	background: linear-gradient(135deg, #4a8fe0, #397bc8);
	color: #fff;
	font-size: 32rpx;
	font-weight: 600;
	border-radius: 46rpx;
	border: none;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	box-shadow: 0 8rpx 18rpx rgba(57, 123, 200, .35);
}

.btn-disabled {
	opacity: .6;
}

@import "../../../style/skin.wxss";

/* ============================================================
   反馈投诉提交页
   结构：蓝色导语区（返回 / 标题 / 我的反馈）→ 表单卡片 → 固定提交条
   ============================================================ */

.page {
	min-height: 100vh;
	background-color: #f4f7fc;
	padding: 0 0 220rpx;
	box-sizing: border-box;
	width: 100%;
}

/* ============================================================
   顶部导语区
   ============================================================ */
.hero {
	position: relative;
	overflow: hidden;
	padding: 24rpx 32rpx 44rpx;
	border-radius: 0 0 28rpx 28rpx;
	background: linear-gradient(160deg, #397bc8 0%, #3577c1 52%, #2f69b3 100%);
}

/* 右上角柔光，避免大面积纯色显得死板 */
.hero::after {
	content: '';
	position: absolute;
	right: -160rpx;
	top: -220rpx;
	width: 440rpx;
	height: 440rpx;
	border-radius: 50%;
	background: rgba(255, 255, 255, .08);
}

.hero-bar {
	position: relative;
	z-index: 1;
	display: flex;
	align-items: center;
}

.hero-title {
	flex: 1;
	min-width: 0;
	font-size: 38rpx;
	font-weight: 600;
	line-height: 56rpx;
	color: #fff;
	letter-spacing: 1rpx;
}

.hero-history {
	flex: none;
	display: flex;
	align-items: center;
	height: 56rpx;
	padding: 0 22rpx;
	border-radius: 28rpx;
	background: rgba(255, 255, 255, .18);
	font-size: 24rpx;
	color: #fff;
}

.hero-history-arrow {
	margin-left: 6rpx;
	font-size: 26rpx;
	opacity: .8;
}

.hero-desc {
	position: relative;
	z-index: 1;
	margin: 12rpx 0 0;
	font-size: 24rpx;
	line-height: 34rpx;
	color: rgba(255, 255, 255, .82);
}

.hero-hover {
	opacity: .72;
}

/* ============================================================
   表单容器
   ============================================================ */
.form-wrap {
	padding: 24rpx;
}

/* ============================================================
   通用卡片
   ============================================================ */
.card {
	width: 100%;
	background-color: #fff;
	border-radius: 24rpx;
	padding: 28rpx;
	margin-bottom: 24rpx;
	box-sizing: border-box;
	box-shadow: 0 6rpx 20rpx rgba(31, 42, 68, .05);
}

.card-state {
	display: flex;
	align-items: center;
	font-size: 26rpx;
	line-height: 40rpx;
	color: #64748b;
}

.card-state-text {
	flex: 1;
	margin-right: 16rpx;
}

.retry-link {
	flex: none;
	font-size: 26rpx;
	color: #397bc8;
}

.card-title {
	display: flex;
	align-items: baseline;
	flex-wrap: wrap;
	margin-bottom: 24rpx;
}

.card-title-text {
	font-size: 30rpx;
	font-weight: 600;
	line-height: 42rpx;
	color: #1f2a44;
}

.card-title-required {
	margin-left: 6rpx;
	font-size: 30rpx;
	line-height: 1;
	color: #ff5a5f;
}

.card-title-sub {
	margin-left: 12rpx;
	font-size: 22rpx;
	font-weight: 400;
	color: #94a3b8;
}

.order-target {
	font-size: 28rpx;
	font-weight: 600;
	line-height: 40rpx;
	color: #1f2a44;
}

.card-note {
	margin-top: 12rpx;
	font-size: 23rpx;
	line-height: 36rpx;
	color: #8b9ab1;
}

/* ============================================================
   投诉对象标签
   ============================================================ */
.tag-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16rpx;
}

.tag-item {
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 14rpx 28rpx;
	border-radius: 999rpx;
	border: 2rpx solid transparent;
	background-color: #f2f6fd;
	box-sizing: border-box;
	transition: all .2s;
}

.tag-active {
	background-color: rgba(57, 123, 200, .10);
	border-color: #397bc8;
}

.tag-label {
	font-size: 26rpx;
	line-height: 1;
	color: #4a5b7c;
}

.tag-active .tag-label {
	color: #397bc8;
	font-weight: 600;
}

/* 自定义输入框 */
.custom-input-wrap {
	margin-top: 24rpx;
}

.custom-input {
	width: 100%;
	padding: 22rpx 24rpx;
	border-radius: 14rpx;
	border: 2rpx solid transparent;
	background-color: #f2f6fd;
	font-size: 28rpx;
	color: #1f2a44;
	box-sizing: border-box;
}

.custom-input:focus {
	border-color: #397bc8;
	background-color: #fff;
}

/* ============================================================
   文本域
   ============================================================ */
.textarea {
	width: 100%;
	height: 280rpx;
	padding: 24rpx;
	border-radius: 14rpx;
	border: 2rpx solid transparent;
	background-color: #f2f6fd;
	font-size: 28rpx;
	line-height: 44rpx;
	color: #1f2a44;
	box-sizing: border-box;
}

.textarea:focus {
	border-color: #397bc8;
	background-color: #fff;
}

.input-counter {
	margin-top: 12rpx;
	text-align: right;
	font-size: 22rpx;
	color: #94a3b8;
}

/* ============================================================
   图片上传（三列）
   ============================================================ */
.img-list {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	gap: 16rpx;
}

.img-item {
	position: relative;
	width: 196rpx;
	height: 196rpx;
}

.img {
	width: 196rpx;
	height: 196rpx;
	border-radius: 14rpx;
	background-color: #f2f6fd;
}

.img-del {
	position: absolute;
	top: -10rpx;
	right: -10rpx;
	width: 44rpx;
	height: 44rpx;
	border-radius: 50%;
	background-color: rgba(0, 0, 0, .62);
	color: #fff;
	font-size: 30rpx;
	line-height: 1;
	display: flex;
	align-items: center;
	justify-content: center;
}

.img-add {
	width: 196rpx;
	height: 196rpx;
	border: 2rpx dashed #cbd5e1;
	border-radius: 14rpx;
	background-color: #f7faff;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
}

.add-icon {
	font-size: 52rpx;
	font-weight: 200;
	line-height: 1;
	color: #94a3b8;
}

.add-label {
	margin-top: 10rpx;
	font-size: 22rpx;
	color: #94a3b8;
}

/* ============================================================
   温馨提示
   ============================================================ */
.tips {
	padding: 8rpx 8rpx 0;
}

.tips-line {
	position: relative;
	padding-left: 24rpx;
	font-size: 22rpx;
	line-height: 38rpx;
	color: #98a6bb;
}

.tips-line::before {
	content: '·';
	position: absolute;
	left: 6rpx;
}

/* ============================================================
   底部固定提交按钮
   ============================================================ */
.footer {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
	background-color: #fff;
	box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, .06);
	box-sizing: border-box;
}

.submit-error {
	margin-bottom: 16rpx;
	font-size: 24rpx;
	line-height: 1.5;
	color: #b87539;
	text-align: center;
	word-break: break-all;
}

.btn-submit {
	width: 100%;
	height: 92rpx;
	border-radius: 46rpx;
	background: linear-gradient(135deg, #4a8fe0, #397bc8);
	color: #fff;
	font-size: 32rpx;
	font-weight: 600;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	box-shadow: 0 8rpx 18rpx rgba(57, 123, 200, .32);
}

.btn-disabled {
	opacity: .6;
}

/* ============================================================
   关联订单（申诉指向具体订单，便于上游核实）
   ============================================================ */
.fb-order {
	padding: 20rpx 22rpx;
	border-radius: 16rpx;
	background: #f7faff;
	border: 2rpx solid #e6eefb;
	box-sizing: border-box;
}

.fb-order-top {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-bottom: 12rpx;
	border-bottom: 2rpx solid #e9f0fb;
}

.fb-order-status {
	flex: none;
	margin-right: 14rpx;
	padding: 2rpx 14rpx;
	border-radius: 8rpx;
	background: rgba(57, 123, 200, .12);
	color: #397bc8;
	font-size: 21rpx;
	line-height: 32rpx;
}

.fb-order-no {
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	font-size: 22rpx;
	color: #94a3b8;
}

.fb-order-line {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	margin-top: 10rpx;
}

.fb-order-lbl {
	flex: none;
	width: 60rpx;
	font-size: 23rpx;
	line-height: 34rpx;
	color: #94a3b8;
}

.fb-order-val {
	flex: 1;
	font-size: 26rpx;
	line-height: 34rpx;
	color: #1f2a44;
	word-break: break-all;
}

.fb-order-foot {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 14rpx;
	padding-top: 12rpx;
	border-top: 2rpx solid #e9f0fb;
}

.fb-order-meta {
	flex: 1;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	font-size: 22rpx;
	color: #8b9ab1;
}

.fb-order-ops {
	flex: none;
	display: flex;
	flex-direction: row;
	align-items: center;
}

.fb-order-op {
	margin-left: 24rpx;
	font-size: 24rpx;
	color: #397bc8;
}

.fb-order-op-muted {
	color: #94a3b8;
}

.fb-order-empty {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 22rpx 24rpx;
	border-radius: 16rpx;
	border: 2rpx dashed #c9dbf2;
	background: #f9fbff;
	box-sizing: border-box;
}

.fb-order-empty-hover {
	border-color: #397bc8;
	background: #f1f7ff;
}

.fb-order-empty-main {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
}

.fb-order-empty-title {
	font-size: 27rpx;
	font-weight: 600;
	line-height: 38rpx;
	color: #397bc8;
}

.fb-order-empty-sub {
	margin-top: 4rpx;
	font-size: 22rpx;
	line-height: 32rpx;
	color: #8b9ab1;
}

.fb-order-empty-arrow {
	flex: none;
	margin-left: 16rpx;
	font-size: 32rpx;
	color: #b3c4da;
}

.fb-order-tip {
	margin-top: 14rpx;
	font-size: 23rpx;
	line-height: 34rpx;
	color: #8b9ab1;
}

.fb-order-tip-error {
	color: #b87539;
}

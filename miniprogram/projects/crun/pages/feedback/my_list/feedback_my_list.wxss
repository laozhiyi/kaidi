@import "../../../style/skin.wxss";

/* ============================================================
   投诉记录列表页（左右贴边、宽度撑满屏幕）
   ============================================================ */

.page {
	min-height: 100vh;
	background-color: #f1f6ff;
	padding: 0 0 60rpx;
	box-sizing: border-box;
	width: 100%;
}

/* ============================================================
   顶部蓝色导航条
   ============================================================ */
.header {
	background: linear-gradient(135deg, #4a8fe0 0%, #397bc8 50%, #2f69b3 100%);
	width: 100%;
	padding: 36rpx 32rpx 40rpx;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	box-shadow: 0 6rpx 18rpx rgba(57, 123, 200, .25);
}

.header-content {
	flex: 1;
	min-width: 0;
}

.header-title {
	font-size: 44rpx;
	font-weight: bold;
	color: #fff;
	line-height: 60rpx;
}

.header-desc {
	font-size: 26rpx;
	color: rgba(255, 255, 255, .85);
	margin-top: 10rpx;
	line-height: 36rpx;
}

.header-btn {
	display: flex;
	flex-direction: row;
	align-items: center;
	background-color: rgba(255, 255, 255, .22);
	border: 2rpx solid rgba(255, 255, 255, .45);
	border-radius: 36rpx;
	padding: 12rpx 22rpx;
	flex-shrink: 0;
	margin-left: 16rpx;
}

.header-btn-plus {
	color: #fff;
	font-size: 32rpx;
	font-weight: bold;
	margin-right: 6rpx;
	line-height: 1;
}

.header-btn-text {
	color: #fff;
	font-size: 26rpx;
	line-height: 1;
}

/* ============================================================
   列表容器
   ============================================================ */
.list {
	padding: 24rpx 24rpx 0;
}

/* ============================================================
   投诉记录卡片
   ============================================================ */
.item {
	width: 100%;
	background-color: #fff;
	border-radius: 20rpx;
	padding: 28rpx 28rpx;
	margin-bottom: 24rpx;
	box-sizing: border-box;
	box-shadow: 0 4rpx 12rpx rgba(216, 220, 223, .25);
}

.item-head {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 18rpx;
}

.item-head .left {
	flex: 1;
	min-width: 0;
	display: flex;
	flex-direction: column;
}

.target-tag {
	display: inline-block;
	align-self: flex-start;
	font-size: 22rpx;
	color: #fff;
	background: linear-gradient(135deg, #4a8fe0, #397bc8);
	padding: 6rpx 18rpx;
	border-radius: 20rpx;
	margin-bottom: 14rpx;
	font-weight: 500;
	max-width: 100%;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.title {
	font-size: 30rpx;
	font-weight: 600;
	color: #1f2a44;
	line-height: 44rpx;
	word-break: break-all;
}

.status-pill {
	font-size: 24rpx;
	padding: 8rpx 22rpx;
	border-radius: 24rpx;
	font-weight: 500;
	flex-shrink: 0;
	margin-left: 16rpx;
	white-space: nowrap;
	line-height: 1;
}

.item-content {
	font-size: 26rpx;
	color: #4a5b7c;
	line-height: 40rpx;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	word-break: break-all;
}

.item-foot {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	margin-top: 20rpx;
	padding-top: 20rpx;
	border-top: 2rpx solid #f1f4fa;
	font-size: 24rpx;
}

.time {
	color: #94a3b8;
}

.reply {
	color: #2dc87a;
	background-color: rgba(45, 200, 122, .12);
	padding: 4rpx 16rpx;
	border-radius: 16rpx;
	font-weight: 500;
}

/* ============================================================
   空状态
   ============================================================ */
.empty {
	padding: 150rpx 24rpx;
	display: flex;
	flex-direction: column;
	align-items: center;
	background-color: #fff;
	border-radius: 20rpx;
	margin: 0 24rpx;
}

.empty-icon {
	font-size: 120rpx;
	margin-bottom: 20rpx;
	opacity: .5;
}

.empty-text {
	color: #94a3b8;
	font-size: 28rpx;
	margin-bottom: 40rpx;
}

.empty-btn {
	padding: 18rpx 60rpx;
	background: linear-gradient(135deg, #4a8fe0, #397bc8);
	color: #fff;
	font-size: 28rpx;
	border-radius: 40rpx;
	box-shadow: 0 6rpx 14rpx rgba(57, 123, 200, .3);
}

.page { padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.header-title { font-size: 38rpx; }
.header-btn { margin: 0 0 0 16rpx; line-height: 1.6; }
.header-btn::after, .list-more::after { border: 0; }
.item-head .left { flex: 1; min-width: 0; margin-right: 16rpx; }
.target-tag { white-space: normal; word-break: break-all; }
.status-pill { flex-shrink: 0; }
.item-content { word-break: break-word; }
.item-foot { flex-wrap: wrap; }
.list-state { text-align: center; padding: 28rpx 16rpx; font-size: 25rpx; color: #718098; }
.list-more { margin: 20rpx 0; background: #e8f0fb; color: #397bc8; border-radius: 14rpx; font-size: 27rpx; }
.empty-hint { color: #7a889b; font-size: 24rpx; margin-top: 16rpx; }
:host { display:block; width:100%; }
.endtime-trigger { display:flex; align-items:center; justify-content:space-between; min-height:88rpx; padding:12rpx 22rpx; box-sizing:border-box; color:#397bc8; background:#f1f6fe; border-radius:14rpx; font-size:28rpx; }
.endtime-arrow { margin-left:20rpx; font-size:40rpx; line-height:1; }
.endtime-disabled { opacity:.55; }
.endtime-mask { position:fixed; top:0; bottom:0; left:0; right:0; z-index:21000; display:flex; align-items:flex-end; background:rgba(25,42,66,.45); }
.endtime-sheet { width:100%; height:auto; max-height:92vh; display:flex; flex-direction:column; box-sizing:border-box; padding:24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius:30rpx 30rpx 0 0; background:#fff; color:#24344c; }
.endtime-sheet .endtime-button { box-sizing:border-box; margin:0; padding:0; border:0; line-height:1.5; font-size:26rpx; font-weight:400; }
.endtime-sheet .endtime-button::after { border:0; }
.endtime-head { display:flex; align-items:flex-start; justify-content:space-between; flex-shrink:0; margin-bottom:8rpx; }
.endtime-title { font-size:32rpx; font-weight:600; }
.endtime-note { margin-top:6rpx; color:#8190a5; font-size:24rpx; }
.endtime-sheet .endtime-close { width:76rpx; height:76rpx; flex-shrink:0; margin:-14rpx -10rpx 0 10rpx; color:#8190a5; font-size:44rpx; background:transparent; }
.endtime-body { flex:0 1 auto; height:450rpx; min-height:0; padding-bottom:6rpx; }
.endtime-label { display:flex; justify-content:space-between; margin:24rpx 0 16rpx; font-size:27rpx; font-weight:600; }
.endtime-label .endtime-text { font-size:24rpx; color:#397bc8; font-weight:400; }
.endtime-dates { width:100%; white-space:nowrap; }
.endtime-date-row { display:inline-flex; padding-bottom:8rpx; }
.endtime-sheet .endtime-date { width:122rpx; flex-shrink:0; min-height:112rpx; margin-right:12rpx; padding:16rpx 4rpx; border-radius:16rpx; background:#f4f7fb; color:#62748b; }
.endtime-date-text { margin-top:6rpx; font-size:22rpx; }
.endtime-sheet .endtime-button.selected { background:#397bc8; color:#fff; font-weight:600; }
.endtime-foot { flex-shrink:0; padding-top:16rpx; border-top:1rpx solid #edf1f6; background:#fff; }
.endtime-summary { margin-bottom:14rpx; font-size:25rpx; color:#516681; text-align:center; }
.endtime-error { margin-bottom:12rpx; padding:8rpx 16rpx; border-radius:12rpx; background:#fdf6ef; color:#b87539; font-size:23rpx; text-align:center; }
.endtime-sheet .endtime-confirm { width:100%; min-height:88rpx; display:flex; align-items:center; justify-content:center; border-radius:16rpx; color:#fff; background:#397bc8; font-size:29rpx; font-weight:600; }
.endtime-wheel { width:100%; height:240rpx; margin:8rpx 0 4rpx; border-radius:16rpx; background:#f8fafd; }
.endtime-wheel-item { display:flex; align-items:center; justify-content:center; height:56rpx; color:#42566f; font-size:30rpx; }
.endtime-wheel-indicator { height:56rpx; }
.endtime-wheel-indicator::after { border-top:1rpx solid #dbe6f3; border-bottom:1rpx solid #dbe6f3; }
.endtime-wheel-mask { background:linear-gradient(180deg,rgba(248,250,253,.95),rgba(248,250,253,.1) 30%,rgba(248,250,253,.1) 70%,rgba(248,250,253,.95)); }
.endtime-foot .endtime-manual { margin:0 0 12rpx; }
.endtime-manual { display:flex; align-items:center; gap:12rpx; margin:18rpx 0 8rpx; padding:8rpx 18rpx; border-radius:14rpx; background:#f4f7fb; }
.endtime-manual-label { flex-shrink:0; color:#60738f; font-size:24rpx; }
.endtime-manual-input { flex:1; min-width:0; height:56rpx; color:#2b405c; font-size:26rpx; text-align:right; }
.endtime-manual-placeholder { color:#a7b2c1; }
.endtime-manual-hint { flex-shrink:0; color:#9aa7ba; font-size:21rpx; }

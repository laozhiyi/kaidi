.as-card { margin:0 0 24rpx; padding:28rpx; border-radius:18rpx; background:#fff; box-sizing:border-box; box-shadow:0 8rpx 22rpx rgba(36,63,96,.04); }
.as-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12rpx; margin-bottom:24rpx; }
.as-title { color:#243b5b; font-size:30rpx; font-weight:600; }
.as-tag { color:#397bc8; font-size:22rpx; }
.as-muted { color:#8494a9; font-size:24rpx; line-height:1.6; }
.as-link { margin-left:12rpx; color:#397bc8; }
.as-qr { display:block; width:100%; margin:0 auto 24rpx; }
.as-save { margin:0 auto; padding:12rpx 24rpx; width:auto; max-width:280rpx; background:#edf3ff; color:#397bc8; border-radius:12rpx; font-size:26rpx; line-height:1.7; }
.as-save::after { border:0; }
.as-tip,.as-note { margin-top:20rpx; color:#52647c; font-size:26rpx; line-height:1.7; word-break:break-all; }
.as-footnote { margin-top:16rpx; }

.editor-tab {
	width: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	position: fixed;
	top: 0;
	z-index: 999;
	line-height: 3;
	height: 70rpx;
	margin-top: 40rpx;
}


.editor-tab .item.cur::after {
	width: 100%;
	position: absolute;
	bottom: 10rpx;
	left: 0rpx;
	height: 6rpx;
	content: '';
	background-color: #ff5858;
}

.iconfont {
	font-size: 32rpx;
	font-style: normal;
}

.editor-wrapper {
	padding: 30rpx;
	box-sizing: border-box;
}

.editor-add-wrapper {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin: 0 auto;
	font-size: 30rpx;
	width: 100%;
	justify-content: center;
}

.editor-add-wrapper .editor-add-wrapper-view {
	width: 250rpx;
	line-height: 2;
	text-align: center;
}

.editor-add-wrapper .iconfont {
	padding: 20rpx;
	color: #666;
	font-size: 48rpx;
	box-sizing: border-box;
}

.editor-node-wrapper {
	position: relative;
	width: 100%;
	margin-top: 10rpx;
	margin-bottom: 10rpx;
	border: 1rpx dashed #999;
	background: #fff;
}

.editor-node-wrapper.is-view {
	border: 1rpx solid #fff;
	border-radius: 10rpx;
}

.editor-node-wrapper.cur {
	animation: glow 800ms ease-out infinite alternate;
}

@keyframes glow {
	0% {
		box-shadow: 0 0 5px rgba(252, 94, 94, .2), inset 0 0 5px rgba(252, 94, 94, .1), 0 0px 0 #d70c19;
	}

	100% {
		border-color: #d70c19;
		box-shadow: 0 0 20px rgba(252, 94, 94, .6), inset 0 0 10px rgba(252, 94, 94, .4), 0 0px 0 #d70c19;
	}
}

.editor-delete {
	position: absolute;
	z-index: 999;
	display: flex;
	text-align: center;
	align-items: center;
	justify-content: center;
	top: -30rpx;
	right: 0rpx;
	color: #999;
	background: hsla(0, 0%, 100%, .95);
	border-radius: 40rpx;
	padding: 15rpx;
	box-shadow: 0 0 5px rgba(0, 0, 0, .1);
}

.editor-delete .iconfont {
	padding: 0 20rpx;
}

.editor-wrapper .editor-node-wrapper .editor-textarea {
	margin: 0;
	display: block;
	width: 100%;
	line-height: 1.5;
	padding: 35rpx 20rpx 20rpx;
	min-height: 240rpx;
	font-size: 32rpx;
}

.editor-images {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	width: 656rpx;
	border: 2rpx solid #e4e7ed;
	background: #fff;
	padding: 20rpx;
	min-height: 2.5em;
}

.editor-images .item-image {
	display: flex;
	align-items: center;
	justify-content: center;
	margin: 5rpx;
	width: 150rpx;
	height: 150rpx;
	box-sizing: border-box;
}

.editor-images .editor-images-add {
	border: 4rpx dashed #c0c4cc;
	color: #c0c4cc;
}

.editor-image {
	display: block;
	width: 100%;
}

.console-editor { width: 100%; min-width: 0; color: #21304a; }
.console-editor .editor-tab { position: static; height: auto; margin: 0 0 26rpx; padding: 6rpx; border-radius: 14rpx; background: #f0f4fb; gap: 6rpx; }
.console-editor .editor-tab button { flex: 1; min-width: 0; margin: 0; padding: 16rpx; height: auto; line-height: 1.4; font-size: 25rpx; border-radius: 10rpx; background: transparent; color: #718099; }
.console-editor .editor-tab button.bg-blue { background: #fff; color: #2863db; box-shadow: 0 2rpx 8rpx rgba(33,48,74,.05); }
.console-editor .editor-tab button::after { border: 0; }
.console-editor .editor-wrapper { padding: 0; }
.console-editor .editor-node-wrapper { border: 1rpx solid #e4eaf4; border-radius: 14rpx; overflow: hidden; margin: 0 0 16rpx; }
.console-editor .editor-node-wrapper.is-view { border-color: transparent; }
.console-editor .editor-wrapper .editor-node-wrapper .editor-textarea { padding: 24rpx 22rpx; min-height: 220rpx; border: 0; border-radius: 0; background: #f6f8fc; color: #21304a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 28rpx; line-height: 1.7; }
.console-editor .editor-wrapper .is-view .editor-textarea { background: #fff; }
.console-editor .editor-delete { position: static; justify-content: flex-end; background: #fff; border-radius: 0; box-shadow: none; border-top: 1rpx solid #edf0f5; padding: 14rpx 10rpx; color: #8995a8; }
.console-editor .editor-delete .iconfont { padding: 6rpx 20rpx; font-size: 29rpx; }
.console-editor .editor-add-wrapper { gap: 14rpx; margin-bottom: 28rpx; }
.console-editor .editor-add-wrapper .editor-add-wrapper-view { flex: 1; min-width: 0; width: auto; border: 1rpx dashed #cdd8ea; border-radius: 12rpx; padding: 18rpx 8rpx; background: #fafbfe; color: #637da4; font-size: 24rpx; line-height: 1.5; }

@import "../style/base/icon.wxss";

.custom-tab-bar {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 9999;
	display: flex;
	padding-bottom: constant(safe-area-inset-bottom);
	padding-bottom: env(safe-area-inset-bottom);
	background-color: #ffffff;
	box-shadow: 0 -2rpx 16rpx rgba(57, 123, 200, .12);
}

.tab-item {
	flex: 1;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	min-height: 100rpx;
	padding-top: 8rpx;
	box-sizing: border-box;
	color: #8fb5e8;
}

.tab-item.selected {
	color: #397bc8;
}

.tab-icon {
	font-size: 48rpx;
	line-height: 52rpx;
}

.tab-text {
	margin-top: 2rpx;
	font-size: 22rpx;
	line-height: 30rpx;
}

<view class="profile-section profile-personal">
  <view class="profile-section-head"><view><view class="profile-section-title">个人信息</view><view class="profile-section-subtitle">完善资料，发布任务时可以快速带入</view></view><view class="profile-section-tag">必填</view></view>
  <view class="profile-field-list">
    <view class="profile-field"><text class="profile-field-label">昵称</text><input class="profile-field-input" type="nickname" value="{{formName}}" maxlength="30" placeholder="填写昵称，可选择微信昵称" bindinput="bindProfileNameInput" bindblur="bindProfileNameInput" /></view>
    <view class="profile-field profile-phone-field"><text class="profile-field-label">手机号</text><view class="profile-phone-value">{{phoneVerified ? formMobile : '请授权微信手机号'}}</view><button class="profile-phone-authorize" open-type="getPhoneNumber" bindtap="bindWechatPhoneTap" bindgetphonenumber="bindWechatPhone" loading="{{phoneAuthorizing}}" disabled="{{phoneAuthorizing || saving || collectionSaving}}">{{phoneVerified ? '更换' : '授权'}}</button></view>
    <button class="profile-avatar-button" open-type="chooseAvatar" bind:chooseavatar="bindPicTap"><view><view class="profile-field-label">头像</view><view class="profile-field-note">点击更换头像</view></view><image wx:if="{{formPic}}" class="profile-avatar" mode="aspectFill" src="{{formPic}}" /><view wx:else class="profile-avatar-placeholder"><text class="icon-cameraadd"></text></view><text class="icon-right profile-arrow"></text></button>
    <view class="profile-choice-field"><view class="profile-field-label">性别</view><view class="profile-choice-group"><view wx:for="{{genderOptions}}" wx:key="*this" class="profile-choice {{profileSex === item ? 'profile-choice-selected' : ''}}" data-value="{{item}}" bindtap="bindGenderTap"><text class="profile-choice-dot"></text>{{item}}</view></view></view>
    <view class="profile-field"><text class="profile-field-label">学院</text><input class="profile-field-input" value="{{profileCollege}}" maxlength="80" placeholder="请输入所在学院" bindinput="bindProfileFieldInput" data-field="profileCollege" /></view>
    <view class="profile-field"><text class="profile-field-label">专业</text><input class="profile-field-input" value="{{profileSub}}" maxlength="80" placeholder="请输入所学专业" bindinput="bindProfileFieldInput" data-field="profileSub" /></view>
    <view class="profile-campus-control {{campus ? 'profile-campus-selected' : ''}}" bindtap="bindOpenCampusPicker" hover-class="profile-campus-pressed" role="button" aria-label="选择所在校区"><view><view class="profile-field-label">所在校区</view><view class="profile-campus-value">{{campus || '请选择所在校区'}}</view></view><view class="profile-campus-action">{{campus ? '更换' : '选择'}}<text class="icon-right"></text></view></view>
  </view>
  <view wx:if="{{!campus}}" class="profile-required-hint">请选择所在校区后再保存</view>
</view>
<view wx:if="{{campusPickerVisible}}" class="profile-campus-overlay">
  <view class="profile-campus-mask" catchtap="bindCloseCampusPicker" catchtouchmove="bindProfileSheetTouchMove"></view>
  <view class="profile-campus-sheet">
    <view class="profile-campus-sheet-head"><view><view class="profile-campus-sheet-title">选择所在校区</view><view class="profile-campus-sheet-desc">选择你常用的校区，发布任务时自动带入</view></view><button class="profile-campus-close" bindtap="bindCloseCampusPicker" aria-label="关闭校区选择"><text class="icon-close"></text></button></view>
    <scroll-view class="profile-campus-options" scroll-y style="height:{{campuses.length > 4 ? 512 : campuses.length * 128}}rpx;">
      <view wx:for="{{campuses}}" wx:key="*this" class="profile-campus-option {{campusDraft === item ? 'profile-campus-option-selected' : ''}}" data-value="{{item}}" bindtap="bindSelectCampus" hover-class="profile-campus-pressed" role="button" aria-label="{{item}}">
        <view class="profile-campus-option-icon"><text class="icon-location"></text></view><view class="profile-campus-option-name">{{item}}</view><text wx:if="{{campus === item}}" class="profile-campus-current">当前</text><view class="profile-campus-radio"><text wx:if="{{campusDraft === item}}" class="icon-check"></text></view>
      </view>
    </scroll-view>
    <view class="profile-campus-sheet-actions"><button class="profile-campus-cancel" bindtap="bindCloseCampusPicker">取消</button><button class="profile-campus-confirm" bindtap="bindConfirmCampus" disabled="{{!campusDraft}}">确认选择</button></view>
  </view>
</view>

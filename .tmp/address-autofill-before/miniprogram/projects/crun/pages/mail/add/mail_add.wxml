<import src="./business_order_fields.wxml" />
<view class="publish-page {{embedded ? 'publish-embedded' : ''}}">
 <view wx:if="{{hasPendingSubmission}}" class="pub-card pub-recovery">
  <view class="pub-recovery-title">上次提交结果待确认</view>
  <view class="pub-caption">核对后保留已保存的订单，停止未保存的提交，再继续填写。</view>
  <button class="pub-button" bindtap="bindRecoverSubmission" loading="{{submitting}}" disabled="{{submitting}}">核对上次提交</button>
 </view>
 <view wx:if="{{!isLoad}}" class="pub-state">
  <view class="pub-state-icon"><text class="icon-{{configError ? 'info' : 'time'}}"></text></view>
  <view class="pub-state-title">{{configError ? '暂时无法加载' : '正在准备发单信息'}}</view>
  <view class="pub-state-note">{{configError ? loadError : '获取校区和包裹价格，请稍候'}}</view>
  <button wx:if="{{configError}}" class="pub-button" bindtap="bindRetryLoad" loading="{{pageLoading}}" disabled="{{pageLoading}}">重新加载</button>
 </view>
 <block wx:if="{{isLoad}}">
  <view class="pub-hero">
   <view class="pub-hero-copy"><view class="pub-eyebrow">校园生活 · 少跑一趟</view><view class="pub-hero-title">{{editId ? '修改' + serviceName + '订单' : serviceType === 'buy' ? '想买的，帮你带回来' : serviceType === 'send' ? '物品，帮你送过去' : '快递，帮你带回来'}}</view><view class="pub-hero-note">{{serviceType === 'buy' ? '写清商品与预算，购买后送到你手中' : serviceType === 'send' ? '填好取件点和送达地址，剩下交给骑手' : '选好包裹，填好地址，剩下交给骑手'}}</view></view>
   <view class="pub-hero-symbol"><text class="icon-deliver"></text></view>
  </view>
  <view class="pub-content">
   <view class="pub-card pub-service">
    <view class="pub-campus-row"><view class="pub-campus-copy"><view class="pub-caption">当前服务校区</view><view class="pub-campus-name">{{config.schoolName}} · {{campus}}</view></view></view>
    <view class="pub-service-row pub-service-{{serviceState.kind}}"><view class="pub-status-label"><view class="pub-status-dot"></view><text>{{serviceState.title}}</text></view><text wx:if="{{serviceState.hours}}" class="pub-hours">{{serviceState.hours}}</text></view>
    <view wx:if="{{!serviceState.canPublish}}" class="pub-service-detail"><view>{{serviceState.description}}</view><view class="pub-service-actions"><text bindtap="bindServiceHelpTap">联系校区客服 <text class="icon-right"></text></text><text bindtap="bindRetryLoad">刷新状态</text></view></view>
   </view>
   <view wx:if="{{configError}}" class="pub-inline-error"><text>{{loadError}}，已保留所填内容。</text><text bindtap="bindRetryLoad">重试</text></view>

   <view class="pub-card pub-options pub-deadline-card">
    <view class="pub-deadline"><view class="pub-option-label"><text class="icon-time"></text><text>客户期望接单截止时间</text></view><deadline-picker value="{{formEnd}}" disabled="{{submitting}}" bind:select="bindEndSelect" /></view>
    <view wx:if="{{formEndFocus}}" class="pub-validation">{{formEndFocus}}</view>
   </view>

   <template is="{{serviceForm}}" data="{{packageItems,packageTypes,serviceType,totalFee,totalCount,config,submitting,mailValues}}" />

   <view class="pub-card pub-route-card">
    <view class="pub-heading"><view><text class="pub-section-no">02</text><text>送到哪里</text></view></view>
    <view class="pub-route-row">
     <view class="pub-route-head">
      <view class="pub-route-label"><view class="pub-route-marker pub-marker-send">送</view><text class="pub-field-label">送达地址 <text class="pub-required">*</text></text></view>
      <button class="pub-quick-select" hover-class="pub-quick-select-hover" bindtap="bindChooseProfileAddress" aria-label="选择常用地址">常用地址<text class="icon-right"></text></button>
     </view>
     <view class="pub-input-box"><textarea class="pub-address-input" value="{{mailValues.address2}}" maxlength="200" auto-height placeholder="例如：二期3号宿舍楼201室" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="address2" /></view>
    </view>
   </view>
    <view class="pub-card pub-contact-card">
     <view class="pub-heading">
      <view><text class="pub-section-no">03</text><text>联系人信息</text></view>
      <button class="pub-quick-select" hover-class="pub-quick-select-hover" bindtap="bindChooseProfileContact" aria-label="选择常用联系人">常用联系人<text class="icon-right"></text></button>
     </view>
     <view class="pub-field-row">
      <view class="pub-field-label">联系人 <text class="pub-required">*</text></view>
      <view class="pub-input-box"><textarea class="pub-contact-input" value="{{mailValues.poster}}" maxlength="30" auto-height placeholder="方便骑手称呼你" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="poster" /></view>
     </view>
     <view class="pub-field-row">
      <view class="pub-field-label">手机号 <text class="pub-required">*</text></view>
      <view class="pub-input-box"><input type="number" maxlength="11" value="{{mailValues.tel}}" placeholder="请输入可联系的手机号" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="tel" /></view>
     </view>
     <view class="pub-field-row">
      <view class="pub-field-label">第二联系方式 <text class="pub-field-optional">选填</text></view>
      <view class="pub-input-box"><input value="{{mailValues.tel2}}" maxlength="50" placeholder="微信号或备用电话" placeholder-class="pub-placeholder" bindinput="bindMailInput" data-mark="tel2" /></view>
     </view>
    </view>
<view wx:if="{{config.urgentEnabled}}" class="pub-card pub-options">
    <view class="pub-option-row"><view><view class="pub-option-label">加急 <text class="pub-urgent-tag">可选</text></view><view class="pub-caption">优先处理，预计 {{config.urgentMinutes}} 分钟内完成</view></view><switch checked="{{urgent}}" color="#397bc8" bindchange="bindUrgentChange"/></view>
   </view>
   <view class="pub-settlement" bindtap="bindSettlementTap"><text class="icon-info"></text><view><text>费用线下结算，请勿提前转账</text><view>平台不代收、不担保 · 查看结算说明</view></view><text class="icon-right"></text></view>
  </view>

  <view class="pub-submit-bar"><view class="pub-total"><view class="pub-total-label">{{serviceType === 'buy' ? '跑腿费 · 不含商品款' : '共 ' + totalCount + ' 件 · 线下费用'}}</view><view class="pub-total-price"><text>¥</text>{{totalFee}}</view></view><button class="pub-submit" hover-class="pub-submit-hover" bindtap="bindFormSubmit" loading="{{submitting}}" disabled="{{submitting || pageLoading || configError || (!serviceState.canPublish && !editId)}}">{{editId ? '保存修改' : serviceState.kind==='paused' ? '暂时停止接单' : serviceState.kind==='closed' ? '营业后可发布' : serviceType === 'buy' ? '发布代买订单' : serviceType === 'send' ? '发布代送订单' : '发布代取订单'}}<text wx:if="{{!submitting && serviceState.canPublish}}" class="icon-right"></text></button></view>
  <view class="pub-form-engine"><cmpt-form-show id="cmpt-form" mark="mail-add-engine" isCacheMatch="{{false}}" fields="{{fields}}" forms="{{formForms}}" isDefMatch="{{true}}"/></view>
 </block>
 <include src="./mail_profile_picker.wxml" />
 <include src="./mail_package_pickup.wxml" />
</view>

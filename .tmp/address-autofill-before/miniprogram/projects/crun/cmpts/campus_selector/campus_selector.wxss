.campus-selector{margin:16rpx 24rpx;padding:18rpx 22rpx;border-radius:18rpx;background:#fff;border:1rpx solid #dce5f1;color:#24364d;font-size:25rpx;display:flex;gap:24rpx;align-items:center;flex-wrap:wrap}.campus-selector picker{flex:1;min-width:220rpx}.campus-choice{display:flex;gap:12rpx;align-items:center}.campus-choice>text:nth-child(2){flex:1}.campus-label{font-size:22rpx;color:#718198}.campus-error{color:#b34a36}.campus-loading{color:#718198}

<view class="campus-selector">
  <view wx:if="{{loading}}" class="campus-loading">正在读取学校目录…</view>
  <view wx:if="{{!loading && error}}" bindtap="load" class="campus-error">{{error}} · 点击重试</view>
  <block wx:if="{{!loading && schools.length}}">
    <picker range="{{schools}}" range-key="name" value="{{schoolIndex}}" bindchange="schoolChange" disabled="{{disabled}}"><view class="campus-choice"><text class="campus-label">学校</text><text>{{schools[schoolIndex].name}}</text><text>⌄</text></view></picker>
    <picker range="{{campuses}}" range-key="name" value="{{campusIndex < 0 ? 0 : campusIndex}}" bindchange="campusChange" disabled="{{disabled}}"><view class="campus-choice"><text class="campus-label">校区</text><text>{{campusIndex < 0 ? '请选择校区' : campuses[campusIndex].name}}</text><text>⌄</text></view></picker>
  </block>
</view>

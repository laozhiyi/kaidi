{
  "schemaVersion": 1,
  "status": "candidate_not_applied",
  "description": "人工建索引的候选清单，不是微信控制台或 CLI 的导入格式。fields 仅列后缀；必须先加上 prefixes[scope]。执行计划、配额及范围查询须在测试环境验证。",
  "unique": false,
  "prefixes": {
    "campus": [["_pid", "asc"], ["schoolId", "asc"], ["campusId", "asc"]],
    "school": [["_pid", "asc"], ["schoolId", "asc"]],
    "system": [["_pid", "asc"]]
  },
  "indexes": [
    {"collection":"bx_school","name":"school_directory","scope":"system","fields":[["_id","asc"]],"purpose":"公开与后台学校元数据目录"},
    {"collection":"bx_campus","name":"campus_directory","scope":"system","fields":[["_id","asc"]],"purpose":"公开与后台校区元数据目录"},
    {"collection":"bx_admin","name":"admin_directory","scope":"system","fields":[["_id","asc"]],"purpose":"平台管理员目录摘要"},
    {"collection":"bx_admin","name":"admin_login","scope":"system","fields":[["ADMIN_STATUS","asc"],["ADMIN_NAME","asc"]],"purpose":"全局管理员登录，授权范围另行校验"},
    {"collection":"bx_admin","name":"admin_token","scope":"system","fields":[["ADMIN_TOKEN","asc"],["ADMIN_TOKEN_USER","asc"],["ADMIN_STATUS","asc"]],"purpose":"校验管理员令牌与微信身份"},
    {"collection":"bx_user","name":"school_user","scope":"school","fields":[["USER_MINI_OPENID","asc"]],"purpose":"学校共享账号读取及关联查询"},
    {"collection":"bx_user","name":"school_users_recent","scope":"school","fields":[["USER_ADD_TIME","desc"],["_id","desc"]],"purpose":"学校管理员用户列表与导出"},
    {"collection":"bx_user","name":"school_users_status","scope":"school","fields":[["USER_STATUS","asc"],["USER_ADD_TIME","desc"],["_id","desc"]],"purpose":"账号审核状态筛选"},
    {"collection":"bx_mail","name":"campus_wait_recent","scope":"campus","fields":[["MAIL_STATUS","asc"],["MAIL_PAYMENT_MODE","asc"],["MAIL_ADD_TIME","desc"],["_id","desc"],["MAIL_END_TIME","asc"]],"purpose":"可接单与首页最新订单；截止时间为范围条件，须验证扫描量"},
    {"collection":"bx_mail","name":"campus_wait_price_desc","scope":"campus","fields":[["MAIL_STATUS","asc"],["MAIL_PAYMENT_MODE","asc"],["MAIL_OBJ.price","desc"],["_id","desc"],["MAIL_END_TIME","asc"]],"purpose":"高价优先"},
    {"collection":"bx_mail","name":"campus_wait_price_asc","scope":"campus","fields":[["MAIL_STATUS","asc"],["MAIL_PAYMENT_MODE","asc"],["MAIL_OBJ.price","asc"],["_id","desc"],["MAIL_END_TIME","asc"]],"purpose":"低价优先；_id 的排序仍为降序"},
    {"collection":"bx_mail","name":"campus_my_posts","scope":"campus","fields":[["MAIL_USER_ID","asc"],["MAIL_ADD_TIME","desc"],["_id","desc"]],"purpose":"我的发布；归档/完成时间条件须验证执行计划"},
    {"collection":"bx_mail","name":"campus_my_accepts","scope":"campus","fields":[["MAIL_ACCEPT_USER_ID","asc"],["MAIL_ADD_TIME","desc"],["_id","desc"]],"purpose":"我的接单"},
    {"collection":"bx_mail","name":"campus_poster_quota","scope":"campus","fields":[["MAIL_USER_ID","asc"],["MAIL_STATUS","asc"]],"purpose":"历史发布配额初始化"},
    {"collection":"bx_mail","name":"campus_rider_quota","scope":"campus","fields":[["MAIL_ACCEPT_USER_ID","asc"],["MAIL_STATUS","asc"]],"purpose":"历史接单配额初始化"},
    {"collection":"bx_mail","name":"campus_admin_recent","scope":"campus","fields":[["MAIL_ADD_TIME","desc"],["_id","desc"]],"purpose":"后台订单列表、日期范围导出"},
    {"collection":"bx_mail","name":"campus_admin_status","scope":"campus","fields":[["MAIL_STATUS","asc"],["MAIL_ADD_TIME","desc"],["_id","desc"]],"purpose":"后台状态筛选"},
    {"collection":"bx_mail","name":"campus_legacy_order","scope":"campus","fields":[["MAIL_ORDER","asc"],["MAIL_ADD_TIME","desc"]],"purpose":"旧后台入口的置顶排序","optional":true},
    {"collection":"bx_order_feed","name":"campus_feed","scope":"campus","fields":[["shard","asc"]],"purpose":"云函数读取本校区最多64条刷新信号"},
    {"collection":"bx_fav","name":"campus_fav_counts","scope":"campus","fields":[["FAV_OID","asc"],["FAV_TYPE","asc"]],"purpose":"批量聚合订单收藏数"},
    {"collection":"bx_fav","name":"campus_fav_identity","scope":"campus","fields":[["FAV_USER_ID","asc"],["FAV_OID","asc"],["FAV_TYPE","asc"]],"purpose":"本人收藏状态"},
    {"collection":"bx_fav","name":"campus_my_favorites","scope":"campus","fields":[["FAV_USER_ID","asc"],["FAV_ADD_TIME","desc"],["_id","desc"]],"purpose":"我的收藏列表"},
    {"collection":"bx_news","name":"campus_news_featured","scope":"campus","fields":[["NEWS_STATUS","asc"],["NEWS_ORDER","asc"],["NEWS_ADD_TIME","desc"],["_id","desc"]],"purpose":"首页公告与公告列表"},
    {"collection":"bx_news","name":"campus_news_manifest","scope":"campus","fields":[["NEWS_STATUS","asc"],["_id","asc"]],"purpose":"初始化/迁移后重建公告摘要"},
    {"collection":"bx_news_read","name":"campus_news_reads","scope":"campus","fields":[["userId","asc"],["newsId","asc"],["_id","asc"]],"purpose":"公告版本变化后重建用户已读索引"},
    {"collection":"bx_notification","name":"campus_messages","scope":"campus","fields":[["userId","asc"],["createdAt","desc"],["_id","desc"]],"purpose":"个人通知游标分页"},
    {"collection":"bx_notification","name":"campus_messages_unread","scope":"campus","fields":[["userId","asc"],["read","asc"],["createdAt","desc"],["_id","desc"]],"purpose":"未读计数与列表；read != true 需验证"},
    {"collection":"bx_notification","name":"campus_mark_all","scope":"campus","fields":[["userId","asc"],["read","asc"],["_id","asc"]],"purpose":"批量已读前捕获消息ID","optional":true},
    {"collection":"bx_campus_service","name":"campus_services","scope":"campus","fields":[["CS_STATUS","asc"],["CS_ORDER","asc"],["CS_ADD_TIME","desc"]],"purpose":"校区客服列表"},
    {"collection":"bx_campus_service_message","name":"campus_user_chat","scope":"campus","fields":[["CSM_SERVICE_ID","asc"],["CSM_USER_ID","asc"],["CSM_ADD_TIME","desc"],["CSM_ID","desc"]],"purpose":"用户客服会话翻页"},
    {"collection":"bx_campus_service_message","name":"campus_admin_chat","scope":"campus","fields":[["CSM_SESSION_ID","asc"],["CSM_ADD_TIME","desc"],["CSM_ID","desc"]],"purpose":"管理员客服会话翻页"},
    {"collection":"bx_campus_service_message","name":"campus_chat_summary","scope":"campus","fields":[["CSM_ADD_TIME","desc"]],"purpose":"后台会话分组前排序，需评估聚合扫描量","optional":true},
    {"collection":"bx_feedback","name":"campus_my_feedback","scope":"campus","fields":[["FB_USER_ID","asc"],["FB_ADD_TIME","desc"],["_id","desc"]],"purpose":"我的申诉"},
    {"collection":"bx_feedback","name":"campus_admin_feedback","scope":"campus","fields":[["FB_ADD_TIME","desc"],["_id","desc"]],"purpose":"后台申诉"},
    {"collection":"bx_feedback","name":"campus_feedback_status","scope":"campus","fields":[["FB_STATUS","asc"],["FB_ADD_TIME","desc"],["_id","desc"]],"purpose":"后台按处理状态筛选"},
    {"collection":"bx_order_review","name":"campus_review_order","scope":"campus","fields":[["REVIEW_FROM_USER_ID","asc"],["REVIEW_ORDER_ID","asc"]],"purpose":"订单是否已评价"},
    {"collection":"bx_order_review","name":"campus_reviews_sent","scope":"campus","fields":[["REVIEW_FROM_USER_ID","asc"],["REVIEW_ADD_TIME","desc"],["_id","desc"]],"purpose":"我发出的评价"},
    {"collection":"bx_order_review","name":"campus_reviews_received","scope":"campus","fields":[["REVIEW_TO_USER_ID","asc"],["REVIEW_ADD_TIME","desc"],["_id","desc"]],"purpose":"收到的评价及信誉分聚合"},
    {"collection":"bx_invite","name":"campus_invite_owner","scope":"campus","fields":[["INV_USER_ID","asc"],["INV_ADD_TIME","asc"]],"purpose":"本校区邀请记录"},
    {"collection":"bx_invite","name":"campus_invite_code","scope":"campus","fields":[["INV_CODE","asc"]],"purpose":"校区邀请码读取"},
    {"collection":"bx_invite","name":"campus_invite_accept","scope":"campus","fields":[["INV_ACCEPT_USER_ID","asc"]],"purpose":"受邀人记录"},
    {"collection":"bx_mail","name":"worker_expiry","scope":"system","fields":[["MAIL_STATUS","asc"],["MAIL_PAYMENT_MODE","asc"],["MAIL_END_TIME","asc"],["_id","asc"]],"purpose":"独立订单任务全校扫描；tenantRetired != true、MAIL_ADMIN_DELETED != true 为额外过滤，须核验实际扫描/返回比"},
    {"collection":"bx_mail","name":"worker_overdue","scope":"system","fields":[["MAIL_STATUS","asc"],["MAIL_DUE_TIME","asc"],["_id","asc"]],"purpose":"独立履约提醒；due > 0、overdue flag、状态 in 和 MAIL_ADMIN_DELETED != true 须核验实际扫描/返回比"},
    {"collection":"bx_notification","name":"worker_notifications","scope":"system","fields":[["delivery","asc"],["nextAttemptAt","asc"],["_id","asc"]],"purpose":"独立通知派发及发送租约超时恢复"},
    {"collection":"bx_operation_limit","name":"worker_rate_cleanup","scope":"system","fields":[["expiresAt","asc"]],"purpose":"仅定时任务跨校区清理过期限流桶"},
    {"collection":"bx_admin_limit","name":"admin_rate_cleanup","scope":"system","fields":[["expiresAt","asc"]],"purpose":"清理全局管理员登录限流桶"},
    {"collection":"bx_tenant_migration","name":"migration_journal","scope":"system","fields":[["planHash","asc"],["status","asc"],["kind","asc"],["_id","asc"]],"purpose":"临时迁移函数回滚及审计；普通请求不可访问"}
  ],
  "workerShardAlternatives": {
    "description": "仅启用 WORKER_SHARD 时使用；在相应 system 索引的 _pid 后插入 workerShard asc。全部16个分片须覆盖；勿与全量扫描器同时部署。",
    "baseIndexes": ["worker_expiry", "worker_overdue", "worker_notifications"]
  },
  "migrationScan": {
    "description": "维护窗口的 system 迁移/核验扫描使用 _pid asc, _id asc；如执行计划需要，按实际迁移集合临时建立。保留历史业务索引，回滚验收前不删除。",
    "fields": [["_pid", "asc"], ["_id", "asc"]]
  },
  "pointReads": ["bx_identity_unique", "bx_order_quota", "bx_order_request", "bx_order_event", "bx_request_scope", "bx_feedback_request", "bx_review_request", "bx_subscription", "bx_operation_config", "bx_news_manifest", "bx_news_unread", "bx_worker_state"],
  "notes": [
    "pointReads 以 _id 直接读取，不需要为每个字段另建索引；同校区归属仍由服务端校验。",
    "租户隔离来自请求范围、授权及数据库包装器，索引只影响效率，不能替代权限规则。",
    "全部集合客户端 read=false/write=false；system 索引仅用于受控目录、认证、迁移和任务。",
    "普通索引不能优化所有正则包含搜索、OR、不等于条件和深分页。按执行计划及实际数据分布增补或调整，避免无证据堆叠索引。"
  ]
}
